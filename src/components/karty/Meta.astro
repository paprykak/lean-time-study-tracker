---
// Metadane artykułu: data, autor, czas czytania. Jedna linia, tekst drugorzędny.
import { czasCzytaniaTekst, dataDluga, datetime } from '../../lib/daty';
interface Props {
  data: Date;
  autor?: string;
  czasCzytania?: number;
  naCiemnym?: boolean;
  class?: string;
}
const { data, autor, czasCzytania, naCiemnym = false, class: klasa } = Astro.props;
---
<p class:list={['meta flex flex-wrap items-center gap-x-2', { 'text-tekst-na-ciemnym-drugi': naCiemnym }, klasa]}>
  <time datetime={datetime(data)}>{dataDluga(data)}</time>
  {autor && <><span aria-hidden="true">·</span><span>{autor}</span></>}
  {czasCzytania && <><span aria-hidden="true">·</span><span>{czasCzytaniaTekst(czasCzytania)}</span></>}
</p>
