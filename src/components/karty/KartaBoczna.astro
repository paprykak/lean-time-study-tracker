---
// Karta boczna: miniatura po lewej, tytuł po prawej. Kolumna obok karty głównej i listy „Więcej”.
import Zdjecie from '../Zdjecie.astro';
import Etykieta from './Etykieta.astro';
import Tekst from '../Tekst.astro';
import type { ArtykulKarta } from '../../lib/typy';
import { czasCzytaniaTekst, dataDluga, datetime } from '../../lib/daty';

interface Props {
  artykul: ArtykulKarta;
  poziom?: 'h2' | 'h3';
  class?: string;
}
const { artykul, poziom = 'h3', class: klasa } = Astro.props;
const Tytul = poziom;
---
<article class:list={['karta grid grid-cols-[7rem_1fr] gap-3 sm:grid-cols-[8.5rem_1fr]', klasa]}>
  <Zdjecie zdjecie={artykul.zdjecie} proporcja="16-10" szerokosc={136} sizes="136px" />
  <div>
    <Etykieta artykul={artykul} />
    <Tytul class="tytul-s mt-1">
      <a href={artykul.adres} class="karta-link karta-tytul"><Tekst t={artykul.tytul} /></a>
    </Tytul>
    <p class="meta mt-1">{artykul.czasCzytania ? czasCzytaniaTekst(artykul.czasCzytania) : <time datetime={datetime(artykul.data)}>{dataDluga(artykul.data)}</time>}</p>
  </div>
</article>
