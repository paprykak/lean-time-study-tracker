---
// Pozycja listy artykułów bez zdjęcia (sekcje działów, kolumny): dział i format, tytuł, autor i czas czytania.
// Bez godzin publikacji: Rytm Hali publikuje artykuły, nie wiadomości.
import Etykieta from './Etykieta.astro';
import Tekst from '../Tekst.astro';
import type { ArtykulKarta } from '../../lib/typy';
import { czasCzytaniaTekst } from '../../lib/daty';

interface Props {
  artykul: ArtykulKarta;
  poziom?: 'h2' | 'h3';
  /** Bez nazwy działu (lista w sekcji działu). */
  bezDzialu?: boolean;
  class?: string;
}
const { artykul, poziom = 'h3', bezDzialu = false, class: klasa } = Astro.props;
const Tytul = poziom;
const meta = [artykul.autor, artykul.czasCzytania ? czasCzytaniaTekst(artykul.czasCzytania) : undefined].filter(Boolean).join(' · ');
---
<article class:list={['karta border-t border-linia py-3', klasa]}>
  <Etykieta artykul={artykul} bezDzialu={bezDzialu} />
  <Tytul class="tytul-s mt-1 text-[1rem] leading-snug">
    <a href={artykul.adres} class="karta-link karta-tytul"><Tekst t={artykul.tytul} /></a>
  </Tytul>
  {meta && <p class="meta mt-1">{meta}</p>}
</article>
