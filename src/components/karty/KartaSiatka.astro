---
// Karta w siatce: zdjęcie 16:9 na górze, kategoria, tytuł, opcjonalnie lead, metadane.
import Zdjecie from '../Zdjecie.astro';
import Etykieta from './Etykieta.astro';
import Meta from './Meta.astro';
import type { ArtykulKarta } from '../../lib/typy';

interface Props {
  artykul: ArtykulKarta;
  zLeadem?: boolean;
  poziom?: 'h2' | 'h3';
  /** Szerokość kolumny siatki na komputerze (do sizes): 3 kolumny ≈ 400 px, 4 kolumny ≈ 290 px. */
  szerokosc?: number;
  class?: string;
}
const { artykul, zLeadem = false, poziom = 'h3', szerokosc = 400, class: klasa } = Astro.props;
const Tytul = poziom;
---
<article class:list={['karta flex flex-col', klasa]}>
  <Zdjecie zdjecie={artykul.zdjecie} proporcja="16-9" szerokosc={szerokosc} sizes={`(min-width: 1024px) ${szerokosc}px, (min-width: 640px) 50vw, 100vw`} />
  <div class="mt-3">
    <Etykieta artykul={artykul} />
    <Tytul class="tytul-m mt-1">
      <a href={artykul.adres} class="karta-link karta-tytul">{artykul.tytul}</a>
    </Tytul>
    {zLeadem && artykul.lead && <p class="mt-2 text-[0.9375rem] leading-relaxed">{artykul.lead}</p>}
    <Meta data={artykul.data} bezDaty autor={artykul.autor} czasCzytania={artykul.czasCzytania} class="mt-2" />
  </div>
</article>
