---
// Treść strony błędu: 404 (nie ma takiej strony) i 410 (strona usunięta na stałe). Szablon dla /404 i workera (410,
// lista usuniętych adresów w worker/usuniete.js). Zamiast działów: kategorie narzędzi z rejestru.
import Ikona from './Ikona.astro';
import { KATEGORIE, NARZEDZIA, type KategoriaNarzedzia } from '../data/narzedzia';
import { PORTAL } from '../lib/srodowisko.mjs';
interface Props {
  kod: 404 | 410;
  /** Poziom tytułu: h1 na stronie błędu, niżej przy podglądzie na /styleguide. */
  poziom?: 'h1' | 'h2' | 'h3';
}
const { kod, poziom = 'h1' } = Astro.props;
const Tytul = poziom;
const Podtytul = poziom === 'h1' ? 'h2' : poziom === 'h2' ? 'h3' : 'h4';
const prefiks = poziom === 'h1' ? 'szukaj-blad' : `szukaj-blad-${kod}`;
// Przed startem portalu (produkcja z samą stroną „Wkrótce”) bez wyszukiwarki i narzędzi: tych stron jeszcze nie ma.
const kategorie = (Object.keys(KATEGORIE) as KategoriaNarzedzia[]).filter((k) => NARZEDZIA.some((n) => n.kategoria === k));
const tresc = {
  404: { tytul: 'Nie ma takiej strony', opis: PORTAL ? 'Adres mógł się zmienić albo zawiera literówkę. Wpisz, czego szukasz, albo wybierz kategorię narzędzi.' : 'Adres mógł się zmienić albo zawiera literówkę. Rytm Hali startuje wkrótce.' },
  410: { tytul: 'Tej strony już nie ma', opis: PORTAL ? 'Redakcja usunęła ją na stałe: Rytm Hali to teraz narzędzia i przepisy dla ludzi z hali. Wpisz, czego szukasz, albo wybierz kategorię narzędzi.' : 'Redakcja usunęła tę stronę na stałe.' },
}[kod];
---
<section class="kontener py-12 md:py-20">
  <div class="max-w-2xl">
    <p class="font-display text-[4.5rem] leading-none font-bold text-akcent tabular-nums md:text-[6rem]" aria-hidden="true">{kod}</p>
    <Tytul class="tytul-xl mt-4">{tresc.tytul}</Tytul>
    <p class="lead mt-4">{tresc.opis}</p>
    {PORTAL && <>
    <form action="/szukaj" method="get" role="search" class="mt-8 flex max-w-md items-stretch">
      <label for={prefiks} class="sr-only">Szukaj w Rytmie Hali</label>
      <input id={prefiks} name="q" type="search" class="pole rounded-r-none border-r-0" placeholder="np. nadgodziny, L4, urlop" />
      <button type="submit" class="przycisk przycisk-grafit rounded-l-none"><Ikona nazwa="szukaj" />Szukaj</button>
    </form>
    <Podtytul class="mt-10 font-sans text-kategoria font-bold tracking-[0.08em] text-tekst-drugi uppercase">Kategorie narzędzi</Podtytul>
    <ul class="mt-2 flex flex-wrap gap-2">
      {kategorie.map((k) => (
        <li><a href={`/narzedzia#${k}`} class="przycisk przycisk-obrys">{KATEGORIE[k].nazwa}</a></li>
      ))}
    </ul>
    </>}
    <p class="mt-8"><a href="/" class="link inline-flex min-h-11 items-center gap-1.5">Strona główna<Ikona nazwa="strzalka" rozmiar={18} /></a></p>
  </div>
</section>
