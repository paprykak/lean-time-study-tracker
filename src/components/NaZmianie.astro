---
// Pasek „Na zmianie”: najnowsze krótkie wiadomości z godziną, pod nagłówkiem. Bez animacji przewijania
// (rozprasza i utrudnia czytanie, WCAG 2.2.2); na telefonie przewija się w bok kciukiem.
import { datetime, godzinaAlboData } from '../lib/daty';
interface Props {
  pozycje: { tytul: string; adres: string; data: Date }[];
}
const { pozycje } = Astro.props;
---
{pozycje.length > 0 && (
  <section class="na-zmianie border-b border-linia bg-tlo-szare" aria-labelledby="na-zmianie-tytul">
    <div class="kontener flex items-stretch gap-4">
      <p id="na-zmianie-tytul" class="flex shrink-0 items-center gap-2 text-kategoria font-bold tracking-[0.08em] text-akcent-tekst uppercase">
        <span class="block size-2 bg-akcent" aria-hidden="true"></span>Na zmianie
      </p>
      <ul class="na-zmianie-lista">
        {pozycje.slice(0, 4).map((p) => (
          <li class="flex items-center gap-2">
            <time datetime={datetime(p.data)} data-czas-wzgledny class="shrink-0 text-meta font-bold whitespace-nowrap text-tekst tabular-nums">{godzinaAlboData(p.data)}</time>
            <a href={p.adres} class="text-[0.875rem] font-medium text-tekst najazd:underline">{p.tytul}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}


<style>
  .na-zmianie-lista {
    display: flex;
    gap: 1.5rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
    padding-right: 2rem;
  }
  .na-zmianie-lista::-webkit-scrollbar {
    display: none;
  }
  .na-zmianie-lista li {
    flex-shrink: 0;
    min-height: 2.75rem;
    max-width: 18rem;
  }
  .na-zmianie-lista li + li {
    border-left: 1px solid var(--color-linia);
    padding-left: 1.5rem;
  }
  .na-zmianie-lista a {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 64rem) {
    .na-zmianie-lista {
      mask-image: none;
      padding-right: 0;
    }
    /* Komputer: trzy najnowsze w równych kolumnach, bez przewijania */
    .na-zmianie-lista {
      flex: 1;
      overflow: visible;
    }
    .na-zmianie-lista li {
      flex: 1 1 0;
      max-width: none;
      min-width: 0;
    }
    .na-zmianie-lista li:nth-child(n + 4) {
      display: none;
    }
  }
</style>
