---
// Pasek tematów pod nagłówkiem: stała nawigacja po zagadnieniach (strony tematów), jak „Topics” w magazynach
// eksperckich. Zastąpił pasek „Na zmianie” z godzinami (Rytm Hali publikuje artykuły, nie wiadomości).
// Na telefonie przewija się w bok kciukiem. Tematy ustawia redakcja w panelu (ustawienia serwisu).
import ustawienia from '../data/ustawienia.json';
import { temat } from '../lib/dane';
interface Props {
  aktywny?: string;
}
const { aktywny } = Astro.props;
const tematy = ustawienia.tematyWyroznione.map(temat);
---
{tematy.length > 0 && (
  <nav class="pasek-tematow border-b border-linia bg-tlo-szare" aria-label="Tematy">
    <div class="kontener flex items-stretch gap-4">
      <p class="flex shrink-0 items-center gap-2 text-kategoria font-bold tracking-[0.08em] text-akcent-tekst uppercase">
        <span class="block size-2 bg-akcent" aria-hidden="true"></span>Tematy
      </p>
      <ul class="pasek-tematow-lista">
        {tematy.map((t) => (
          <li>
            <a href={t.adres} aria-current={aktywny === t.slug ? 'page' : undefined} class="pasek-tematow-link">{t.nazwa}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style>
  .pasek-tematow-lista {
    display: flex;
    gap: 0.25rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
    padding-right: 2rem;
  }
  .pasek-tematow-lista::-webkit-scrollbar {
    display: none;
  }
  .pasek-tematow-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.625rem;
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-tekst);
  }
  .pasek-tematow-link:hover,
  .pasek-tematow-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .pasek-tematow-link:focus-visible {
    outline-offset: -3px;
  }
  @media (min-width: 64rem) {
    .pasek-tematow-lista {
      mask-image: none;
      padding-right: 0;
      flex-wrap: wrap;
      overflow: visible;
    }
  }
</style>
