---
// Stronicowanie list (dział, temat, autor). Pierwsza strona bez numeru w adresie; cele dotyku 44 px.
import Ikona from './Ikona.astro';
import { adresStrony, numeryStron } from '../lib/stronicowanie';
interface Props {
  biezaca: number;
  liczba: number;
  bazowy: string;
  class?: string;
}
const { biezaca, liczba, bazowy, class: klasa } = Astro.props;
const numery = numeryStron(biezaca, liczba);
---
{liczba > 1 && (
  <nav aria-label="Stronicowanie" class:list={['flex flex-wrap items-center justify-center gap-1', klasa]}>
    {biezaca > 1 ? (
      <a href={adresStrony(bazowy, biezaca - 1)} rel="prev" class="strona-link gap-1 px-3"><Ikona nazwa="strzalka-lewo" rozmiar={18} />Poprzednia</a>
    ) : (
      <span class="strona-link invisible gap-1 px-3" aria-hidden="true"><Ikona nazwa="strzalka-lewo" rozmiar={18} />Poprzednia</span>
    )}
    <ol class="flex items-center gap-1">
      {numery.map((n) =>
        n === null ? (
          <li aria-hidden="true" class="px-1 text-tekst-drugi">…</li>
        ) : n === biezaca ? (
          <li><span class="strona-link strona-biezaca" aria-current="page"><span class="sr-only">Strona </span>{n}</span></li>
        ) : (
          <li><a href={adresStrony(bazowy, n)} class="strona-link"><span class="sr-only">Strona </span>{n}</a></li>
        ),
      )}
    </ol>
    {biezaca < liczba ? (
      <a href={adresStrony(bazowy, biezaca + 1)} rel="next" class="strona-link gap-1 px-3">Następna<Ikona nazwa="strzalka" rozmiar={18} /></a>
    ) : (
      <span class="strona-link invisible gap-1 px-3" aria-hidden="true">Następna<Ikona nazwa="strzalka" rozmiar={18} /></span>
    )}
  </nav>
)}

<style>
  .strona-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-tekst);
    border: 1px solid transparent;
  }
  a.strona-link:hover {
    border-color: var(--color-grafit);
  }
  .strona-biezaca {
    background: var(--color-grafit);
    color: var(--color-tekst-na-ciemnym);
  }
</style>
