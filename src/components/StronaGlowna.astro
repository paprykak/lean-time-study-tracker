---
// Strona główna: najpierw narzędzia (profil serwisu od 2026-11-11, DECYZJE.md; rejestr src/data/narzedzia.ts),
// niżej biblioteka artykułów w układzie z podglądu zaakceptowanego w F1. Dobór artykułów: src/lib/redakcja.ts
// (ukladGlownej): wyróżnione ręcznie w panelu, najnowsze, działy bez powtórzeń. „Polecane” to lista redakcji
// z ustawień serwisu; gdy dojdą statystyki (Umami), w tym miejscu pojawią się „Najczęściej czytane”.
import SlotReklamowy from './SlotReklamowy.astro';
import NaglowekSekcji from './NaglowekSekcji.astro';
import NajczesciejCzytane from './NajczesciejCzytane.astro';
import Newsletter from './Newsletter.astro';
import KartaGlowna from './karty/KartaGlowna.astro';
import KartaBoczna from './karty/KartaBoczna.astro';
import KartaSiatka from './karty/KartaSiatka.astro';
import KartaLista from './karty/KartaLista.astro';
import KartaNarzedzia from './narzedzia/KartaNarzedzia.astro';
import Tekst from './Tekst.astro';
import { NARZEDZIA, W_PRZYGOTOWANIU } from '../data/narzedzia';
import ustawienia from '../data/ustawienia.json';
import { DZIALY, dzial } from '../lib/dane';
import { artykuly, karta } from '../lib/tresci';
import { ukladGlownej } from '../lib/redakcja';
import { formularzAktywny } from '../lib/srodowisko.mjs';

const wszystkie = await artykuly();
const u = ukladGlownej(
  wszystkie.map((a) => ({ id: a.id, dzial: a.data.dzial.id, opublikowano: a.data.opublikowano, wyrozniony: a.data.wyrozniony, a })),
  DZIALY.map((d) => d.slug),
);
const k = (x: { a: (typeof wszystkie)[number] }) => karta(x.a);
const polecane = ustawienia.polecane
  .map((slug) => wszystkie.find((a) => a.id === slug))
  .filter((a) => a !== undefined)
  .map((a) => ({ tytul: a.data.tytul, adres: `/${a.id}` }));
---
<div class="kontener">
  <section aria-labelledby="glowna-tytul" class="mt-8 md:mt-10">
    <p class="kategoria">Bezpłatnie, bez logowania</p>
    <h1 id="glowna-tytul" class="tytul-xl mt-2 max-w-[22ch]">{ustawienia.haslo}</h1>
    <p class="lead mt-4 max-w-[52ch]">
      <Tekst t="Kalkulatory i ściągi z prawa pracy i BHP dla produkcji, magazynów i logistyki. Liczymy według przepisów, a przy każdym narzędziu podajemy źródło w Dzienniku Ustaw i datę sprawdzenia." />
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {NARZEDZIA.map((n) => <KartaNarzedzia narzedzie={n} poziom="h2" />)}
      {W_PRZYGOTOWANIU.length > 0 && (
        <div class="border border-dashed border-[#8a939e] p-5">
          <h2 class="kategoria">Wkrótce</h2>
          <ul class="mt-2 space-y-1.5 text-[0.9375rem] text-tekst-tresc">
            {W_PRZYGOTOWANIU.slice(0, 4).map((w) => <li>{w.nazwa}</li>)}
          </ul>
        </div>
      )}
    </div>
    <p class="mt-5"><a href="/narzedzia" class="link">Wszystkie narzędzia</a></p>
  </section>

  <SlotReklamowy komputer="billboard" telefon="mobilny" miejsce="glowna-gora" class="mt-12" />

  <NaglowekSekcji tytul="Artykuły" id="artykuly" class="mt-12" />
  {u.glowny ? (
    <section aria-label="Najważniejsze artykuły" class="mt-6 grid gap-6 lg:grid-cols-12">
      <KartaGlowna artykul={k(u.glowny)} priorytet class="lg:col-span-8" />
      {u.obok.length > 0 && (
        <div class="grid content-start gap-4 lg:col-span-4 [&>article+article]:border-t [&>article+article]:border-linia [&>article+article]:pt-4">
          {u.obok.map((x) => <KartaBoczna artykul={k(x)} poziom="h2" />)}
        </div>
      )}
    </section>
  ) : (
    <p class="lead mt-10">{formularzAktywny('newsletter') ? 'Pierwsze teksty już wkrótce. Zapisz się na newsletter, a dostaniesz je od razu.' : 'Pierwsze teksty już wkrótce.'}</p>
  )}

  {u.najnowsze.length > 0 && (
    <section aria-labelledby="najnowsze" class="mt-12">
      <NaglowekSekcji tytul="Najnowsze" id="najnowsze" />
      <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {u.najnowsze.map((x) => <KartaSiatka artykul={k(x)} zLeadem szerokosc={290} />)}
      </div>
    </section>
  )}

  <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-6">
    <div class="space-y-12 lg:col-span-8">
      {u.sekcje.map((s) => {
        const d = dzial(s.dzial);
        return (
          <section aria-labelledby={`sekcja-${s.dzial}`}>
            <NaglowekSekcji tytul={d.nazwa} id={`sekcja-${s.dzial}`} link={{ nazwa: 'Więcej z działu', adres: d.adres }} />
            <div class="mt-4 grid gap-6 md:grid-cols-2">
              <KartaSiatka artykul={k(s.wiodacy)} zLeadem szerokosc={400} />
              {s.lista.length > 0 && (
                <div class="[&>article:first-child]:border-t-0 [&>article:first-child]:pt-0">
                  {s.lista.map((x) => <KartaLista artykul={k(x)} bezDzialu />)}
                </div>
              )}
            </div>
          </section>
        );
      })}
    </div>
    <aside class="space-y-10 lg:col-span-4" aria-label="Kolumna boczna">
      {polecane.length > 0 && <NajczesciejCzytane tytul="Polecane przez redakcję" artykuly={polecane} />}
      <div class="lg:sticky lg:top-6">
        <SlotReklamowy komputer="prostokat" telefon="mobilny-prostokat" miejsce="glowna-bok" />
      </div>
    </aside>
  </div>

  <div class="mt-14">
    <Newsletter id="glowna-newsletter" wariant="pasek" miejsce="glowna-pasek" />
  </div>

  {u.kolumny.length > 0 && (
    <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-6">
      {u.kolumny.map((kol) => {
        const d = dzial(kol.dzial);
        return (
          <section aria-labelledby={`kolumna-${kol.dzial}`}>
            <NaglowekSekcji tytul={d.nazwa} id={`kolumna-${kol.dzial}`} link={{ nazwa: 'Więcej', adres: d.adres }} />
            <div class="mt-2 [&>article:first-child]:border-t-0">
              {kol.lista.map((x) => <KartaLista artykul={k(x)} bezDzialu />)}
            </div>
          </section>
        );
      })}
    </div>
  )}
</div>
