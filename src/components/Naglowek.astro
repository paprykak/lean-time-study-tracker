---
// Nagłówek serwisu: pasek górny (komputer), logo, pole wyszukiwania narzędzi i pasek kategorii z liczbą narzędzi
// (rejestr src/data/narzedzia.ts). Na stronie głównej, /narzedzia i /szukaj pole jest w treści, więc w nagłówku go nie
// ma (jedno pole na ekranie). Pasek kategorii na telefonie przewija się w bok kciukiem; cele dotyku co najmniej 44 px.
// Bez JavaScriptu: wyszukiwarka to zwykły formularz GET do /szukaj, kategorie to kotwice na /narzedzia.
import Logo from './Logo.astro';
import Ikona from './Ikona.astro';
import Wyszukiwarka from './narzedzia/Wyszukiwarka.astro';
import ustawienia from '../data/ustawienia.json';
import { KATEGORIE, NARZEDZIA, type KategoriaNarzedzia } from '../data/narzedzia';
import { formularzAktywny } from '../lib/srodowisko.mjs';

interface Props {
  /** Klucz kategorii narzędzia, „narzedzia” (lista) albo adres aktywnej pozycji paska górnego. */
  aktywny?: string;
  /** Strona ma własne pole wyszukiwania w treści (główna, /narzedzia, /szukaj). */
  bezSzukania?: boolean;
}
const { aktywny, bezSzukania = false } = Astro.props;
// Bez działającego zapisu przycisk prowadzi do opisu newslettera, a nie wzywa do zapisu (FORMULARZE).
const napisNewslettera = formularzAktywny('newsletter') ? 'Zapisz się na newsletter' : ustawienia.newsletter.nazwa;
const pozycje = [
  { nazwa: 'Wszystkie narzędzia', adres: '/narzedzia', klucz: 'narzedzia', liczba: NARZEDZIA.length },
  ...(Object.keys(KATEGORIE) as KategoriaNarzedzia[])
    .map((k) => ({ nazwa: KATEGORIE[k].krotko, adres: `/narzedzia#${k}`, klucz: k as string, liczba: NARZEDZIA.filter((n) => n.kategoria === k).length }))
    .filter((p) => p.liczba > 0),
];
---
<header class="naglowek">
  <div class="hidden bg-grafit-ciemny text-tekst-na-ciemnym-drugi md:block">
    <div class="kontener flex h-9 items-center justify-between text-[0.8125rem]">
      <p>{ustawienia.haslo}</p>
      <nav aria-label="Serwis">
        <ul class="flex items-center gap-6">
          {ustawienia.pasekGorny.map((l) => (
            <li><a href={l.adres} class="py-2 najazd:text-white najazd:underline">{l.nazwa}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-b border-linia bg-tlo">
    <div class="kontener flex h-16 items-center gap-4 md:h-24">
      <a href="/" class="inline-flex min-h-11 shrink-0 items-center" aria-label={`${ustawienia.nazwa}, strona główna`}>
        <Logo wariant="kompakt" class="h-8 w-auto md:hidden" />
        <Logo wariant="pelne" class="hidden h-[3.75rem] w-auto md:block" />
      </a>
      <div class="ml-auto flex items-center gap-3">
        {!bezSzukania && (
          <Wyszukiwarka id="szukaj-naglowek" wariant="naglowek" ukrytaEtykieta etykieta="Szukaj narzędzia albo pytania" placeholder="Szukaj, np. L4, urlop" limit={5} class="hidden w-[22rem] lg:block" />
        )}
        <a href="/newsletter" class="przycisk przycisk-obrys hidden md:inline-flex">{napisNewslettera}</a>
        {!bezSzukania && (
          <a href="/szukaj" class="-mr-2 grid size-11 place-items-center text-tekst lg:hidden" aria-label="Szukaj narzędzia">
            <Ikona nazwa="szukaj" rozmiar={22} />
          </a>
        )}
      </div>
    </div>
  </div>

  <nav class="menu-dzialow bg-grafit" aria-label="Kategorie narzędzi">
    <div class="kontener">
      <ul class="menu-dzialow-lista">
        {pozycje.map((p) => {
          const biezacy = aktywny === p.klucz;
          return (
            <li>
              <a href={p.adres} class:list={['menu-dzialow-link', { 'menu-dzialow-link-aktywny': biezacy }]} aria-current={biezacy ? (p.klucz === 'narzedzia' ? 'page' : 'true') : undefined} data-kategoria-menu={p.klucz}>
                {p.nazwa}<span class="menu-dzialow-liczba">{p.liczba}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>

<style>
  .menu-dzialow-lista {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    /* Wygaszenie prawej krawędzi sygnalizuje, że menu przewija się w bok; odstęp pozwala dociągnąć ostatnią pozycję. */
    mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    padding-right: 2.5rem;
    margin-inline: -0.75rem;
  }
  .menu-dzialow-lista::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 64rem) {
    .menu-dzialow-lista {
      mask-image: none;
      padding-right: 0;
    }
  }
  .menu-dzialow-link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 0.75rem;
    white-space: nowrap;
    scroll-snap-align: start;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-tekst-na-ciemnym);
  }
  .menu-dzialow-link::after {
    content: "";
    position: absolute;
    inset: auto 0.75rem 0 0.75rem;
    height: 3px;
    background: transparent;
  }
  .menu-dzialow-link:hover::after,
  :global(.stan-najazd) .menu-dzialow-link::after {
    background: var(--color-tekst-na-ciemnym-drugi);
  }
  .menu-dzialow-link-aktywny::after,
  .menu-dzialow-link-aktywny:hover::after {
    background: var(--color-akcent);
  }
  .menu-dzialow-liczba {
    margin-left: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-tekst-na-ciemnym-drugi);
  }
  .menu-dzialow-link:focus-visible {
    outline-offset: -3px;
  }
</style>
