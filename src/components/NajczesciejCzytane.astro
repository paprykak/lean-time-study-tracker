---
// „Najczęściej czytane”: lista numerowana 1–5. Dane z Umami albo ustawione ręcznie (F3).
import NaglowekSekcji from './NaglowekSekcji.astro';
interface Props {
  artykuly: { tytul: string; adres: string }[];
  tytul?: string;
  class?: string;
}
const { artykuly, tytul = 'Najczęściej czytane', class: klasa } = Astro.props;
const id = 'najczesciej-czytane';
---
{artykuly.length > 0 && (
  <section aria-labelledby={id} class={klasa}>
    <NaglowekSekcji tytul={tytul} id={id} />
    <ol class="mt-1">
      {artykuly.slice(0, 5).map((a, i) => (
        <li class="karta grid grid-cols-[2.25rem_1fr] items-start gap-2 border-b border-linia py-3 last:border-b-0">
          <span class="font-display text-[1.75rem] leading-none font-bold text-akcent tabular-nums" aria-hidden="true">{i + 1}</span>
          <a href={a.adres} class="karta-link karta-tytul font-display text-[1rem] leading-snug font-bold text-tekst">{a.tytul}</a>
        </li>
      ))}
    </ol>
  </section>
)}
