---
// Spis treści długiego artykułu (kotwice do śródtytułów). Bez JavaScriptu; na telefonie zwijany (details).
interface Props {
  pozycje: { id: string; tytul: string }[];
}
const { pozycje } = Astro.props;
---
<details class="spis-tresci" open>
  <summary>W tym artykule</summary>
  <ol>
    {pozycje.map((p) => <li><a href={`#${p.id}`}>{p.tytul}</a></li>)}
  </ol>
</details>

<style>
  .spis-tresci {
    border-left: 3px solid var(--color-grafit);
    background: var(--color-tlo-szare);
    padding: 0.75rem 1rem 0.875rem;
  }
  .spis-tresci summary {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: var(--text-kategoria);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-tekst);
  }
  .spis-tresci ol {
    margin: 0;
    padding-left: 1.25rem;
    list-style: decimal;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .spis-tresci li {
    margin-top: 0.25rem;
    padding: 0.25rem 0;
  }
  .spis-tresci li::marker {
    color: var(--color-tekst-drugi);
  }
  /* Link w linii (nie inline-block), żeby numer listy stał przy pierwszej linii długiej pozycji. */
  .spis-tresci a {
    color: var(--color-tekst);
    font-weight: 600;
    text-decoration: none;
  }
  .spis-tresci a:hover {
    text-decoration: underline;
  }
</style>
