---
// Treść artykułu z Markdowna (slot domyślny: <Content />) z reklamą w treści. Miejsce wyznacza wtyczka
// src/lib/markdown.mjs (znacznik po 3. akapicie); bez znacznika (krótki tekst) treść idzie w całości, bez reklamy.
// Zdjęcia i kotwice zostają przetworzone przez Astro, bo dzielimy już wyrenderowany HTML.
import { ZNACZNIK_REKLAMY } from '../../lib/markdown.mjs';

const html = await Astro.slots.render('default');
const [przed, ...reszta] = html.split(`<!--${ZNACZNIK_REKLAMY}-->`);
const po = reszta.join('');
---
<Fragment set:html={przed} />
{reszta.length > 0 && <><slot name="reklama" /><Fragment set:html={po} /></>}
