---
// Ramka materiału do pobrania w treści artykułu: co to jest, format i rozmiar, przycisk ze zdarzeniem statystyk.
import Ikona from '../Ikona.astro';
import Tekst from '../Tekst.astro';
interface Props {
  tytul: string;
  opis: string;
  format: string;
  adres: string;
  slug: string;
}
const { tytul, opis, format, adres, slug } = Astro.props;
---
<aside class="ramka-pobrania" aria-label={`Do pobrania: ${tytul}`}>
  <div class="ramka-pobrania-ikona" aria-hidden="true"><Ikona nazwa="pobierz" rozmiar={26} /></div>
  <div class="min-w-0">
    <p class="kategoria">Do pobrania · bezpłatnie</p>
    <p class="mt-1 font-display text-[1.125rem] leading-snug font-bold text-tekst"><Tekst t={tytul} /></p>
    <p class="mt-1 text-[0.9375rem] leading-relaxed"><Tekst t={opis} /></p>
    <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href={adres} class="przycisk przycisk-grafit no-underline" data-umami-event="Pobranie" data-umami-event-material={slug}><Ikona nazwa="pobierz" rozmiar={18} />Pobierz</a>
      <span class="meta">{format}</span>
    </p>
  </div>
</aside>

<style>
  .ramka-pobrania {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--color-linia);
    border-top: 3px solid var(--color-akcent);
  }
  .ramka-pobrania-ikona {
    display: none;
  }
  @media (min-width: 40rem) {
    .ramka-pobrania-ikona {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 3.5rem;
      height: 3.5rem;
      background: var(--color-tlo-szare);
      color: var(--color-tekst);
    }
  }
  /* Przycisk w ramce nie dziedziczy wyglądu linków z treści artykułu */
  .ramka-pobrania :global(a.przycisk) {
    color: var(--color-tekst-na-ciemnym);
    text-decoration: none;
  }
</style>
