---
// Pasek informacyjny na stronach podglądu szablonów (/podglad/*): treści są przykładowe i fikcyjne.
interface Props {
  szablon: string;
}
const { szablon } = Astro.props;
---
<p class="mt-4 border-l-4 border-akcent bg-tlo-szare px-4 py-2.5 text-[0.875rem]">
  <strong class="text-tekst">Podgląd szablonu {szablon}.</strong> Treści, daty i nazwy są przykładowe i fikcyjne; zdjęcia prawdziwe, z rejestru licencji.
</p>
