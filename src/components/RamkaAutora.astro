---
// Ramka autora pod artykułem i na stronie autora. Zdjęcie kwadratowe (promień do 4 px, sekcja 6), bez zdjęcia: inicjały.
import { Image } from 'astro:assets';
import Ikona from './Ikona.astro';
import Tekst from './Tekst.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  imie: string;
  rola: string;
  bio: string;
  adres: string;
  zdjecie?: ImageMetadata;
  linkedin?: string;
  email?: string;
  class?: string;
}
const { imie, rola, bio, adres, zdjecie, linkedin, email, class: klasa } = Astro.props;
const inicjaly = imie
  .split(/\s+/)
  .map((c) => c[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---
<aside class:list={['karta flex gap-4 border-t-2 border-grafit pt-5', klasa]} aria-label={`O autorze: ${imie}`}>
  {zdjecie ? (
    <Image src={zdjecie} alt="" width={80} height={80} densities={[1, 2, 3]} fit="cover" class="size-20 shrink-0 rounded-[var(--radius-karta)] object-cover" />
  ) : (
    <span class="grid size-20 shrink-0 place-items-center rounded-[var(--radius-karta)] bg-grafit font-display text-[1.5rem] font-bold text-white" aria-hidden="true">{inicjaly}</span>
  )}
  <div class="min-w-0">
    <p class="kategoria">Autor</p>
    <p class="mt-0.5 font-display text-[1.125rem] font-bold text-tekst">
      <a href={adres} class="karta-link karta-tytul">{imie}</a>
    </p>
    <p class="meta">{rola}</p>
    <p class="mt-2 text-[0.9375rem] leading-relaxed"><Tekst t={bio} /></p>
    {(linkedin || email) && (
      <ul class="karta-nad mt-2 flex flex-wrap gap-x-4">
        {linkedin && <li><a href={linkedin} rel="me noopener" target="_blank" class="link inline-flex min-h-11 items-center gap-1.5 text-[0.875rem]"><Ikona nazwa="linkedin" rozmiar={16} />LinkedIn</a></li>}
        {email && <li><a href={`mailto:${email}`} class="link inline-flex min-h-11 items-center gap-1.5 text-[0.875rem]"><Ikona nazwa="poczta" rozmiar={16} />{email}</a></li>}
      </ul>
    )}
  </div>
</aside>
