---
// Pole wyszukiwania narzędzi: strona główna (duże) i nagłówek (zwarte). Bez JavaScriptu to zwykły formularz GET do
// /szukaj. Ze skryptem wyniki pojawiają się pod polem w trakcie pisania (indeks /narzedzia/indeks.json pobierany przy
// pierwszym użyciu, src/lib/szukaj-narzedzi.ts): nazwa narzędzia i pytanie z FAQ, na które odpowiada.
// Dostępność: wyniki to lista linków (nawigacja, nie wybór wartości), liczba w role="status"; ↓ z pola przenosi do
// wyników, ↑/↓ między nimi, Esc zamyka i wraca do pola.
import Ikona from '../Ikona.astro';

interface Props {
  /** Prefiks identyfikatorów (kilka pól na jednej stronie). */
  id: string;
  wariant?: 'duze' | 'naglowek';
  etykieta?: string;
  /** Etykieta tylko dla czytnika ekranu (nagłówek). */
  ukrytaEtykieta?: boolean;
  placeholder?: string;
  /** Ile wyników pokazać pod polem. */
  limit?: number;
  class?: string;
}
const {
  id,
  wariant = 'duze',
  etykieta = 'Wpisz pytanie albo nazwę narzędzia',
  ukrytaEtykieta = false,
  placeholder = 'np. ile za nadgodziny',
  limit = 6,
  class: klasa,
} = Astro.props;
---
<form action="/szukaj" method="get" role="search" class:list={['szukajka', `szukajka-${wariant}`, klasa]} data-szukajka data-limit={limit}>
  <label for={id} class:list={[ukrytaEtykieta ? 'sr-only' : 'szukajka-etykieta']}>{etykieta}</label>
  <div class="szukajka-pole">
    <span class="szukajka-lupa" aria-hidden="true"><Ikona nazwa="szukaj" rozmiar={wariant === 'duze' ? 22 : 18} /></span>
    <input
      id={id}
      name="q"
      type="search"
      class="szukajka-input"
      placeholder={placeholder}
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      maxlength="120"
      aria-describedby={`${id}-opis`}
      data-szukajka-pole
    />
    <button type="submit" class="szukajka-przycisk">{wariant === 'duze' ? 'Szukaj' : <><span class="sr-only">Szukaj</span><Ikona nazwa="szukaj" rozmiar={18} /></>}</button>
  </div>
  <p id={`${id}-opis`} class="sr-only">Wyniki pojawiają się pod polem w trakcie pisania. Strzałka w dół przenosi do wyników.</p>
  <p class="sr-only" role="status" aria-live="polite" data-szukajka-status></p>
  <div class="szukajka-warstwa" hidden data-szukajka-warstwa>
    <p class="szukajka-licznik" data-szukajka-licznik></p>
    <ul class="szukajka-lista" aria-label="Wyniki" data-szukajka-lista></ul>
    <a href="/szukaj" class="szukajka-pelny" data-szukajka-pelny>Szukaj w pełnym tekście wszystkich narzędzi</a>
  </div>
</form>

<script>
  import { ileNarzedzi, slowa, szukaj, wierszWyniku, zaladujIndeks } from '../../lib/szukaj-klient';

  for (const formularz of document.querySelectorAll<HTMLFormElement>('[data-szukajka]')) {
    const pole = formularz.querySelector<HTMLInputElement>('[data-szukajka-pole]')!;
    const warstwa = formularz.querySelector<HTMLElement>('[data-szukajka-warstwa]')!;
    const lista = formularz.querySelector<HTMLUListElement>('[data-szukajka-lista]')!;
    const licznik = formularz.querySelector<HTMLElement>('[data-szukajka-licznik]')!;
    const status = formularz.querySelector<HTMLElement>('[data-szukajka-status]')!;
    const pelny = formularz.querySelector<HTMLAnchorElement>('[data-szukajka-pelny]')!;
    const limit = Number(formularz.dataset.limit) || 6;
    let zegar: number | undefined;
    let numer = 0;

    // Świadomie bez roli combobox i aria-expanded (pole typu search ich nie przyjmuje): wyniki to zwykła lista linków,
    // a liczbę wyników ogłasza role="status".
    const zamknij = () => {
      warstwa.hidden = true;
    };

    async function pokaz() {
      const q = pole.value.trim();
      const moj = ++numer;
      if (q.length < 2) {
        zamknij();
        status.textContent = '';
        return;
      }
      let indeks;
      try {
        indeks = await zaladujIndeks();
      } catch {
        return; // Bez indeksu zostaje zwykły formularz do /szukaj.
      }
      if (moj !== numer) return;
      const szukane = slowa(q);
      const wszystkie = szukaj(indeks, q);
      const wyniki = wszystkie.slice(0, limit);
      lista.replaceChildren(...wyniki.map((w) => wierszWyniku(w, szukane, 'szukajka-wynik')));
      const tekst = wszystkie.length
        ? wszystkie.length > limit
          ? `${ileNarzedzi(wszystkie.length)}, pokazujemy ${limit} najlepiej pasujących`
          : `${ileNarzedzi(wszystkie.length)}`
        : `Nie mamy narzędzia do „${q}”. Spróbuj prostszego słowa, np. urlop albo L4.`;
      licznik.textContent = tekst;
      pelny.href = `/szukaj?q=${encodeURIComponent(q)}`;
      pelny.textContent = `Szukaj „${q}” w pełnym tekście wszystkich narzędzi`;
      warstwa.hidden = false;
      // Czytnik ekranu słyszy liczbę po chwili bez pisania, a nie przy każdym znaku.
      window.clearTimeout(zegar);
      zegar = window.setTimeout(() => (status.textContent = tekst), 700);
    }

    let opoznienie: number | undefined;
    pole.addEventListener('input', () => {
      window.clearTimeout(opoznienie);
      opoznienie = window.setTimeout(pokaz, 120);
    });
    pole.addEventListener('focus', () => zaladujIndeks().catch(() => {}));
    // Kliknięcie w pole z wpisanym tekstem pokazuje wyniki ponownie (fokus po Esc ich nie otwiera).
    pole.addEventListener('click', () => {
      if (warstwa.hidden && pole.value.trim().length >= 2) pokaz();
    });

    const linki = () => [...formularz.querySelectorAll<HTMLAnchorElement>('.szukajka-wynik-link, [data-szukajka-pelny]')];
    formularz.addEventListener('keydown', (e) => {
      if (warstwa.hidden) return;
      const l = linki();
      const i = l.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        l[Math.min(i + 1, l.length - 1)]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (i <= 0) pole.focus();
        else l[i - 1].focus();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        if (document.activeElement === pole) pole.value = '';
        zamknij();
        pole.focus();
      }
    });
    // Klik albo fokus poza polem zamyka wyniki (nagłówek: warstwa nad treścią).
    document.addEventListener('pointerdown', (e) => {
      if (!formularz.contains(e.target as Node)) zamknij();
    });
    formularz.addEventListener('focusout', (e) => {
      if (!formularz.contains(e.relatedTarget as Node | null) && e.relatedTarget) zamknij();
    });
  }
</script>

<style>
  .szukajka {
    position: relative;
    min-width: 0;
  }
  .szukajka-etykieta {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-tekst);
  }
  .szukajka-pole {
    display: flex;
    align-items: stretch;
    border: 2px solid var(--color-grafit);
    border-radius: var(--radius-przycisk);
    background: var(--color-tlo);
  }
  .szukajka-pole:focus-within {
    outline: 3px solid var(--color-akcent);
    outline-offset: 1px;
  }
  .szukajka-lupa {
    display: grid;
    place-items: center;
    padding-left: 0.75rem;
    color: var(--color-tekst-drugi);
  }
  .szukajka-input {
    flex: 1;
    min-width: 0;
    padding: 0 0.75rem;
    background: transparent;
    color: var(--color-tekst);
    font-size: 1rem;
    outline: none;
  }
  .szukajka-input::placeholder {
    color: var(--color-tekst-drugi);
  }
  .szukajka-input::-webkit-search-cancel-button {
    cursor: pointer;
  }
  .szukajka-przycisk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0 1.25rem;
    background: var(--color-akcent-tekst);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
  }
  .szukajka-przycisk:hover {
    background: var(--color-akcent-ciemny);
  }
  .szukajka-przycisk:focus-visible {
    outline: 3px solid var(--color-grafit);
    outline-offset: -5px;
  }
  .szukajka-duze .szukajka-pole {
    min-height: 3.5rem;
  }
  .szukajka-duze .szukajka-input {
    font-size: 1.125rem;
  }
  .szukajka-naglowek .szukajka-pole {
    min-height: 2.75rem;
    border-width: 1px;
  }
  .szukajka-naglowek .szukajka-przycisk {
    width: 2.75rem;
    padding: 0;
    background: var(--color-grafit);
  }
  .szukajka-warstwa {
    position: absolute;
    inset: calc(100% + 0.25rem) 0 auto 0;
    z-index: 40;
    max-height: min(70vh, 34rem);
    overflow-y: auto;
    border: 1px solid var(--color-linia);
    border-top: 3px solid var(--color-grafit);
    background: var(--color-tlo);
    box-shadow: var(--shadow-warstwa);
  }
  .szukajka-naglowek .szukajka-warstwa {
    left: auto;
    width: min(32rem, calc(100vw - 2rem));
  }
  .szukajka-licznik {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-linia);
    font-size: 0.8125rem;
    color: var(--color-tekst-drugi);
  }
  .szukajka-pelny {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    background: var(--color-tlo-szare);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-akcent-tekst);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .szukajka-pelny:focus-visible {
    outline: 3px solid var(--color-akcent);
    outline-offset: -3px;
  }
  :global(.szukajka-wynik + .szukajka-wynik) {
    border-top: 1px solid var(--color-linia);
  }
  :global(.szukajka-wynik-link) {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--color-tekst);
  }
  :global(.szukajka-wynik-link:hover),
  :global(.szukajka-wynik-link:focus-visible) {
    background: var(--color-tlo-szare);
  }
  :global(.szukajka-wynik-link:focus-visible) {
    outline: 3px solid var(--color-akcent);
    outline-offset: -3px;
  }
  :global(.szukajka-wynik-nazwa) {
    display: block;
    margin-top: 0.125rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  :global(.szukajka-wynik-opis) {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-tekst-tresc);
  }
</style>
