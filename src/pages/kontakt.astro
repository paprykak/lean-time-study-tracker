---
// Strona stała: tekst w src/content/strony/kontakt.md (edycja w panelu: „Strony stałe”) i formularz kontaktowy (F6).
import StronaStala from '../components/StronaStala.astro';
import FormularzKontaktu from '../components/FormularzKontaktu.astro';
import { formularzAktywny } from '../lib/srodowisko.mjs';
// Bez Email Routing produkcja nie pokazuje formularza (kończyłby się stroną błędu), tylko adres redakcji z tekstu strony.
const formularz = formularzAktywny('kontakt');
---
<StronaStala slug="kontakt" aktywny="/kontakt">
  {formularz && <FormularzKontaktu />}
</StronaStala>
