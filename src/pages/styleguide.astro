---
// /styleguide (noindex): tokeny, typografia i wszystkie komponenty w stanach (najechanie, fokus, pusty, długi tytuł).
// Na tej stronie Patryk akceptuje wygląd (bramka F1; od 2026-11-12 komponenty serwisu narzędzi). Przykłady to
// prawdziwe narzędzia z rejestru albo treści fikcyjne.
import Uklad from '../layouts/Uklad.astro';
import NaglowekSekcji from '../components/NaglowekSekcji.astro';
import SlotReklamowy from '../components/SlotReklamowy.astro';
import Newsletter from '../components/Newsletter.astro';
import Okruszki from '../components/Okruszki.astro';
import StronaBledu from '../components/StronaBledu.astro';
import KartaNarzedzia from '../components/narzedzia/KartaNarzedzia.astro';
import Faq from '../components/narzedzia/Faq.astro';
import Wyszukiwarka from '../components/narzedzia/Wyszukiwarka.astro';
import { KATEGORIE, adresNarzedzia, narzedzie } from '../data/narzedzia';
import { tokenyKolorow } from '../lib/tokeny';
import { kontrast, zapisKontrastu } from '../lib/kontrast';
import { FORMATY, type Format, type Kampania } from '../lib/reklamy';
import LogoJasne from '../../marka/logo/svg/rytm-hali-jasne.svg';
import LogoCiemne from '../../marka/logo/svg/rytm-hali-ciemne.svg';
import LogoCb from '../../marka/logo/svg/rytm-hali-cb.svg';
import LogoCbNegatyw from '../../marka/logo/svg/rytm-hali-cb-negatyw.svg';
import LogoKompaktJasne from '../../marka/logo/svg/rytm-hali-kompakt-jasne.svg';
import LogoKompaktCiemne from '../../marka/logo/svg/rytm-hali-kompakt-ciemne.svg';
import Ikonka from '../../marka/logo/svg/rytm-hali-ikona.svg';
import IkonkaMala from '../../marka/logo/svg/rytm-hali-ikona-mala.svg';
import IkonkaCb from '../../marka/logo/svg/rytm-hali-ikona-cb.svg';
import fav16 from '../../marka/logo/png/favicon-16.png?url';
import fav32 from '../../marka/logo/png/favicon-32.png?url';
import fav48 from '../../marka/logo/png/favicon-48.png?url';
import apple from '../../marka/logo/png/apple-touch-icon-180.png?url';
import awatar from '../../marka/logo/png/awatar-linkedin-400.png?url';
import okladka from '../../marka/logo/png/okladka-domyslna-1200x630.jpg?url';
import k970 from '../assets/przyklady/kreacja-970x250.svg?url';
import k750 from '../assets/przyklady/kreacja-750x200.svg?url';
import k300 from '../assets/przyklady/kreacja-300x250.svg?url';
import k600 from '../assets/przyklady/kreacja-300x600.svg?url';
import k320 from '../assets/przyklady/kreacja-320x100.svg?url';

const t = tokenyKolorow();
const KOLORY: { token: string; uzycie: string; tlo?: string }[] = [
  { token: 'tlo', uzycie: 'Tło stron' },
  { token: 'tlo-szare', uzycie: 'Tło pola wyszukiwania na stronie głównej, ramki, zastrzeżenia' },
  { token: 'grafit', uzycie: 'Pasek kategorii, przyciski grafitowe, linie nagłówków sekcji' },
  { token: 'grafit-ciemny', uzycie: 'Pasek górny, stopka' },
  { token: 'tekst', uzycie: 'Tytuły' },
  { token: 'tekst-tresc', uzycie: 'Treść stron i opisy narzędzi' },
  { token: 'tekst-drugi', uzycie: 'Metadane, podpisy, „REKLAMA”' },
  { token: 'akcent', uzycie: 'Kolor marki: paski, dach logo, numery, fokus, duży tekst' },
  { token: 'akcent-tekst', uzycie: 'Kategorie, linki, przycisk główny (mały tekst)' },
  { token: 'akcent-ciemny', uzycie: 'Linki i przycisk główny po najechaniu' },
  { token: 'linia', uzycie: 'Cienkie linie między sekcjami i pozycjami list' },
  { token: 'blad', uzycie: 'Komunikaty błędów formularzy' },
  { token: 'sukces', uzycie: 'Potwierdzenia formularzy' },
];
// Napis na próbce: czarny albo biały, który ma wyższy kontrast z kolorem próbki.
const napisNaProbce = (hex: string) => (kontrast(hex, '#000000') > kontrast(hex, '#ffffff') ? 'text-black' : 'text-white');

const SPIS = [
  ['kolory', 'Kolory'],
  ['typografia', 'Typografia'],
  ['siatka', 'Siatka i odstępy'],
  ['logo', 'Logo'],
  ['przyciski', 'Przyciski i pola'],
  ['wyszukiwanie', 'Pole wyszukiwania'],
  ['karty', 'Karty i wiersze narzędzi'],
  ['listy', 'Nagłówki sekcji i pytania'],
  ['reklamy', 'Sloty reklamowe'],
  ['newsletter', 'Newsletter'],
  ['nawigacja', 'Okruszki'],
  ['tresc-sg', 'Treść stron i wyjaśnień'],
  ['blad', 'Strona błędu'],
] as const;

const kampania: Kampania = {
  id: 'przyklad-styleguide',
  reklamodawca: 'Reklamodawca fikcyjny',
  link: 'https://example.com/',
  komputer: { src: k970, alt: 'Kreacja przykładowa 970 × 250' },
  telefon: { src: k320, alt: 'Kreacja przykładowa 320 × 100' },
};
const kreacjaDla: Record<Format, string> = { billboard: k970, baner: k750, prostokat: k300, polstrona: k600, mobilny: k320, 'mobilny-prostokat': k300 };
const kampaniaFormat = (f: Format): Kampania => ({ ...kampania, komputer: { src: kreacjaDla[f], alt: `Kreacja przykładowa ${FORMATY[f].szerokosc} × ${FORMATY[f].wysokosc}` }, telefon: { src: kreacjaDla[f], alt: `Kreacja przykładowa ${FORMATY[f].szerokosc} × ${FORMATY[f].wysokosc}` } });
const przyklady = ['kalkulator-l4', 'kalkulator-nadgodzin', 'waznosc-uprawnien-udt'].map(narzedzie);
---
<Uklad tytul="System wizualny | Rytm Hali" opis="Tokeny, typografia i komponenty Rytmu Hali do akceptacji wyglądu (strona wewnętrzna)." noindex aktywny="wynagrodzenie">

  <div class="kontener py-8">
    <p class="kategoria">Bramka F1 · do akceptacji</p>
    <h1 class="tytul-xl mt-2">System wizualny Rytmu Hali</h1>
    <p class="lead mt-3 max-w-3xl">
      Tokeny, typografia i komponenty w stanach: zwykły, po najechaniu, z fokusem klawiatury, pusty i z długim tytułem.
      Przykłady to prawdziwe narzędzia z rejestru albo treści fikcyjne. Nagłówek wyżej pokazuje aktywną kategorię „Wynagrodzenie”.
    </p>
    <div class="mt-5 border-l-4 border-akcent bg-tlo-szare px-4 py-3 text-[0.9375rem]">
      <p><strong class="text-tekst">Logo:</strong> koncepcja C po szlifie (uzasadnienie w <code>marka/README.md</code>); oryginalne pliki Patryka podmienią je bez zmian w szablonach.</p>
    </div>
    <nav aria-label="Spis treści" class="mt-6">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem]">
        {SPIS.map(([id, nazwa]) => <li><a href={`#${id}`} class="link inline-flex min-h-11 items-center">{nazwa}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="kontener space-y-16">
    {/* KOLORY */}
    <section aria-labelledby="kolory">
      <NaglowekSekcji tytul="Kolory" id="kolory" />
      <p class="mt-3 max-w-3xl text-[0.9375rem]">Białe tło, grafit i jeden akcent (pomarańcz). Kontrast liczony według WCAG 2.2; pary tekst/tło pilnuje test <code>src/lib/tokeny.test.ts</code>.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {KOLORY.map(({ token, uzycie }) => {
          const hex = t[token];
          return (
            <li class="border border-linia">
              <div class:list={['flex h-24 items-end p-3 font-mono text-[0.8125rem]', napisNaProbce(hex)]} data-kolor={token}>
                <span>{hex}</span>
              </div>
              <div class="border-t border-linia p-3">
                <p class="font-bold text-tekst">{token}</p>
                <p class="meta mt-1">{uzycie}</p>
                <p class="meta mt-1 tabular-nums">Na białym {zapisKontrastu(kontrast(hex, '#ffffff'))} · na grafitowym {zapisKontrastu(kontrast(hex, t['grafit-ciemny']))}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    {/* TYPOGRAFIA */}
    <section aria-labelledby="typografia">
      <NaglowekSekcji tytul="Typografia" id="typografia" />
      <p class="mt-3 max-w-3xl text-[0.9375rem]">Noto Sans Display Bold w tytułach, Noto Sans w tekście (400–700). Fonty u siebie, podzbiór łaciński z polskimi znakami (30 KB i 17 KB).</p>
      <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
        <div class="space-y-6">
          <div>
            <p class="meta">Hierarchia strony narzędzia: kategoria, tytuł, lead, data sprawdzenia</p>
            <div class="mt-3 border-t border-linia pt-4">
              <p class="kategoria">Wynagrodzenie i zasiłki</p>
              <p class="tytul-xl mt-2">Zażółć gęślą jaźń: ile dostaniesz na zwolnieniu lekarskim</p>
              <p class="lead mt-3">Przykładowy lead: jedno, dwa zdania o tym, co narzędzie policzy i z jakiego przepisu.</p>
              <p class="meta mt-3">Sprawdzono z przepisami: 12 listopada 2026. Liczy w przeglądarce: niczego nie wysyłamy ani nie zapisujemy.</p>
            </div>
          </div>
        </div>
        <dl class="divide-y divide-linia border-y border-linia text-[0.9375rem]">
          {[
            ['tytul-xl', 'Tytuł strony (H1)', '28 / 36 / 42 px · Display Bold'],
            ['tytul-l', 'Tytuł sekcji wyróżnionej', '22 / 24 px · Display Bold'],
            ['tytul-m', 'Karta narzędzia', '18 px · Display Bold'],
            ['tytul-s', 'Listy', '16 px · Display Bold'],
            ['lead', 'Lead', '18 / 20 px · Sans 400'],
            ['tresc', 'Treść stron i wyjaśnień narzędzi', '17 / 18 px · interlinia 1,75'],
            ['meta', 'Metadane', '13 px · Sans 400'],
            ['kategoria', 'Kategoria', '12 px · Sans 700 · wersaliki, światło 0,08 em'],
          ].map(([klasa, nazwa, opis]) => (
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-3">
              <dt class="font-mono text-[0.8125rem] text-tekst-drugi">.{klasa}</dt>
              <dd><span class="font-semibold text-tekst">{nazwa}</span><br /><span class="meta">{opis}</span></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    {/* SIATKA */}
    <section aria-labelledby="siatka">
      <NaglowekSekcji tytul="Siatka i odstępy" id="siatka" />
      <p class="mt-3 max-w-3xl text-[0.9375rem]">Treść 1240 px, 12 kolumn, odstęp 24 px na komputerze i 16 px na telefonie. Sekcje dzielą cienkie linie 1 px, nagłówki sekcji mają linię 2 px. Promień kart i zdjęć: 2 px. Bez cieni na kartach.</p>
      <div class="mt-5 grid grid-cols-4 gap-4 md:grid-cols-12 lg:gap-6" aria-hidden="true">
        {Array.from({ length: 12 }, (_, i) => <div class:list={['h-16 bg-tlo-szare', { 'hidden md:block': i >= 4 }]}><span class="block h-1 bg-akcent"></span></div>)}
      </div>
      <ul class="mt-6 flex flex-wrap items-end gap-6 text-[0.8125rem] text-tekst-drugi" aria-label="Skala odstępów">
        {[4, 8, 12, 16, 24, 32, 40, 64].map((px) => (
          <li class="flex flex-col items-start gap-1"><span class="block bg-grafit" data-odstep={px}></span>{px} px</li>
        ))}
      </ul>
    </section>

    {/* LOGO */}
    <section aria-labelledby="logo">
      <NaglowekSekcji tytul="Logo" id="logo" />
      <p class="mt-3 max-w-3xl text-[0.9375rem]">Koncepcja C: plakietka z dachem szedowym, litery RH, napis i podtytuł. Tekst jako krzywe. Pliki: <code>marka/logo/</code> (<code>npm run logo</code>).</p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <div class="flex min-h-36 items-center border border-linia p-8"><LogoJasne class="h-16 w-auto" aria-label="Logo, wersja jasna" /></div>
        <div class="flex min-h-36 items-center bg-grafit-ciemny p-8"><LogoCiemne class="h-16 w-auto" aria-label="Logo, wersja ciemna" /></div>
        <div class="flex min-h-36 items-center border border-linia p-8"><LogoCb class="h-16 w-auto" aria-label="Logo, wersja czarno-biała" /></div>
        <div class="flex min-h-36 items-center bg-black p-8"><LogoCbNegatyw class="h-16 w-auto" aria-label="Logo, negatyw" /></div>
        <div class="flex min-h-24 items-center gap-8 border border-linia p-6"><LogoKompaktJasne class="h-10 w-auto" aria-label="Logo kompaktowe, wersja jasna" /></div>
        <div class="flex min-h-24 items-center gap-8 bg-grafit p-6"><LogoKompaktCiemne class="h-10 w-auto" aria-label="Logo kompaktowe, wersja ciemna" /></div>
      </div>
      <div class="mt-4 flex flex-wrap items-end gap-6 border border-linia p-6">
        <figure><Ikonka class="size-24" aria-label="Ikona" /><figcaption class="meta mt-2">Ikona</figcaption></figure>
        <figure><IkonkaCb class="size-24" aria-label="Ikona czarno-biała" /><figcaption class="meta mt-2">Ikona cz.-b.</figcaption></figure>
        <figure><IkonkaMala class="size-24" aria-label="Ikona mała" /><figcaption class="meta mt-2">Ikona mała (16 px)</figcaption></figure>
        <figure><img src={fav16} width="16" height="16" alt="Favicon 16 px" /><figcaption class="meta mt-2">16</figcaption></figure>
        <figure><img src={fav32} width="32" height="32" alt="Favicon 32 px" /><figcaption class="meta mt-2">32</figcaption></figure>
        <figure><img src={fav48} width="48" height="48" alt="Favicon 48 px" /><figcaption class="meta mt-2">48</figcaption></figure>
        <figure><img src={apple} width="90" height="90" alt="apple-touch-icon 180 px" class="border border-linia" /><figcaption class="meta mt-2">apple-touch 180</figcaption></figure>
        <figure><img src={awatar} width="120" height="120" alt="Awatar LinkedIn z marginesem na koło" class="rounded-full border border-linia" /><figcaption class="meta mt-2">Awatar (podgląd w kole)</figcaption></figure>
      </div>
      <figure class="mt-4 max-w-2xl">
        <img src={okladka} width="1200" height="630" alt="Domyślna okładka udostępnień: logo w wersji ciemnej, opis medium i adres rytmhali.pl" loading="lazy" class="h-auto w-full" />
        <figcaption class="meta mt-2">Domyślna okładka udostępnień 1200 × 630</figcaption>
      </figure>
    </section>

    {/* PRZYCISKI I POLA */}
    <section aria-labelledby="przyciski">
      <NaglowekSekcji tytul="Przyciski i pola" id="przyciski" />
      <div class="mt-6 grid gap-6 lg:grid-cols-2 [&>*]:min-w-0">
        <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Przyciski w stanach (tabela przewijana w bok)">
        <table class="w-full min-w-[28rem] text-left text-[0.875rem]">
          <caption class="sr-only">Przyciski w stanach</caption>
          <thead><tr class="border-b-2 border-grafit"><th scope="col" class="py-2">Wariant</th><th scope="col">Zwykły</th><th scope="col">Najechanie</th><th scope="col">Fokus</th><th scope="col">Wyłączony</th></tr></thead>
          <tbody>
            {[
              ['Główny', 'przycisk-glowny'],
              ['Grafitowy', 'przycisk-grafit'],
              ['Obrys', 'przycisk-obrys'],
            ].map(([nazwa, klasa]) => (
              <tr class="border-b border-linia">
                <th scope="row" class="py-3 font-semibold">{nazwa}</th>
                <td class="py-3 pr-2"><button type="button" class:list={['przycisk', klasa]}>Zapisz</button></td>
                <td class="pr-2"><button type="button" class:list={['przycisk stan-najazd', klasa]} tabindex="-1">Zapisz</button></td>
                <td class="pr-2"><button type="button" class:list={['przycisk stan-fokus', klasa]} tabindex="-1">Zapisz</button></td>
                <td><button type="button" class:list={['przycisk', klasa]} disabled>Zapisz</button></td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <div><label for="sg-pole-1" class="mb-1 block text-[0.875rem] font-semibold text-tekst">Zwykłe</label><input id="sg-pole-1" class="pole" placeholder="np. jan@firma.pl" /></div>
          <div><label for="sg-pole-2" class="mb-1 block text-[0.875rem] font-semibold text-tekst">Fokus</label><input id="sg-pole-2" class="pole stan-fokus" value="jan@firma.pl" tabindex="-1" /></div>
          <div><label for="sg-pole-3" class="mb-1 block text-[0.875rem] font-semibold text-tekst">Błąd</label><input id="sg-pole-3" class="pole" value="jan@firma" aria-invalid="true" aria-describedby="sg-pole-3-blad" /><p id="sg-pole-3-blad" class="mt-1 text-[0.8125rem] font-semibold text-blad">Wpisz pełny adres e-mail.</p></div>
          <p class="sm:col-span-3"><a href="#przyciski" class="link">Link w tekście</a> · <a href="#przyciski" class="link stan-najazd">po najechaniu</a> · <a href="#przyciski" class="link stan-fokus" tabindex="-1">z fokusem</a></p>
        </div>
      </div>
    </section>

    {/* POLE WYSZUKIWANIA */}
    <section aria-labelledby="wyszukiwanie">
      <NaglowekSekcji tytul="Pole wyszukiwania" id="wyszukiwanie" />
      <p class="mt-3 max-w-3xl text-[0.9375rem]">Jedno pole na ekranie: duże na stronie głównej, zwarte w nagłówku pozostałych stron. Wyniki pojawiają się pod polem w trakcie pisania (nazwa narzędzia i pytanie z FAQ, na które odpowiada); bez skryptu to zwykły formularz do /szukaj. Wpisz np. „nocki” albo „ile kg”.</p>
      <div class="mt-6 grid gap-8 lg:grid-cols-2">
        <Wyszukiwarka id="sg-szukaj-duze" />
        <Wyszukiwarka id="sg-szukaj-naglowek" wariant="naglowek" etykieta="Wariant nagłówka" placeholder="Szukaj, np. L4, urlop" limit={5} />
      </div>
    </section>

    {/* KARTY I WIERSZE */}
    <section aria-labelledby="karty">
      <NaglowekSekcji tytul="Karty i wiersze narzędzi" id="karty" />
      <p class="mt-3 max-w-3xl text-[0.9375rem]">Karta (wariant pełny i mały) i zwarty wiersz spisu /narzedzia: nazwa i jedno zdanie z rejestru. Wiersz skaluje się do kilkuset pozycji.</p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <KartaNarzedzia narzedzie={przyklady[0]} />
        <KartaNarzedzia narzedzie={przyklady[1]} />
        <div class="divide-y divide-linia border-t-2 border-grafit">
          {przyklady.map((n) => <KartaNarzedzia narzedzie={n} wariant="mala" />)}
        </div>
      </div>
      <ul class="mt-8 max-w-2xl">
        {przyklady.map((n) => (
          <li class="wiersz">
            <a href={adresNarzedzia(n.slug)} class="wiersz-link">
              <span class="kategoria block">{KATEGORIE[n.kategoria].krotko}</span>
              <span class="wiersz-nazwa">{n.nazwa}</span>
              <span class="wiersz-opis">{n.krotko}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* LISTY */}
    <section aria-labelledby="listy">
      <NaglowekSekcji tytul="Nagłówki sekcji i pytania" id="listy" />
      <div class="mt-6 grid gap-10 lg:grid-cols-2">
        <div class="space-y-6">
          <NaglowekSekcji tytul="Wynagrodzenie i zasiłki" link={{ nazwa: 'Wszystkie narzędzia', adres: '/narzedzia' }} poziom="h3" />
          <NaglowekSekcji tytul="Nagłówek bez linku" poziom="h3" />
          <NaglowekSekcji tytul="Bardzo długi nagłówek sekcji, który na telefonie przechodzi do drugiej linii" link={{ nazwa: 'Więcej', adres: '/narzedzia' }} poziom="h3" />
        </div>
        <div class="tresc">
          <Faq id="sg-faq" tytul="Pytania i odpowiedzi (przykład)" pytania={[
            { pytanie: 'Przykładowe pytanie: od kiedy liczy się termin?', odpowiedz: 'Odpowiedź fikcyjna do akceptacji wyglądu: termin liczy się od dnia następnego po zdarzeniu.' },
            { pytanie: 'Drugie pytanie z dłuższym brzmieniem, które na telefonie zawija się do drugiej linii?', odpowiedz: 'Odpowiedź fikcyjna. Pytania działają bez JavaScriptu, klawiaturą i czytnikiem ekranu.' },
          ]} />
        </div>
      </div>
    </section>

    {/* REKLAMY */}
    <section aria-labelledby="reklamy">
      <NaglowekSekcji tytul="Sloty reklamowe" id="reklamy" />
      <p class="mt-3 max-w-3xl text-[0.9375rem]">Miejsce zarezerwowane w wymiarach formatu, zawsze z podpisem „REKLAMA”. Trzy stany: pusty (tylko tutaj, do planowania), kampania z linkiem <code>rel="sponsored"</code> i UTM, autopromocja newslettera po końcu kampanii.</p>
      <h3 class="tytul-s mt-8">Formaty (stan pusty)</h3>
      <div class="mt-3 grid gap-8">
        <SlotReklamowy komputer="billboard" miejsce="sg-billboard" pusty />
        <SlotReklamowy komputer="baner" miejsce="sg-baner" pusty />
        <div class="flex min-w-0 flex-wrap items-start gap-8">
          <div class="w-[300px] max-w-full"><SlotReklamowy komputer="prostokat" telefon="mobilny-prostokat" miejsce="sg-prostokat" pusty /></div>
          <div class="w-[300px] max-w-full"><SlotReklamowy komputer="polstrona" miejsce="sg-polstrona" pusty /></div>
          <div class="w-[320px] max-w-full"><SlotReklamowy telefon="mobilny" miejsce="sg-mobilny" pusty /></div>
        </div>
      </div>
      <p class="meta mt-3">Na komputerze format „mobilny 320 × 100” jest ukryty; na telefonie ukryte są formaty komputerowe (billboard, baner, półstrona).</p>
      <h3 class="tytul-s mt-8">Kampania</h3>
      <div class="mt-3 grid gap-8">
        <SlotReklamowy komputer="billboard" telefon="mobilny" kampania={kampania} miejsce="sg-kampania" />
        <div class="flex min-w-0 flex-wrap items-start gap-8">
          <div class="w-[300px] max-w-full"><SlotReklamowy komputer="prostokat" telefon="mobilny-prostokat" kampania={kampaniaFormat('prostokat')} miejsce="sg-kampania-prostokat" /></div>
        </div>
      </div>
      <h3 class="tytul-s mt-8">Autopromocja (brak kampanii)</h3>
      <div class="mt-3 grid gap-8">
        <SlotReklamowy komputer="billboard" telefon="mobilny" miejsce="sg-auto-billboard" />
        <SlotReklamowy komputer="baner" telefon="mobilny-prostokat" miejsce="sg-auto-baner" />
        <div class="flex min-w-0 flex-wrap items-start gap-8">
          <div class="w-[300px] max-w-full"><SlotReklamowy komputer="prostokat" telefon="mobilny-prostokat" miejsce="sg-auto-prostokat" /></div>
          <div class="w-[300px] max-w-full"><SlotReklamowy komputer="polstrona" miejsce="sg-auto-polstrona" /></div>
        </div>
      </div>
    </section>

    {/* NEWSLETTER */}
    <section aria-labelledby="newsletter">
      <NaglowekSekcji tytul="Newsletter „Raport zmianowy”" id="newsletter" />
      <p class="mt-3 max-w-3xl text-[0.9375rem]">Formularz bez skryptu dostawcy. Zgoda jako osobne, niezaznaczone pole; pole-pułapka na boty. Wysyłka i potwierdzenie działają od F6.</p>
      <div class="mt-6">
        <Newsletter id="sg-nl-pasek" wariant="pasek" miejsce="sg-pasek" />
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <Newsletter id="sg-nl-ramka" miejsce="sg-ramka" />
        <Newsletter id="sg-nl-blad" stan="blad" miejsce="sg-blad" />
        <Newsletter id="sg-nl-sukces" stan="sukces" miejsce="sg-sukces" />
      </div>
    </section>

    {/* NAWIGACJA */}
    <section aria-labelledby="nawigacja">
      <NaglowekSekcji tytul="Okruszki" id="nawigacja" />
      <div class="mt-6 space-y-6">
        <Okruszki pozycje={[{ nazwa: 'Narzędzia', adres: '/narzedzia' }, { nazwa: 'Kalkulator L4: chorobowe i zasiłek' }]} />
      </div>
    </section>

    {/* TREŚĆ */}
    <section aria-labelledby="tresc-sg">
      <NaglowekSekcji tytul="Treść stron i wyjaśnień narzędzi" id="tresc-sg" />
      <div class="tresc mt-6">
        <p>Akapit treści w Noto Sans, 18 px, interlinia 1,75, do 70 znaków w linii. <a href="#tresc-sg">Link w treści</a> jest podkreślony i ma kolor akcentu w odcieniu do tekstu. <strong>Pogrubienie</strong> i <em>kursywa</em> mają własne kroje.</p>
        <h2>Śródtytuł drugiego poziomu</h2>
        <p>Śródtytuły mają kotwice, więc do sekcji „Jak liczymy” można linkować wprost.</p>
        <ul>
          <li>Lista punktowana z kwadratowym znacznikiem w kolorze akcentu.</li>
          <li>Druga pozycja listy, nieco dłuższa, żeby sprawdzić zawijanie do drugiej linii na telefonie.</li>
        </ul>
        <blockquote><p>Cytat wyróżniony: Display Bold z paskiem akcentu po lewej.</p></blockquote>
        <h3>Śródtytuł trzeciego poziomu</h3>
        <div class="tabela">
          <table>
            <caption class="sr-only">Przykładowa tabela stawek</caption>
            <thead><tr><th scope="col">Rok</th><th scope="col">Płaca minimalna</th><th scope="col">Stawka godzinowa</th><th scope="col">Źródło</th></tr></thead>
            <tbody>
              <tr><td>Przykład A</td><td>0000 zł</td><td>00,00 zł</td><td>Dziennik Ustaw (fikcyjny wiersz)</td></tr>
              <tr><td>Przykład B</td><td>0000 zł</td><td>00,00 zł</td><td>Dziennik Ustaw (fikcyjny wiersz)</td></tr>
            </tbody>
          </table>
        </div>
        <p>Tabela przewija się w bok na telefonie i jest wtedy osiągalna klawiaturą.</p>
      </div>
    </section>

    {/* BŁĄD */}
    <section aria-labelledby="blad">
      <NaglowekSekcji tytul="Strona błędu" id="blad" />
      <p class="mt-3 text-[0.9375rem]">Pełna strona: <a href="/404" class="link">/404</a>. Wariant 410 (strona usunięta na stałe) zwraca worker dla adresów z listy w <code>worker/usuniete.js</code>.</p>
      <div class="mt-4 border border-linia">
        <div class="pointer-events-none origin-top-left scale-[0.85]" inert>
          <StronaBledu kod={410} poziom="h3" />
        </div>
      </div>
    </section>
  </div>
</Uklad>

