---
// Temat: /temat/<slug> (hub wiedzy: teksty z wielu działów o jednym zagadnieniu). Noindex, dopóki temat ma mniej
// niż trzy teksty (cienka strona powielałaby artykuł; src/lib/mapa.mjs, PROGI).
import type { GetStaticPaths, Page } from 'astro';
import StronaListy from '../../../components/listy/StronaListy.astro';
import { TEMATY, dzial } from '../../../lib/dane';
import { artykuly, karta, type Artykul } from '../../../lib/tresci';
import { PROGI } from '../../../lib/mapa.mjs';
import { ADRES } from '../../../lib/srodowisko.mjs';
import { NA_STRONIE } from '../../../lib/stronicowanie';

export const getStaticPaths = (async ({ paginate }) => {
  const wszystkie = await artykuly();
  return TEMATY.flatMap((t) => {
    const oTemacie = wszystkie.filter((a) => a.data.tematy.some((x) => x.id === t.slug));
    return paginate(oTemacie, { params: { slug: t.slug }, pageSize: NA_STRONIE, props: { temat: t, liczba: oTemacie.length } });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Artykul>;
  temat: (typeof import('../../../lib/dane').TEMATY)[number];
  liczba: number;
}
const { page, temat, liczba } = Astro.props;
const dz = temat.dzial ? dzial(temat.dzial) : undefined;
const strona = page.currentPage > 1 ? ` (strona ${page.currentPage})` : '';
const opis = temat.opis || `Artykuły Rytmu Hali o temacie „${temat.nazwa}”: poradniki, analizy i wzory do pobrania z przypisami do źródeł.`;
const jsonLd = [{ '@type': 'CollectionPage', '@id': `${ADRES}${temat.adres}#strona`, name: temat.nazwa, description: opis, isPartOf: { '@id': `${ADRES}/#serwis` } }];
---
<StronaListy
  rodzaj="Temat"
  tytul={temat.nazwa}
  tytulStrony={`${temat.nazwa}${strona}: artykuły | Rytm Hali`}
  opis={`${opis}${strona}`}
  okruszki={[...(dz ? [{ nazwa: dz.nazwa, adres: dz.adres }] : []), { nazwa: temat.nazwa, adres: page.currentPage > 1 ? temat.adres : undefined }, ...(page.currentPage > 1 ? [{ nazwa: `Strona ${page.currentPage}` }] : [])]}
  bazowy={temat.adres}
  biezaca={page.currentPage}
  liczba={page.lastPage}
  artykuly={page.data.map(karta)}
  noindex={liczba < PROGI.temat}
  aktywnyTemat={temat.slug}
  jsonLd={jsonLd}
/>
