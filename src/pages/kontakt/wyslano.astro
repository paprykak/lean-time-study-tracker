---
// Strona techniczna formularza kontaktowego: worker (F6) przekierowuje tu po wysłaniu wiadomości. Noindex.
import Uklad from '../../layouts/Uklad.astro';
---
<Uklad tytul="Wiadomość wysłana | Rytm Hali" opis="Wiadomość do redakcji Rytmu Hali dotarła. Odpowiemy na adres e-mail podany w formularzu, zwykle w ciągu kilku dni roboczych." noindex>
  <section class="kontener py-12 md:py-20">
    <div class="max-w-2xl">
      <p class="kategoria">Kontakt</p>
      <h1 class="tytul-xl mt-3">Wiadomość wysłana</h1>
      <p class="lead mt-4">Dziękujemy. Wiadomość dotarła do redakcji, a odpowiedź wyślemy na adres podany w formularzu.</p>
      <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/" class="link inline-flex min-h-11 items-center">Strona główna</a>
        <a href="/kontakt" class="link inline-flex min-h-11 items-center">Wróć do kontaktu</a>
      </p>
    </div>
  </section>
</Uklad>
