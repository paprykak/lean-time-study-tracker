---
// Podgląd szablonu strony głównej (F3) z komponentów F1 i treści przykładowych. Noindex, poza mapą strony.
// Docelowo dobór treści: najnowsze, wyróżnione ręcznie w panelu, najczęściej czytane z Umami albo ręcznie.
import Uklad from '../../layouts/Uklad.astro';
import PasekTematow from '../../components/PasekTematow.astro';
import SlotReklamowy from '../../components/SlotReklamowy.astro';
import NaglowekSekcji from '../../components/NaglowekSekcji.astro';
import NajczesciejCzytane from '../../components/NajczesciejCzytane.astro';
import Newsletter from '../../components/Newsletter.astro';
import KartaGlowna from '../../components/karty/KartaGlowna.astro';
import KartaBoczna from '../../components/karty/KartaBoczna.astro';
import KartaSiatka from '../../components/karty/KartaSiatka.astro';
import KartaLista from '../../components/karty/KartaLista.astro';
import PodgladInfo from '../../components/PodgladInfo.astro';
import { GLOWNY, KOLUMNY, NAJCZESCIEJ_PODGLAD, NAJNOWSZE, OBOK_GLOWNEGO, SEKCJA_MAGAZYN, SEKCJA_PRODUKCJA } from '../../data/podglad';

const sekcje = [
  { id: 'sekcja-produkcja', tytul: 'Produkcja', adres: '/dzial/produkcja', ...SEKCJA_PRODUKCJA },
  { id: 'sekcja-magazyn', tytul: 'Magazyn i logistyka', adres: '/dzial/magazyn-i-logistyka', ...SEKCJA_MAGAZYN },
];
---
<Uklad tytul="Podgląd: strona główna | Rytm Hali" opis="Podgląd szablonu strony głównej Rytmu Hali z treściami przykładowymi (strona wewnętrzna)." noindex>
  <PasekTematow slot="pod-naglowkiem" />

  <h1 class="sr-only">Rytm Hali: niezależne medium o operacjach</h1>
  <div class="kontener">
    <PodgladInfo szablon="strony głównej" />

    <SlotReklamowy komputer="billboard" telefon="mobilny" miejsce="glowna-gora" class="mt-6" />

    {/* Czołówka: artykuł wiodący i trzy obok */}
    <section aria-label="Najważniejsze" class="mt-8 grid gap-6 lg:grid-cols-12">
      <KartaGlowna artykul={GLOWNY} priorytet class="lg:col-span-8" />
      <div class="grid content-start gap-4 lg:col-span-4 [&>article+article]:border-t [&>article+article]:border-linia [&>article+article]:pt-4">
        {OBOK_GLOWNEGO.map((x) => <KartaBoczna artykul={x} poziom="h2" />)}
      </div>
    </section>

    {/* Najnowsze */}
    <section aria-labelledby="najnowsze" class="mt-12">
      <NaglowekSekcji tytul="Najnowsze" id="najnowsze" />
      <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {NAJNOWSZE.map((x) => <KartaSiatka artykul={x} zLeadem szerokosc={290} />)}
      </div>
    </section>

    {/* Działy z kolumną boczną */}
    <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-6">
      <div class="space-y-12 lg:col-span-8">
        {sekcje.map((s) => (
          <section aria-labelledby={s.id}>
            <NaglowekSekcji tytul={s.tytul} id={s.id} link={{ nazwa: 'Więcej z działu', adres: s.adres }} />
            <div class="mt-4 grid gap-6 md:grid-cols-2">
              <KartaSiatka artykul={s.wiodacy} zLeadem szerokosc={400} />
              <div class="[&>article:first-child]:border-t-0 [&>article:first-child]:pt-0">
                {s.lista.map((x) => <KartaLista artykul={x} bezDzialu />)}
              </div>
            </div>
          </section>
        ))}
      </div>
      <aside class="space-y-10 lg:col-span-4" aria-label="Kolumna boczna">
        <NajczesciejCzytane artykuly={NAJCZESCIEJ_PODGLAD} />
        <div class="lg:sticky lg:top-6">
          <SlotReklamowy komputer="prostokat" telefon="mobilny-prostokat" miejsce="glowna-bok" />
        </div>
      </aside>
    </div>

    {/* Newsletter */}
    <div class="mt-14">
      <Newsletter id="glowna-newsletter" wariant="pasek" miejsce="glowna-pasek" />
    </div>

    {/* Kolumny działów */}
    <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-6">
      {KOLUMNY.map((k, i) => (
        <section aria-labelledby={`kolumna-${i}`}>
          <NaglowekSekcji tytul={k.dzial.nazwa} id={`kolumna-${i}`} link={{ nazwa: 'Więcej', adres: k.dzial.adres }} />
          <div class="mt-2 [&>article:first-child]:border-t-0">
            {k.lista.map((x) => <KartaLista artykul={x} bezDzialu />)}
          </div>
        </section>
      ))}
    </div>
  </div>
</Uklad>
