---
// Artykuł: /<slug> z kolekcji „artykuly” (src/content/artykuly/<slug>.md, edycja w panelu /admin). Adres bez działu,
// więc zmiana działu nie zmienia adresu. Dane strukturalne Article (magazyn, nie serwis wiadomości), okładka udostępnień
// z buildu (/okladki/<slug>.jpg), powiązane w obie strony, reklama w treści po 3. akapicie tylko na komputerze.
// Szkice i wpisy testowe istnieją tylko w podglądzie gałęzi (wszystko z noindex); na produkcji ich nie ma.
import { getEntries, getEntry, render } from 'astro:content';
import Uklad from '../layouts/Uklad.astro';
import Okruszki from '../components/Okruszki.astro';
import SlotReklamowy from '../components/SlotReklamowy.astro';
import NaglowekSekcji from '../components/NaglowekSekcji.astro';
import NajczesciejCzytane from '../components/NajczesciejCzytane.astro';
import Newsletter from '../components/Newsletter.astro';
import RamkaAutora from '../components/RamkaAutora.astro';
import Udostepnij from '../components/Udostepnij.astro';
import PasekTematow from '../components/PasekTematow.astro';
import KartaSiatka from '../components/karty/KartaSiatka.astro';
import NaglowekArtykulu from '../components/artykul/NaglowekArtykulu.astro';
import TrescArtykulu from '../components/artykul/TrescArtykulu.astro';
import SpisTresci from '../components/artykul/SpisTresci.astro';
import RamkaDoPobrania from '../components/artykul/RamkaDoPobrania.astro';
import Faq from '../components/artykul/Faq.astro';
import Zrodla from '../components/artykul/Zrodla.astro';
import MetodaArtykulu from '../components/artykul/MetodaArtykulu.astro';
import Tematy from '../components/artykul/Tematy.astro';
import { artykuly, doIndeksu, karta, minutyCzytania, powiazaneArtykuly, type Artykul } from '../lib/tresci';
import { dzial, temat } from '../lib/dane';
import { zdjecie } from '../lib/zdjecia';
import { liczSlowa, odmiana, opisStrony, tytulStrony, widoczny } from '../lib/redakcja';
import { ADRES, PODGLAD } from '../lib/srodowisko.mjs';

export async function getStaticPaths() {
  const wszystkie = await artykuly();
  return wszystkie.map((artykul) => ({ params: { slug: artykul.id }, props: { artykul, wszystkie } }));
}

interface Props {
  artykul: Artykul;
  wszystkie: Artykul[];
}
const { artykul, wszystkie } = Astro.props;
const d = artykul.data;
const { Content, headings } = await render(artykul);

const dz = dzial(d.dzial.id);
const tematy = d.tematy.map((t) => temat(t.id));
const autorzy = await getEntries(d.autorzy);
const partner = d.partner ? await getEntry(d.partner.partner) : undefined;
const materialy = (await getEntries(d.materialy)).filter((m) => widoczny(m.data, PODGLAD));
const zdjecieGlowne = zdjecie(d.zdjecie.id, d.podpisZdjecia);
const minuty = minutyCzytania(artykul);
const adresKanoniczny = `${ADRES}/${artykul.id}`;
const okladka = `/okladki/${artykul.id}.jpg`;
const indeksowany = doIndeksu(artykul);

// Spis treści przy dłuższych tekstach: co najmniej 3 śródtytuły drugiego poziomu (FAQ liczy się jako jeden).
const FAQ_ID = 'pytania';
const spis = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, tytul: h.text })),
  ...(d.faq.length ? [{ id: FAQ_ID, tytul: 'Pytania i odpowiedzi' }] : []),
];

// „Czytaj także” (wskazane ręcznie, wskazujące ten tekst, wspólne tematy, dział) i „Więcej z działu” bez powtórzeń.
const powiazane = powiazaneArtykuly(artykul, wszystkie, 3);
const zDzialu = wszystkie.filter((a) => a.id !== artykul.id && a.data.dzial.id === dz.slug && !powiazane.includes(a)).slice(0, 3);
const najnowsze = wszystkie.filter((a) => a.id !== artykul.id).slice(0, 5);

const autorJsonLd = (a: (typeof autorzy)[number]) =>
  a.data.typ === 'Redakcja'
    ? { '@id': `${ADRES}/#redakcja` }
    : {
        '@type': 'Person',
        '@id': `${ADRES}/autor/${a.id}#osoba`,
        name: a.data.imie,
        url: `${ADRES}/autor/${a.id}`,
        jobTitle: a.data.rola,
        ...(a.data.sameAs.length ? { sameAs: a.data.sameAs } : {}),
      };
const jsonLd = [
  {
    '@type': 'Article',
    '@id': `${adresKanoniczny}#artykul`,
    mainEntityOfPage: adresKanoniczny,
    headline: d.tytul,
    description: opisStrony(d),
    image: [`${ADRES}${okladka}`],
    datePublished: d.opublikowano.toISOString(),
    dateModified: (d.zaktualizowano ?? d.opublikowano).toISOString(),
    inLanguage: 'pl-PL',
    articleSection: dz.nazwa,
    genre: d.format,
    ...(tematy.length ? { keywords: tematy.map((t) => t.nazwa).join(', ') } : {}),
    wordCount: liczSlowa(artykul.body ?? ''),
    timeRequired: `PT${minuty}M`,
    isAccessibleForFree: true,
    author: autorzy.map(autorJsonLd),
    publisher: { '@id': `${ADRES}/#redakcja` },
    isPartOf: { '@id': `${ADRES}/#serwis` },
    ...(d.zrodla.length ? { citation: d.zrodla.map((z) => ({ '@type': 'CreativeWork', name: z.opis, ...(z.adres ? { url: z.adres } : {}) })) } : {}),
    ...(partner ? { sponsor: { '@type': 'Organization', name: partner.data.nazwa, url: partner.data.adres } } : {}),
  },
];
const linkedin = (sameAs: string[]) => sameAs.find((u) => /linkedin\.com/.test(u));
const formatMaterialu = (m: (typeof materialy)[number]) =>
  [m.data.format, m.data.strony ? odmiana(m.data.strony, ['strona', 'strony', 'stron']) : undefined].filter(Boolean).join(', ');
---
<Uklad tytul={tytulStrony(d)} opis={opisStrony(d)} obraz={okladka} typ="article" noindex={!indeksowany} jsonLd={jsonLd} aktywny={dz.slug}>
  <PasekTematow slot="pod-naglowkiem" aktywny={tematy[0]?.slug} />
  <div class="kontener">
    <Okruszki class="mt-4" pozycje={[{ nazwa: dz.nazwa, adres: dz.adres }, { nazwa: d.tytul }]} />

    <div class="mt-2 grid gap-10 lg:grid-cols-12 lg:gap-6">
      <article class="min-w-0 lg:col-span-8">
        <NaglowekArtykulu
          tytul={d.tytul}
          lead={d.lead}
          kategoria={{ nazwa: dz.nazwa, adres: dz.adres }}
          format={d.format}
          data={d.opublikowano}
          aktualizacja={d.zaktualizowano}
          autorzy={autorzy.map((a) => ({ nazwa: a.data.imie, adres: `/autor/${a.id}` }))}
          czasCzytania={minuty}
          adresKanoniczny={adresKanoniczny}
          zdjecie={zdjecieGlowne}
          partner={partner?.data.nazwa}
          oznaczenie={d.partner?.oznaczenie}
        />

        <div class="tresc mt-8">
          {spis.length >= 3 && <SpisTresci pozycje={spis} />}
          <TrescArtykulu>
            <Content />
            {!partner && <SlotReklamowy slot="reklama" komputer="baner" miejsce="artykul-tresc" class="slot-w-tresci" />}
          </TrescArtykulu>

          {materialy.map((m) => (
            <RamkaDoPobrania tytul={m.data.tytul} opis={m.data.opis} format={formatMaterialu(m)} adres={`/do-pobrania/${m.id}`} slug={m.id} />
          ))}
          {d.faq.length > 0 && <Faq id={FAQ_ID} pytania={d.faq} />}
          <MetodaArtykulu metoda={d.metoda} sprawdzono={d.sprawdzono} zrodla={d.zrodla} />
          {d.zrodla.length > 0 && <Zrodla zrodla={d.zrodla} />}
        </div>

        <div class="mt-10 space-y-8">
          {tematy.length > 0 && <Tematy tematy={tematy.map((t) => ({ nazwa: t.nazwa, adres: t.adres }))} />}
          <Udostepnij adres={adresKanoniczny} tytul={d.tytul} wariant="dol" />
          {autorzy.map((a) => (
            <RamkaAutora
              imie={a.data.imie}
              rola={a.data.rola}
              bio={a.data.bio}
              adres={`/autor/${a.id}`}
              zdjecie={a.data.zdjecie}
              linkedin={linkedin(a.data.sameAs)}
              email={a.data.email}
            />
          ))}
        </div>
      </article>

      <aside class="space-y-10 lg:col-span-4" aria-label="Kolumna boczna">
        {!partner && (
          <div class="hidden lg:block">
            <SlotReklamowy komputer="polstrona" miejsce="artykul-bok" />
          </div>
        )}
        {najnowsze.length > 0 && <NajczesciejCzytane tytul="Najnowsze" artykuly={najnowsze.map((a) => ({ tytul: a.data.tytul, adres: `/${a.id}` }))} />}
        <div class="lg:sticky lg:top-6">
          <Newsletter id="artykul-newsletter" miejsce="artykul-bok" />
        </div>
      </aside>
    </div>

    {powiazane.length > 0 && (
      <section aria-labelledby="czytaj-takze" class="mt-14">
        <NaglowekSekcji tytul="Czytaj także" id="czytaj-takze" />
        <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {powiazane.map((a) => <KartaSiatka artykul={karta(a)} zLeadem szerokosc={400} />)}
        </div>
      </section>
    )}
    {zDzialu.length > 0 && (
      <section aria-labelledby="wiecej-z-dzialu" class="mt-14">
        <NaglowekSekcji tytul={`Więcej z działu ${dz.nazwa}`} id="wiecej-z-dzialu" link={{ nazwa: 'Wszystkie', adres: dz.adres }} />
        <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {zDzialu.map((a) => <KartaSiatka artykul={karta(a)} szerokosc={400} />)}
        </div>
      </section>
    )}
  </div>
</Uklad>

<style>
  /* Reklama w treści: tylko na komputerze (komponent ukrywa ją na telefonie), z odstępem jak akapit. */
  .tresc :global(.slot-w-tresci) {
    margin-block: 2rem;
  }
</style>
