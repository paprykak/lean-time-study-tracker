---
// Dział: /dzial/<slug>, dalsze strony /dzial/<slug>/2. Opis, tematy działu, reklama u góry pierwszej strony,
// kanał RSS działu. Noindex, dopóki dział nie ma tekstu (src/lib/mapa.mjs, PROGI).
import type { GetStaticPaths, Page } from 'astro';
import StronaListy from '../../../components/listy/StronaListy.astro';
import { DZIALY, TEMATY } from '../../../lib/dane';
import { artykuly, karta, type Artykul } from '../../../lib/tresci';
import { PROGI } from '../../../lib/mapa.mjs';
import { ADRES } from '../../../lib/srodowisko.mjs';
import { NA_STRONIE } from '../../../lib/stronicowanie';

export const getStaticPaths = (async ({ paginate }) => {
  const wszystkie = await artykuly();
  return DZIALY.flatMap((d) => {
    const zDzialu = wszystkie.filter((a) => a.data.dzial.id === d.slug);
    return paginate(zDzialu, { params: { slug: d.slug }, pageSize: NA_STRONIE, props: { dzial: d, liczba: zDzialu.length } });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Artykul>;
  dzial: (typeof DZIALY)[number];
  liczba: number;
}
const { page, dzial, liczba } = Astro.props;
const tematy = TEMATY.filter((t) => t.dzial === dzial.slug);
const strona = page.currentPage > 1 ? ` (strona ${page.currentPage})` : '';
const tytulStrony = `${dzial.tytulSeo ?? dzial.nazwa}${strona} | Rytm Hali`;
const jsonLd = [
  { '@type': 'CollectionPage', '@id': `${ADRES}${dzial.adres}#strona`, name: dzial.nazwa, description: dzial.opis, isPartOf: { '@id': `${ADRES}/#serwis` } },
];
---
<StronaListy
  rodzaj="Dział"
  tytul={dzial.nazwa}
  tytulStrony={tytulStrony}
  opis={`${dzial.opisSeo ?? dzial.opis}${strona}`}
  wstep={dzial.opis}
  okruszki={[{ nazwa: dzial.nazwa, adres: page.currentPage > 1 ? dzial.adres : undefined }, ...(page.currentPage > 1 ? [{ nazwa: `Strona ${page.currentPage}` }] : [])]}
  bazowy={dzial.adres}
  biezaca={page.currentPage}
  liczba={page.lastPage}
  artykuly={page.data.map(karta)}
  noindex={liczba < PROGI.dzial}
  aktywny={dzial.slug}
  rss={`${dzial.adres}/rss.xml`}
  jsonLd={jsonLd}
  reklama="dzial-gora"
>
  {tematy.length > 0 && page.currentPage === 1 && (
    <ul slot="naglowek" class="mt-4 flex flex-wrap gap-2" aria-label="Tematy w dziale">
      {tematy.map((t) => <li><a href={t.adres} class="przycisk przycisk-obrys">{t.nazwa}</a></li>)}
    </ul>
  )}
</StronaListy>
