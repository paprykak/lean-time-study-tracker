---
// Materiał do pobrania: /do-pobrania/<slug>. Opis, podglądy stron, przycisk pobrania (zdarzenie statystyk),
// treść z instrukcją, artykuły, które z niego korzystają. Dane strukturalne DigitalDocument.
import { getCollection, render } from 'astro:content';
import Uklad from '../../layouts/Uklad.astro';
import Okruszki from '../../components/Okruszki.astro';
import PasekTematow from '../../components/PasekTematow.astro';
import Zdjecie from '../../components/Zdjecie.astro';
import Ikona from '../../components/Ikona.astro';
import KartaSiatka from '../../components/karty/KartaSiatka.astro';
import NaglowekSekcji from '../../components/NaglowekSekcji.astro';
import { dzial } from '../../lib/dane';
import { odmiana, widoczny } from '../../lib/redakcja';
import { artykuly, karta } from '../../lib/tresci';
import { ADRES, PODGLAD, TESTOWE, WSZYSTKIE_TRESCI } from '../../lib/srodowisko.mjs';
import { dataDluga, datetime } from '../../lib/daty';
import Tekst from '../../components/Tekst.astro';

export async function getStaticPaths() {
  const materialy = await getCollection('materialy', ({ data }) => widoczny(data, WSZYSTKIE_TRESCI));
  return materialy.map((m) => ({ params: { slug: m.id }, props: { material: m } }));
}
type Material = Awaited<ReturnType<typeof getCollection<'materialy'>>>[number];
const { material } = Astro.props as { material: Material };
const m = material.data;
const { Content } = await render(material);
const dz = dzial(m.dzial.id);
const adres = `/do-pobrania/${material.id}`;
const wArtykulach = (await artykuly()).filter((a) => a.data.materialy.some((x) => x.id === material.id));
const opisFormatu = [m.format, m.strony ? odmiana(m.strony, ['strona', 'strony', 'stron']) : undefined].filter(Boolean).join(', ');
const indeksowany = TESTOWE || (!m.szkic && !m.testowy);
const jsonLd = [
  {
    '@type': 'DigitalDocument',
    '@id': `${ADRES}${adres}#dokument`,
    name: m.tytul,
    description: m.opis,
    url: `${ADRES}${adres}`,
    encodingFormat: { PDF: 'application/pdf', XLSX: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', DOCX: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', ZIP: 'application/zip' }[m.format],
    contentUrl: `${ADRES}${m.plik}`,
    datePublished: m.opublikowano.toISOString(),
    dateModified: (m.zaktualizowano ?? m.opublikowano).toISOString(),
    inLanguage: 'pl-PL',
    isAccessibleForFree: true,
    publisher: { '@id': `${ADRES}/#redakcja` },
  },
];
---
<Uklad tytul={`${m.tytul} (${m.format}, do pobrania) | Rytm Hali`} opis={m.opis} noindex={!indeksowany || PODGLAD} aktywny="/do-pobrania" jsonLd={jsonLd}>
  <PasekTematow slot="pod-naglowkiem" />
  <div class="kontener">
    <Okruszki class="mt-4" pozycje={[{ nazwa: 'Do pobrania', adres: '/do-pobrania' }, { nazwa: m.tytul }]} />
    <div class="mt-4 grid gap-10 lg:grid-cols-12 lg:gap-6">
      <article class="min-w-0 lg:col-span-8" data-pagefind-body>
        <span hidden data-pagefind-ignore data-pagefind-meta="rodzaj">Do pobrania</span>
        <p class="kategoria" data-pagefind-ignore><a href={dz.adres} class="najazd:underline">{dz.nazwa}</a> <span class="text-tekst-drugi">· Do pobrania</span></p>
        <h1 class="tytul-xl mt-2"><Tekst t={m.tytul} /></h1>
        <p class="lead mt-3"><Tekst t={m.opis} /></p>
        <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-linia py-4" data-pagefind-ignore>
          <a href={m.plik} download class="przycisk przycisk-glowny no-underline" data-umami-event="Pobranie" data-umami-event-material={material.id}><Ikona nazwa="pobierz" rozmiar={18} />Pobierz bezpłatnie</a>
          <span class="meta">{opisFormatu} · aktualizacja <time datetime={datetime(m.zaktualizowano ?? m.opublikowano)}>{dataDluga(m.zaktualizowano ?? m.opublikowano)}</time></span>
        </p>
        {m.podglady.length > 0 && (
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {m.podglady.map((p, i) => <Zdjecie zdjecie={{ src: p, alt: `Podgląd strony ${i + 1}: ${m.tytul}`, fot: '' }} proporcja="16-10" szerokosc={400} sizes="(min-width: 1024px) 400px, 100vw" />)}
          </div>
        )}
        <div class="tresc mt-8"><Content /></div>
      </article>
    </div>
    {wArtykulach.length > 0 && (
      <section aria-labelledby="w-artykulach" class="mt-14">
        <NaglowekSekcji tytul="Artykuły z tym materiałem" id="w-artykulach" />
        <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {wArtykulach.slice(0, 3).map((a) => <KartaSiatka artykul={karta(a)} zLeadem szerokosc={400} />)}
        </div>
      </section>
    )}
  </div>
</Uklad>
