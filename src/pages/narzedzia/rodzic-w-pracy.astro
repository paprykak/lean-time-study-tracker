---
// Rodzic w pracy: uprawnienia według wieku dziecka i terminy wniosków (art. 67^19 § 6, 178 § 2, 182^1c, 182^1d, 182^3,
// 186, 186^7, 188, 188^1 Kp). Logika: src/lib/narzedzia/rodzic.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { opisUprawnienia, planRodzica } from '../../lib/narzedzia/rodzic';
import { dodajDni, dodajLata, dzisWPolsce } from '../../lib/narzedzia/terminy';
import { typografia } from '../../lib/typografia.mjs';

const dzis = dzisWPolsce();
const D = { urodzenie: dodajLata(dzis, -2), start: dodajDni(dzis, 30) };
const plan = planRodzica(D.urodzenie, D.start);
const dostepne = plan.filter((u) => u.dostepne).length;

const faq = [
  {
    pytanie: 'Do kiedy można wziąć urlop rodzicielski?',
    odpowiedz: 'Najpóźniej do końca roku kalendarzowego, w którym dziecko kończy 6 lat, jednorazowo albo w najwyżej 5 częściach (art. 182^1c Kodeksu pracy). Wniosek składa się co najmniej 21 dni przed początkiem urlopu, a pracodawca musi go uwzględnić (art. 182^1d § 1).',
  },
  {
    pytanie: 'Czy pracodawca musi zgodzić się na pracę zdalną rodzica?',
    odpowiedz: 'Przy dziecku do 4 lat pracodawca musi uwzględnić wniosek o pracę zdalną, chyba że nie pozwala na to organizacja albo rodzaj pracy. O przyczynie odmowy informuje na piśmie albo elektronicznie w ciągu 7 dni roboczych od złożenia wniosku (art. 67^19 § 6 Kodeksu pracy). Na hali przy pracy przy maszynie odmowa z powodu rodzaju pracy jest więc możliwa.',
  },
  {
    pytanie: 'Co to jest elastyczna organizacja pracy?',
    odpowiedz: 'Rodzic dziecka do 8 lat może wnioskować o pracę zdalną, inny system albo rozkład czasu pracy, na przykład ruchome godziny, albo o niższy etat. Wniosek składa się co najmniej 21 dni przed, a pracodawca w ciągu 7 dni informuje o zgodzie, przyczynie odmowy albo innym możliwym terminie (art. 188^1 Kodeksu pracy).',
  },
  {
    pytanie: 'Czy rodzic małego dziecka musi zostawać po godzinach?',
    odpowiedz: 'Nie musi. Pracownika wychowującego dziecko do 8 lat nie wolno bez jego zgody zatrudniać w nadgodzinach, w porze nocnej, w przerywanym czasie pracy ani delegować poza stałe miejsce pracy (art. 178 § 2 Kodeksu pracy).',
  },
  {
    pytanie: 'Czy zamiast urlopu wychowawczego mogę pracować na pół etatu?',
    odpowiedz: 'Tak. Pracownik uprawniony do urlopu wychowawczego może złożyć wniosek o obniżenie wymiaru czasu pracy, nie niżej niż do połowy etatu, a pracodawca musi go uwzględnić. Wniosek składa się 21 dni przed (art. 186^7 § 1–2 Kodeksu pracy). Pracodawca nie może wtedy wypowiedzieć ani rozwiązać umowy do powrotu do pełnego etatu, najwyżej przez łącznie 12 miesięcy, poza upadłością, likwidacją i winą pracownika (art. 186^8 § 1–2).',
  },
];
---
<StronaNarzedzia
  slug="rodzic-w-pracy"
  tytul="Rodzic w pracy: uprawnienia i terminy wniosków"
  opis="Do kiedy urlop ojcowski, rodzicielski i wychowawczy, praca zdalna przy dziecku do 4 lat, elastyczny czas do 8 lat, wolne do 14 lat, kiedy złożyć wniosek."
  h1="Rodzic w pracy: uprawnienia według wieku dziecka"
  lead="Wpisz datę urodzenia dziecka i dzień, od którego chcesz skorzystać z uprawnienia, a pokażemy, co Ci przysługuje, do kiedy i do kiedy złożyć wniosek."
  faq={faq}
>
  <form class="kalkulator" data-rodzic novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Dziecko i plan</h2>
      <div class="mt-4 grid grid-cols-2 items-end gap-3">
        <div>
          <label for="r-urodzenie" class="etykieta-pola">Urodzenie dziecka</label>
          <input id="r-urodzenie" name="urodzenie" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" value={D.urodzenie} aria-describedby="r-blad" />
        </div>
        <div>
          <label for="r-start" class="etykieta-pola">Chcę zacząć od</label>
          <input id="r-start" name="start" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" value={D.start} data-dzis="30" aria-describedby="r-blad" />
        </div>
      </div>
      <p id="r-blad" class="blad-pola mt-3" data-blad="dane" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Przysługuje Ci w tym dniu</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-data" data-w="ile">{dostepne} z {plan.length} uprawnień</p>
      </div>
      <ul class="lista-uprawnien mt-3" data-w="lista">
        {plan.map((u) => (
          <li data-dostepne={u.dostepne ? 'tak' : 'nie'}>
            <strong>{typografia(u.nazwa)}</strong>: {typografia(opisUprawnienia(u, D.start))}
          </li>
        ))}
      </ul>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Zasady są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="tabela">Uprawnienia rodzica według wieku dziecka</h2>
    <div class="tabela">
      <table>
        <caption class="sr-only">Uprawnienia pracownika rodzica, do kiedy przysługują i termin wniosku</caption>
        <thead><tr><th scope="col">Uprawnienie</th><th scope="col">Do kiedy</th><th scope="col">Wniosek</th></tr></thead>
        <tbody>
          <tr><th scope="row">Urlop ojcowski, 2 tygodnie (art. 182<sup>3</sup>)</th><td>do 1. urodzin</td><td>7 dni przed</td></tr>
          <tr><th scope="row">Urlop rodzicielski (art. 182<sup>1</sup>c)</th><td>do końca roku 6. urodzin</td><td>21 dni przed</td></tr>
          <tr><th scope="row">Urlop wychowawczy (art. 186)</th><td>do końca roku 6. urodzin</td><td>21 dni przed</td></tr>
          <tr><th scope="row">Niższy etat zamiast wychowawczego (art. 186<sup>7</sup>)</th><td>do końca roku 6. urodzin</td><td>21 dni przed</td></tr>
          <tr><th scope="row">Praca zdalna na wniosek (art. 67<sup>19</sup> § 6)</th><td>do 4. urodzin</td><td>odmowa w 7 dni roboczych</td></tr>
          <tr><th scope="row">Elastyczna organizacja pracy (art. 188<sup>1</sup>)</th><td>do 8. urodzin</td><td>21 dni przed, odpowiedź w 7 dni</td></tr>
          <tr><th scope="row">Nadgodziny, noc, delegacja tylko za zgodą (art. 178 § 2)</th><td>do 8. urodzin</td><td>nie trzeba</td></tr>
          <tr><th scope="row">2 dni albo 16 godzin wolnego w roku (art. 188)</th><td>do 14 lat</td><td>według zasad w zakładzie</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Wiek dziecka kończy się z początkiem dnia urodzin (art. 112 Kodeksu cywilnego), więc uprawnienie „do ukończenia
      8 lat” trwa do dnia przed 8. urodzinami. Przy wolnym na dziecko przepis mówi „w wieku do 14 lat”; przyjmujemy dzień
      przed 14. urodzinami. Urlop ojcowski musi się skończyć przed 1. urodzinami, a każda jego część trwa co najmniej
      tydzień (art. 182<sup>3</sup> § 1<sup>1</sup>), więc podajemy ostatni dzień rozpoczęcia tygodnia i całych 2 tygodni. Ostatni dzień na wniosek to dzień początku minus 7 albo 21 dni. Urlop wychowawczy przysługuje
      po 6 miesiącach zatrudnienia, wliczając poprzednie umowy (art. 186 § 1). Ile i do kiedy, policzą <a href="/narzedzia/urlop-ojcowski">kalkulator urlopu ojcowskiego</a>, <a href="/narzedzia/zasilek-macierzynski">kalkulator urlopu macierzyńskiego i rodzicielskiego</a>, <a href="/narzedzia/urlop-wychowawczy">kalkulator urlopu wychowawczego</a> i <a href="/narzedzia/wolne-na-dziecko">kalkulator wolnego na dziecko</a>.
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { opisUprawnienia, planRodzica } from '../../lib/narzedzia/rodzic';
  import { poprawnaData } from '../../lib/narzedzia/terminy';
  import { ustawDzisiejszeWartosci } from '../../lib/narzedzia/dzis-w-formularzu';
  import { typografia } from '../../lib/typografia.mjs';

  const form = document.querySelector<HTMLFormElement>('[data-rodzic]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const przelicz = () => {
      const urodzenie = el('urodzenie').value;
      const start = el('start').value;
      let blad: string | null = null;
      if (!poprawnaData(urodzenie) || !poprawnaData(start)) blad = 'Wpisz datę urodzenia dziecka i dzień początku.';
      else if (start < urodzenie) blad = 'Dzień początku nie może być przed urodzeniem dziecka.';
      const b = form.querySelector<HTMLElement>('[data-blad="dane"]')!;
      b.hidden = !blad;
      b.textContent = blad ?? '';
      if (blad) {
        w('ile').textContent = '—';
        return;
      }
      const plan = planRodzica(urodzenie, start);
      w('ile').textContent = typografia(`${plan.filter((u) => u.dostepne).length} z ${plan.length} uprawnień`);
      w('lista').replaceChildren(
        ...plan.map((u) => {
          const li = document.createElement('li');
          li.dataset.dostepne = u.dostepne ? 'tak' : 'nie';
          const s = document.createElement('strong');
          s.textContent = typografia(u.nazwa);
          const reszta = `: ${opisUprawnienia(u, start)}`;
          li.append(s, document.createTextNode(typografia(reszta)));
          return li;
        }),
      );
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    ustawDzisiejszeWartosci(form);
    przelicz();
  }
</script>

<style>
  .lista-uprawnien {
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    list-style: disc;
    padding-left: 1.25rem;
  }
  .lista-uprawnien li[data-dostepne='nie'] {
    color: var(--color-tekst-drugi);
  }
</style>
