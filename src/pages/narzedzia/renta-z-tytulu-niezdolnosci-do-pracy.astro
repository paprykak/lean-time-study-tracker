---
// Renta z tytułu niezdolności do pracy: warunki stażu i okresu powstania niezdolności (art. 5, 12, 57–60 ustawy
// o emeryturach i rentach z FUS, Dz.U. 2025 poz. 1749; art. 17–18 ustawy wypadkowej, Dz.U. 2025 poz. 1644).
// Logika i teksty wyniku: src/lib/narzedzia/renta-niezdolnosc.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { opisRenty } from '../../lib/narzedzia/renta-niezdolnosc';
import { dzisWPolsce } from '../../lib/narzedzia/terminy';

const dzis = dzisWPolsce();
const URODZENIE = '1985-04-10';
const start = opisRenty({ plec: 'm', urodzenie: URODZENIE, powstanie: dzis, przyczyna: 'choroba', stopien: 'czesciowa', skladkowe: 6, nieskladkowe: 1, ostatnie10: 6, ubezpieczenie: 'w-trakcie', dzis });

const faq = [
  {
    pytanie: 'Ile lat pracy potrzeba do renty?',
    odpowiedz: 'Zależy od wieku, w którym powstała niezdolność do pracy: 1 rok przed ukończeniem 20 lat, 2 lata w wieku powyżej 20 do 22 lat, 3 lata powyżej 22 do 25 lat, 4 lata powyżej 25 do 30 lat i 5 lat powyżej 30 lat (art. 58 ust. 1 ustawy o emeryturach i rentach z FUS). Liczą się okresy składkowe i nieskładkowe, a nieskładkowe najwyżej w jednej trzeciej okresów składkowych (art. 5 ust. 2). Staż uważa się też za spełniony przy zgłoszeniu do ubezpieczenia przed 18. urodzinami albo do 6 miesięcy po szkole i okresach bez przerw dłuższych niż 6 miesięcy (art. 58 ust. 3).',
  },
  {
    pytanie: 'Co znaczy 5 lat w ostatnich 10 latach?',
    odpowiedz: 'Przy niezdolności powstałej w wieku powyżej 30 lat 5 lat okresów składkowych i nieskładkowych musi przypadać w ciągu 10 lat przed złożeniem wniosku o rentę albo przed dniem powstania niezdolności (art. 58 ust. 2). Nie dotyczy to osoby całkowicie niezdolnej do pracy, która ma co najmniej 25 lat (kobieta) albo 30 lat (mężczyzna) okresów składkowych, bez nieskładkowych (art. 58 ust. 4).',
  },
  {
    pytanie: 'Czy dostanę rentę, jeśli zachoruję po zwolnieniu z pracy?',
    odpowiedz: 'Możesz, jeśli niezdolność do pracy powstała najpóźniej 18 miesięcy po końcu ubezpieczenia albo innego okresu z art. 57 ust. 1 pkt 3 (na przykład zasiłku chorobowego lub świadczenia rehabilitacyjnego) i spełniasz pozostałe warunki: staż i brak prawa do emerytury. Później tylko przy całkowitej niezdolności do pracy i stażu co najmniej 20 lat (kobieta) albo 25 lat (mężczyzna) (art. 57 ust. 2). Po wypadku przy pracy albo przy chorobie zawodowej ten termin nie obowiązuje (art. 17 ust. 2 ustawy wypadkowej).',
  },
  {
    pytanie: 'Czy po wypadku przy pracy potrzebny jest staż?',
    odpowiedz: 'Nie. Renta z tytułu niezdolności do pracy spowodowanej wypadkiem przy pracy albo chorobą zawodową przysługuje bez względu na długość ubezpieczenia wypadkowego i datę powstania niezdolności (art. 17 ust. 2 ustawy wypadkowej). Przy wypadku w drodze do pracy lub z pracy nie jest wymagany tylko staż (art. 57a ustawy o FUS): niezdolność musi powstać w czasie ubezpieczenia albo do 18 miesięcy po nim, a renta nie przysługuje osobie z prawem do emerytury.',
  },
  {
    pytanie: 'Czym różni się całkowita i częściowa niezdolność do pracy?',
    odpowiedz: 'Całkowicie niezdolna do pracy jest osoba, która utraciła zdolność do wykonywania jakiejkolwiek pracy, a częściowo niezdolna osoba, która w znacznym stopniu utraciła zdolność do pracy zgodnej z poziomem swoich kwalifikacji (art. 12 ust. 2–3). Orzeka o tym lekarz orzecznik ZUS, zwykle na najwyżej 5 lat, a dłużej, gdy nie ma rokowań odzyskania zdolności do pracy przed upływem tego okresu (art. 13 ust. 2–3). Gdy po co najmniej 5 latach renty do wieku emerytalnego brakuje mniej niż 5 lat, niezdolność orzeka się do dnia osiągnięcia tego wieku (art. 13 ust. 3a).',
  },
];
---
<StronaNarzedzia
  slug="renta-z-tytulu-niezdolnosci-do-pracy"
  tytul="Renta z tytułu niezdolności do pracy: warunki"
  opis="Czy masz staż do renty: 1–5 lat zależnie od wieku, 5 lat w ostatnich 10 latach, do 18 miesięcy po końcu ubezpieczenia. Wypadek przy pracy bez stażu."
  h1="Renta z tytułu niezdolności do pracy: czy masz staż"
  lead="Wpisz datę powstania niezdolności do pracy i swoje okresy składkowe i nieskładkowe, a sprawdzimy warunki stażu i terminu z ustawy o emeryturach i rentach z FUS."
  faq={faq}
>
  <form class="kalkulator" data-renta novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Niezdolność i staż</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="r-plec" class="etykieta-pola">Płeć</label>
          <select id="r-plec" name="plec" class="pole mt-1">
            <option value="m" selected>Mężczyzna</option>
            <option value="k">Kobieta</option>
          </select>
        </div>
        <div>
          <label for="r-urodzenie" class="etykieta-pola">Data urodzenia</label>
          <input id="r-urodzenie" name="urodzenie" type="date" class="pole mt-1" min="1940-01-01" max="2012-12-31" value={URODZENIE} aria-describedby="r-blad" />
        </div>
        <div>
          <label for="r-powstanie" class="etykieta-pola">Niezdolność powstała dnia</label>
          <input id="r-powstanie" name="powstanie" type="date" class="pole mt-1" min="1960-01-01" max="2100-12-31" value={dzis} data-dzis aria-describedby="r-blad" />
        </div>
        <div>
          <label for="r-ubezpieczenie" class="etykieta-pola">Względem ubezpieczenia</label>
          <select id="r-ubezpieczenie" name="ubezpieczenie" class="pole mt-1" aria-describedby="r-ubezpieczenie-opis">
            <option value="w-trakcie" selected>W czasie ubezpieczenia</option>
            <option value="do-18">Do 18 mies. po nim</option>
            <option value="pozniej">Później</option>
          </select>
        </div>
      </div>
      <p id="r-ubezpieczenie-opis" class="meta mt-1">Liczy się czas ubezpieczeń emerytalnego i rentowych (m.in. umowa o pracę, zlecenie ze składkami, działalność, zasiłek dla bezrobotnych, macierzyński, urlop wychowawczy) oraz m.in. wynagrodzenie i zasiłek za czas choroby, zasiłek opiekuńczy, świadczenie rehabilitacyjne i pielęgnacyjne (art. 57 ust. 1 pkt 3). 18 miesięcy liczy się od końca ostatniego z tych okresów.</p>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="r-przyczyna" class="etykieta-pola">Przyczyna</label>
          <select id="r-przyczyna" name="przyczyna" class="pole mt-1">
            <option value="choroba" selected>Choroba lub inny wypadek</option>
            <option value="praca">Wypadek przy pracy</option>
            <option value="zawodowa">Choroba zawodowa</option>
            <option value="droga">Wypadek w drodze</option>
          </select>
        </div>
        <div>
          <label for="r-stopien" class="etykieta-pola">Niezdolność</label>
          <select id="r-stopien" name="stopien" class="pole mt-1">
            <option value="czesciowa" selected>Częściowa</option>
            <option value="calkowita">Całkowita</option>
          </select>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <label for="r-skladkowe" class="etykieta-pola">Okresy składkowe (lata)</label>
          <input id="r-skladkowe" name="skladkowe" class="pole mt-1" type="text" inputmode="decimal" autocomplete="off" value="6" aria-describedby="r-blad r-okresy-opis" />
        </div>
        <div>
          <label for="r-nieskladkowe" class="etykieta-pola">Nieskładkowe (lata)</label>
          <input id="r-nieskladkowe" name="nieskladkowe" class="pole mt-1" type="text" inputmode="decimal" autocomplete="off" value="1" aria-describedby="r-blad r-okresy-opis" />
        </div>
        <div>
          <label for="r-ostatnie10" class="etykieta-pola">Z tego w ostatnich 10 latach</label>
          <input id="r-ostatnie10" name="ostatnie10" class="pole mt-1" type="text" inputmode="decimal" autocomplete="off" value="6" aria-describedby="r-blad r-okresy-opis" />
        </div>
      </div>
      <p id="r-okresy-opis" class="meta mt-1">Składkowe: m.in. praca, zlecenie i działalność ze składkami, zasiłek macierzyński, urlop wychowawczy, zasiłek dla bezrobotnych. Nieskładkowe: m.in. wynagrodzenie i zasiłek za czas choroby, zasiłek opiekuńczy, świadczenie rehabilitacyjne, ukończone studia (art. 7). W ostatnich 10 latach wpisz oba rodzaje razem, ale nieskładkowych najwyżej jedną trzecią składkowych z tych lat (art. 5 ust. 2). Lata możesz wpisać z ułamkiem, na przykład 4,5.</p>
      <p id="r-blad" class="blad-pola mt-3" data-blad="dane" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Renta z tytułu niezdolności</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-data" data-w="stan">{start.stan}</p>
        <p class="meta" data-w="opis">{start.opis}</p>
      </div>
      <dl class="wynik-lista">
        <div><dt>Wiek w dniu powstania</dt><dd data-w="wiek">{start.wiek}</dd></div>
        <div><dt>Wymagany staż</dt><dd data-w="wymagany">{start.wymagany}</dd></div>
        <div><dt>Twój staż do renty</dt><dd data-w="staz">{start.staz}</dd></div>
        <div><dt>Powstanie w terminie</dt><dd data-w="okres">{start.okres}</dd></div>
      </dl>
      <p class="wynik-uwaga" data-w="uwaga">{start.uwagi.join(' ')}</p>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Warunki są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="warunki">Warunki renty</h2>
    <ul>
      <li>Renta z tytułu niezdolności do pracy przysługuje osobie ubezpieczonej, która jest niezdolna do pracy, ma wymagany okres składkowy i nieskładkowy, stała się niezdolna do pracy w czasie ubezpieczeń emerytalnego i rentowych albo innych okresów z listy w art. 57 ust. 1 pkt 3 (m.in. wynagrodzenia i zasiłku za czas choroby, świadczenia rehabilitacyjnego) lub nie później niż 18 miesięcy od ich ustania i nie ma prawa do emerytury z FUS ani nie spełnia warunków do niej (art. 57 ust. 1 ustawy o emeryturach i rentach z FUS).</li>
      <li>Wymagany okres zależy od wieku, w którym powstała niezdolność: 1 rok przed ukończeniem 20 lat, 2 lata w wieku powyżej 20 do 22 lat, 3 lata powyżej 22 do 25 lat, 4 lata powyżej 25 do 30 lat, 5 lat powyżej 30 lat (art. 58 ust. 1).</li>
      <li>Przy 5 latach te 5 lat musi przypadać w ostatnich 10 latach przed wnioskiem o rentę albo przed powstaniem niezdolności; do 10 lat nie wlicza się okresów pobierania renty z tytułu niezdolności do pracy, szkoleniowej i rodzinnej ani okresów świadczenia pielęgnacyjnego, specjalnego zasiłku opiekuńczego i zasiłku dla opiekuna bez składek, więc te okresy wydłużają dziesięciolecie wstecz (art. 58 ust. 2). Nie dotyczy to osoby całkowicie niezdolnej do pracy z 25 latami (kobieta) albo 30 latami (mężczyzna) okresów składkowych, bez nieskładkowych (art. 58 ust. 4).</li>
      <li>Staż uważa się też za spełniony, gdy osobę zgłoszono do ubezpieczenia przed 18. urodzinami albo w ciągu 6 miesięcy po ukończeniu szkoły ponadpodstawowej, ponadgimnazjalnej lub wyższej, a do dnia powstania niezdolności okresy składkowe i nieskładkowe trwały bez przerw dłuższych niż 6 miesięcy (art. 58 ust. 3).</li>
      <li>Warunku 18 miesięcy nie stosuje się przy całkowitej niezdolności do pracy i stażu co najmniej 20 lat (kobiety) albo 25 lat (mężczyźni) (art. 57 ust. 2). Przy wypadku w drodze do pracy lub z pracy staż nie jest wymagany (art. 57a).</li>
      <li>Po wypadku przy pracy albo przy chorobie zawodowej renta z ubezpieczenia wypadkowego przysługuje bez względu na długość ubezpieczenia wypadkowego i datę powstania niezdolności, także osobie z prawem do emerytury (art. 17 ust. 1–2 ustawy wypadkowej); wynosi co najmniej 80% podstawy przy całkowitej i 60% przy częściowej niezdolności, z zastrzeżeniem art. 18 ust. 2. Świadczenia nie przysługują, gdy wyłączną przyczyną wypadku było umyślne albo rażąco niedbałe naruszenie przepisów o ochronie życia i zdrowia albo gdy osoba nietrzeźwa lub pod wpływem środków odurzających w znacznym stopniu przyczyniła się do wypadku (art. 21 ust. 1–2).</li>
      <li>Renta jest stała przy trwałej niezdolności i okresowa przy okresowej (art. 59). Gdy orzeczono celowość przekwalifikowania, przysługuje renta szkoleniowa przez 6 miesięcy, na wniosek starosty przedłużana najwyżej o 30 miesięcy (art. 60).</li>
    </ul>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Staż do renty to okresy składkowe plus nieskładkowe, ale nieskładkowe najwyżej w jednej trzeciej składkowych
      (art. 5 ust. 2); lata z ułamkiem zaokrąglamy do setnych, a braki podajemy w pełnych miesiącach. Wiek osiąga się
      w dniu urodzin. Ustawa nie mówi, czy „w wieku powyżej 22 do 25 lat” liczyć od dnia po 22. urodzinach, czy w pełnych
      latach (od 23. urodzin); tak samo przy progach 25 i 30 lat. Wymagany staż pokazujemy dla liczenia od dnia po
      urodzinach, a gdy przy liczeniu w pełnych latach wystarczy krótszy i Twój staż mieści się między nimi, piszemy
      „zależy”: rozstrzyga ZUS, a w sporze sąd. W dniu 20. urodzin wymagamy 2 lat (to już nie „przed ukończeniem 20 lat”),
      a w dniu 22., 25. i 30. urodzin krótszego okresu z niższego przedziału wieku. Warunek braku prawa do emerytury
      sprawdzamy na dzień powstania niezdolności i na dziś. Limit 1/3 dla okresów nieskładkowych dotyczy też 5 lat w ostatnich 10 latach (art. 5 ust. 2 i art. 58 ust. 2); tę liczbę bierzemy tak, jak ją wpiszesz. Okres z ostatnich 10 lat wpisujesz sam: liczy się 10 lat przed wnioskiem albo 10 lat przed powstaniem niezdolności, więc możesz
      sprawdzić oba. Zgłoszenia do ubezpieczenia przed 18. urodzinami albo po szkole (art. 58 ust. 3) kalkulator nie
      sprawdza. Nie oceniamy niezdolności do pracy (to robi lekarz orzecznik ZUS) i nie liczymy wysokości renty.
      Ile możesz dorobić do renty, policzy <a href="/narzedzia/dorabianie-do-renty">kalkulator dorabiania do renty i emerytury</a>, a jednorazowe odszkodowanie po wypadku przy pracy <a href="/narzedzia/odszkodowanie-za-wypadek-przy-pracy">kalkulator odszkodowania za wypadek</a>. Gdy niezdolność jest okresowa, a leczenie rokuje powrót do pracy, sprawdź <a href="/narzedzia/swiadczenie-rehabilitacyjne">świadczenie rehabilitacyjne</a>.
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { opisRenty, type Plec, type Przyczyna, type Stopien, type Ubezpieczenie } from '../../lib/narzedzia/renta-niezdolnosc';
  import { ustawDzisiejszeWartosci } from '../../lib/narzedzia/dzis-w-formularzu';
  import { wpisanaLiczba } from '../../lib/narzedzia/format';
  import { dzisWPolsce, poprawnaData } from '../../lib/narzedzia/terminy';
  import { typografia } from '../../lib/typografia.mjs';

  const form = document.querySelector<HTMLFormElement>('[data-renta]');
  if (form) {
    ustawDzisiejszeWartosci(form);
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const POLA = ['stan', 'opis', 'wiek', 'wymagany', 'staz', 'okres'] as const;
    const przelicz = () => {
      const urodzenie = el('urodzenie').value;
      const powstanie = el('powstanie').value;
      const [skladkowe, nieskladkowe, ostatnie10] = ['skladkowe', 'nieskladkowe', 'ostatnie10'].map((n) => wpisanaLiczba(el(n).value));
      let blad: string | null = null;
      if (!poprawnaData(urodzenie) || urodzenie > dzisWPolsce() || urodzenie < '1900-01-01') blad = 'Wpisz datę urodzenia.';
      else if (!poprawnaData(powstanie) || powstanie < urodzenie || powstanie > dzisWPolsce()) blad = 'Wpisz dzień powstania niezdolności do pracy: po dacie urodzenia i nie później niż dziś.';
      else if (![skladkowe, nieskladkowe, ostatnie10].every((x) => x >= 0 && x <= 70)) blad = 'Wpisz okresy w latach, na przykład 5 albo 4,5.';
      else if (ostatnie10 > 10 || ostatnie10 > skladkowe + nieskladkowe) blad = 'Okres z ostatnich 10 lat nie może być dłuższy niż 10 lat ani niż wszystkie okresy razem.';
      const b = form.querySelector<HTMLElement>('[data-blad="dane"]')!;
      b.hidden = !blad;
      b.textContent = blad ? typografia(blad) : '';
      // Pole, którego dotyczy błąd, dla czytnika ekranu (komunikat jest w aria-describedby).
      const polaBledu = blad ? ([
        ['Wpisz datę urodzenia.', ['urodzenie']],
        ['Wpisz dzień powstania', ['powstanie']],
        ['Wpisz okresy w latach', ['skladkowe', 'nieskladkowe', 'ostatnie10']],
        ['Okres z ostatnich 10', ['ostatnie10']],
      ] as [string, string[]][]).find(([p]) => blad!.startsWith(p))?.[1] ?? [] : [];
      for (const n of ['urodzenie', 'powstanie', 'skladkowe', 'nieskladkowe', 'ostatnie10']) el(n).setAttribute('aria-invalid', String(polaBledu.includes(n)));
      if (blad) {
        for (const k of POLA) w(k).textContent = k === 'opis' ? '' : '—';
        w('uwaga').textContent = '';
        return;
      }
      const o = opisRenty({
        plec: el('plec').value as Plec,
        urodzenie,
        powstanie,
        przyczyna: el('przyczyna').value as Przyczyna,
        stopien: el('stopien').value as Stopien,
        skladkowe,
        nieskladkowe,
        ostatnie10,
        ubezpieczenie: el('ubezpieczenie').value as Ubezpieczenie,
        dzis: dzisWPolsce(),
      });
      for (const k of POLA) w(k).textContent = typografia(o[k]);
      w('uwaga').textContent = typografia(o.uwagi.join(' '));
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    // Po powrocie przyciskiem Wstecz przeglądarka przywraca wybór po pierwszym liczeniu: liczymy jeszcze raz.
    window.addEventListener('pageshow', przelicz);
    przelicz();
  }
</script>
