---
// Wypowiedzenie zmieniające: do kiedy odmówić nowych warunków (art. 42 § 3 Kp), kiedy kończy się okres wypowiedzenia
// (art. 36 § 1, art. 30 § 2^1) i do kiedy odwołanie do sądu pracy (art. 264 § 1). Logika: src/lib/narzedzia/wypowiedzenie-zmieniajace.ts.
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { wypowiedzenieZmieniajace } from '../../lib/narzedzia/wypowiedzenie-zmieniajace';
import { dataPoPolsku, dodajDni, dzisWPolsce } from '../../lib/narzedzia/terminy';

const DZIS = dzisWPolsce();
const START = dodajDni(DZIS, -400);
const r = wypowiedzenieZmieniajace(START, DZIS);

const faq = [
  {
    pytanie: 'Ile mam czasu na odmowę przyjęcia nowych warunków?',
    odpowiedz: 'Do upływu połowy okresu wypowiedzenia (art. 42 § 3 Kodeksu pracy). Gdy pismo pracodawcy nie zawiera pouczenia o tym terminie, odmowę możesz złożyć aż do końca okresu wypowiedzenia. Przepis nie mówi, od którego dnia liczyć połowę, dlatego kalkulator podaje wcześniejszą z dwóch możliwych dat.',
  },
  {
    pytanie: 'Co się stanie, jeśli nic nie zrobię?',
    odpowiedz: 'Gdy przed upływem połowy okresu wypowiedzenia nie złożysz oświadczenia o odmowie, uważa się, że zgadzasz się na nowe warunki (art. 42 § 3 Kodeksu pracy). Obowiązują one od dnia po końcu okresu wypowiedzenia, a do tego dnia pracujesz na dotychczasowych warunkach.',
  },
  {
    pytanie: 'Co się stanie, gdy odmówię nowych warunków?',
    odpowiedz: 'Umowa o pracę rozwiązuje się z upływem okresu wypowiedzenia (art. 42 § 3 Kodeksu pracy). Okres jest taki sam jak przy zwykłym wypowiedzeniu: 2 tygodnie, 1 miesiąc albo 3 miesiące zależnie od stażu u pracodawcy (art. 36 § 1).',
  },
  {
    pytanie: 'Czy po odmowie należy się odprawa?',
    odpowiedz: 'Odprawa należy się, gdy pracodawca zatrudnia co najmniej 20 pracowników, a umowa rozwiązuje się z przyczyn niedotyczących pracownika: przy zwolnieniu grupowym (art. 1 i 8 ustawy o zwolnieniach z przyczyn niedotyczących pracowników), a poza nim, gdy te przyczyny są wyłącznym powodem wypowiedzenia (art. 10 ust. 1). Przepis wprost nie mówi, czy odmowa nowych warunków jest współprzyczyną rozwiązania umowy. W sporze rozstrzyga to sąd pracy.',
  },
  {
    pytanie: 'Czy mogę odwołać się do sądu pracy od wypowiedzenia zmieniającego?',
    odpowiedz: 'Tak. Przepisy o wypowiedzeniu umowy stosuje się odpowiednio (art. 42 § 1 Kodeksu pracy), więc odwołanie wnosisz do sądu pracy w ciągu 21 dni od doręczenia pisma (art. 264 § 1). Przepis nie mówi, czy odwołanie zastępuje odmowę, dlatego odmowę złóż osobno w jej terminie.',
  },
  {
    pytanie: 'Czy pracodawca może dać mi inną pracę bez wypowiedzenia?',
    odpowiedz: 'Tak, ale najwyżej na 3 miesiące w roku kalendarzowym, gdy uzasadniają to potrzeby pracodawcy, praca odpowiada Twoim kwalifikacjom, a wynagrodzenie się nie obniża (art. 42 § 4 Kodeksu pracy). Gdy któryś z tych warunków nie jest spełniony, potrzebne jest wypowiedzenie zmieniające (art. 42) albo porozumienie na piśmie (art. 29 § 4).',
  },
];
---
<StronaNarzedzia
  slug="wypowiedzenie-zmieniajace"
  tytul="Wypowiedzenie zmieniające: termin na odmowę"
  opis="Do kiedy odmówić nowych warunków pracy lub płacy (połowa okresu wypowiedzenia), kiedy obowiązują, kiedy kończy się umowa po odmowie i termin do sądu."
  h1="Wypowiedzenie zmieniające: do kiedy odmówić"
  lead="Pracodawca proponuje na piśmie nowe warunki pracy albo płacy. Masz czas do połowy okresu wypowiedzenia, żeby je odrzucić (bez pouczenia w piśmie: do końca okresu); potem milczenie oznacza zgodę. Wpisz, od kiedy pracujesz i w jakim dniu doręczono Ci pismo, a policzymy wszystkie terminy."
  faq={faq}
>
  <form class="kalkulator" data-zmieniajace novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Twoje wypowiedzenie</h2>
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
          <label for="wz-start" class="etykieta-pola">Pracujesz u tego pracodawcy od</label>
          <input id="wz-start" name="start" type="date" class="pole mt-1" min="1960-01-01" max="2100-12-31" value={START} aria-describedby="wz-blad" data-dzis="-400" />
        </div>
        <div>
          <label for="wz-doreczenie" class="etykieta-pola">Dzień doręczenia pisma</label>
          <input id="wz-doreczenie" name="doreczenie" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" value={DZIS} aria-describedby="wz-blad" data-dzis />
        </div>
      </div>
      <label class="mt-4 flex items-start gap-3 text-[0.9375rem]">
        <input type="checkbox" name="pouczenie" checked class="mt-1 size-[1.125rem] flex-none accent-[var(--color-akcent-tekst)]" />
        <span>Pismo zawiera pouczenie, że brak odmowy przed połową okresu oznacza zgodę</span>
      </label>
      <p id="wz-blad" class="blad-pola mt-3" data-blad="dane" role="alert" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Odmowę złóż najpóźniej</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-data" data-w="odmowa">{dataPoPolsku(r.odmowaDo)}</p>
        <p class="status-terminu" data-w="status" hidden></p>
      </div>
      <dl class="wynik-lista">
        <div><dt>Okres wypowiedzenia</dt><dd data-w="okres">{r.okres.opis}</dd></div>
        <div data-w="prog-wiersz" hidden={!r.prog}><dt>Próg stażu w trakcie wypowiedzenia</dt><dd data-w="prog">{r.prog ? `${r.prog.miesiace === 6 ? '6 miesięcy' : '3 lata'} mija ${dataPoPolsku(r.prog.dzien)}; odmowa liczona od okresu ${r.prog.krotszy}` : ''}</dd></div>
        <div><dt>Okres kończy się</dt><dd data-w="koniec">{dataPoPolsku(r.koniec)}</dd></div>
        <div><dt>Gdy przyjmiesz: nowe warunki od</dt><dd data-w="nowe">{dataPoPolsku(r.noweWarunkiOd)}</dd></div>
        <div><dt>Gdy odmówisz: ostatni dzień umowy</dt><dd data-w="ostatni">{dataPoPolsku(r.koniec)}</dd></div>
        <div><dt>Połowa od początku pełnego tygodnia albo miesiąca</dt><dd data-w="wariant-b">{dataPoPolsku(r.odmowaDoWariantB)}</dd></div>
        <div><dt>Odwołanie do sądu pracy do</dt><dd data-w="odwolanie">{dataPoPolsku(r.odwolanieDo)}</dd></div>
      </dl>
      <p class="wynik-uwaga" data-w="uwaga">Odmowa złożona później może zostać uznana za spóźnioną, a wtedy przyjmujesz nowe warunki (art. 42 § 3 Kodeksu pracy). Liczy się dzień, w którym odmowa dotrze do pracodawcy.</p>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Zasady są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Wypowiedzenie warunków pracy albo płacy jest dokonane, gdy pracodawca zaproponował Ci nowe warunki na piśmie
      (art. 42 § 2 Kodeksu pracy). Do takiego wypowiedzenia stosuje się odpowiednio przepisy o wypowiedzeniu umowy
      (art. 42 § 1), więc okres zależy od stażu u tego pracodawcy w dniu doręczenia:
    </p>
    <div class="tabela">
      <table>
        <caption class="sr-only">Okres wypowiedzenia zmieniającego według stażu</caption>
        <thead><tr><th scope="col">Staż u pracodawcy</th><th scope="col">Okres</th><th scope="col">Kończy się</th></tr></thead>
        <tbody>
          <tr><th scope="row">Krócej niż 6 miesięcy</th><td>2 tygodnie</td><td>w sobotę</td></tr>
          <tr><th scope="row">Co najmniej 6 miesięcy</th><td>1 miesiąc</td><td>ostatniego dnia miesiąca</td></tr>
          <tr><th scope="row">Co najmniej 3 lata</th><td>3 miesiące</td><td>ostatniego dnia miesiąca</td></tr>
        </tbody>
      </table>
    </div>
    <p>
      Okresy i ich koniec wynikają z art. 36 § 1 i art. 30 § 2<sup>1</sup>; liczymy je tak samo jak <a href="/narzedzia/okres-wypowiedzenia">kalkulator okresu wypowiedzenia</a>. Staż liczymy w pełnych miesiącach do dnia doręczenia; dnia doręczenia nie wliczamy. Wpisz początek
      pracy razem z wcześniejszym zleceniem albo działalnością wykonywaną dla tego pracodawcy (art. 302<sup>1</sup> § 8)
      i pracą przed przejściem zakładu na nowego pracodawcę (art. 36 § 1<sup>1</sup>); pomoże <a href="/narzedzia/staz-pracy">kalkulator
      stażu pracy</a>. Gdy próg 6 miesięcy albo 3 lat mija w trakcie okresu wypowiedzenia, przepis nie mówi wprost, co wtedy.
      Jak kalkulator okresu wypowiedzenia podajemy wtedy dłuższy okres i późniejszy koniec umowy, ale termin na odmowę
      liczymy od krótszego okresu, także bez pouczenia, więc odmowa złożona do tej daty jest w terminie przy obu wariantach. Przy umowie na czas określony, która
      kończy się przed końcem okresu wypowiedzenia, umowa rozwiązuje się z upływem czasu, na który ją zawarto (art. 30 § 1 pkt 4). Przy stanowisku z odpowiedzialnością
      materialną umowa może przewidywać dłuższe okresy (art. 36 § 5); wtedy kalkulator ich nie zna. Okresu próbnego
      kalkulator nie obejmuje.
    </p>
    <p>
      <strong>Połowa okresu.</strong> Przepis mówi tylko „przed upływem połowy okresu wypowiedzenia” (art. 42 § 3) i nie
      wskazuje, od którego dnia liczyć okres. Liczymy więc dwa warianty: od dnia po doręczeniu pisma oraz od pierwszego dnia
      pełnego tygodnia (niedzieli) albo miesiąca, w którym zaczyna się okres. Jako termin podajemy wcześniejszą datę, bo
      odmowa złożona do tego dnia mieści się w terminie przy obu sposobach liczenia. Gdy połowa wypada w środku dnia
      (na przykład przy 31 dniach), ten dzień już nie wchodzi do terminu. Dnia doręczenia nie liczymy (art. 111 § 2
      Kodeksu cywilnego). Terminu na odmowę nie przesuwamy z soboty ani święta: gdy wypada w dzień wolny, złóż odmowę
      wcześniej. Przepis nie wymaga pisma, ale pismo z potwierdzeniem odbioru jest dowodem, a liczy się dzień, w którym
      odmowa dotrze do pracodawcy, a nie dzień wysłania. Najbezpieczniej złożyć odmowę od razu, gdy decyzja jest podjęta.
    </p>
    <p>
      <strong>Odwołanie do sądu pracy.</strong> 21 dni od doręczenia pisma (art. 264 § 1). Gdy ostatni dzień wypada
      w sobotę, niedzielę albo święto, termin przesuwa się na najbliższy dzień roboczy (art. 115 Kodeksu cywilnego).
      Szczegóły i przywrócenie terminu: <a href="/narzedzia/odwolanie-do-sadu-pracy">kalkulator terminu odwołania</a>.
    </p>

    <h2 id="kiedy-nie-wolno">Kiedy pracodawca nie może wypowiedzieć warunków</h2>
    <ul>
      <li>W czasie Twojego urlopu i innej usprawiedliwionej nieobecności, na przykład zwolnienia lekarskiego, zanim minie okres, który pozwala rozwiązać umowę bez wypowiedzenia (art. 41 w związku z art. 42 § 1). Ten zakaz nie obowiązuje przy zwolnieniach z przyczyn niedotyczących pracowników u pracodawcy zatrudniającego co najmniej 20 osób (art. 5 ust. 4 i art. 10 ust. 1 ustawy o zwolnieniach) ani przy upadłości lub likwidacji pracodawcy (art. 41<sup>1</sup> § 1).</li>
      <li>Gdy brakuje Ci nie więcej niż 4 lata do wieku emerytalnego, a staż pozwoli uzyskać emeryturę: tylko z powodu nowych zasad wynagradzania dla wszystkich albo Twojej grupy pracowników albo utraty zdolności do pracy lub uprawnień (art. 39, 40 i 43). Przy zwolnieniach z przyczyn niedotyczących pracowników pracodawca może wypowiedzieć warunki także osobom chronionym (art. 5 ust. 5 i art. 10 ust. 3 ustawy o zwolnieniach). Więcej: <a href="/narzedzia/ochrona-przedemerytalna">ochrona przedemerytalna</a>.</li>
      <li>W ciąży i od złożenia wniosku o urlop macierzyński, ojcowski albo rodzicielski do jego końca pracodawca nie może wypowiedzieć umowy (art. 177 § 1). Przepis nie mówi wprost, czy ten zakaz obejmuje wypowiedzenie zmieniające; przepisy o wypowiedzeniu stosuje się do niego odpowiednio (art. 42 § 1). Przy zwolnieniach z przyczyn niedotyczących pracowników u pracodawcy zatrudniającego co najmniej 20 osób pracodawca może pracownicy w ciąży i osobie, która złożyła wniosek o urlop macierzyński, ojcowski, rodzicielski albo opiekuńczy, wypowiedzieć tylko warunki pracy i płacy; gdy wynagrodzenie spada, przysługuje dodatek wyrównawczy do końca okresu ochrony (art. 5 ust. 5 pkt 1 i ust. 6 oraz art. 10 ust. 3 ustawy o zwolnieniach).</li>
      <li>Gdy reprezentuje Cię zakładowa organizacja związkowa, pracodawca najpierw zawiadamia ją o zamiarze wypowiedzenia i podaje przyczynę (art. 38 w związku z art. 42 § 1). Przy zwolnieniu grupowym obowiązuje to wtedy, gdy nie zawarto porozumienia ze związkami (art. 5 ust. 2 ustawy o zwolnieniach).</li>
    </ul>

    <h2 id="po-odmowie">Po odmowie</h2>
    <p>
      Umowa rozwiązuje się z końcem okresu wypowiedzenia (art. 42 § 3). Gdy pracodawca zatrudnia co najmniej 20 osób,
      a umowa kończy się z przyczyn niedotyczących pracownika (przy zwolnieniu indywidualnym: gdy są one wyłącznym
      powodem), odprawa wynosi 1, 2 albo 3 miesięczne wynagrodzenia zależnie od stażu, najwyżej 15-krotność płacy
      minimalnej (art. 1, 8 i 10 ustawy o zwolnieniach). Kwotę policzy <a href="/narzedzia/kalkulator-odprawy">kalkulator odprawy</a>.
      Przepis wprost nie mówi, czy Twoja odmowa jest współprzyczyną rozwiązania umowy; w sporze ocenia to sąd pracy.
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { liczPoPowrocie, pokazBlad } from '../../lib/narzedzia/formularz';
  import { ustawDzisiejszeWartosci } from '../../lib/narzedzia/dzis-w-formularzu';
  import { wypowiedzenieZmieniajace } from '../../lib/narzedzia/wypowiedzenie-zmieniajace';
  import { dataPoPolsku, dniMiedzy, dzisWPolsce, poprawnaData } from '../../lib/narzedzia/terminy';
  import { odmiana } from '../../lib/redakcja';
  import { typografia } from '../../lib/typografia.mjs';

  const form = document.querySelector<HTMLFormElement>('[data-zmieniajace]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const POLA = ['okres', 'koniec', 'nowe', 'ostatni', 'wariant-b', 'odwolanie'];
    const przelicz = () => {
      const start = el('start').value;
      const doreczenie = el('doreczenie').value;
      const b = form.querySelector<HTMLElement>('[data-blad="dane"]')!;
      const status = w('status');
      let blad: string | null = null;
      let pole: HTMLInputElement | null = null;
      if (!poprawnaData(start)) (blad = 'Wpisz datę rozpoczęcia pracy u tego pracodawcy.'), (pole = el('start'));
      else if (!poprawnaData(doreczenie)) (blad = 'Wpisz dzień doręczenia pisma.'), (pole = el('doreczenie'));
      else if (doreczenie < start) (blad = 'Dzień doręczenia nie może być wcześniejszy niż początek pracy.'), (pole = el('doreczenie'));
      pokazBlad(b, blad, pole);
      if (blad) {
        w('odmowa').textContent = '—';
        for (const k of POLA) w(k).textContent = '—';
        w('prog-wiersz').hidden = true;
        status.hidden = true;
        w('uwaga').hidden = true;
        return;
      }
      const r = wypowiedzenieZmieniajace(start, doreczenie, el('pouczenie').checked);
      w('odmowa').textContent = typografia(dataPoPolsku(r.odmowaDo));
      w('okres').textContent = typografia(r.okres.opis);
      w('prog-wiersz').hidden = !r.prog;
      w('prog').textContent = r.prog ? typografia(`${r.prog.miesiace === 6 ? '6 miesięcy' : '3 lata'} mija ${dataPoPolsku(r.prog.dzien)}; odmowa liczona od okresu ${r.prog.krotszy}`) : '';
      w('koniec').textContent = typografia(dataPoPolsku(r.koniec));
      w('nowe').textContent = typografia(dataPoPolsku(r.noweWarunkiOd));
      w('ostatni').textContent = typografia(dataPoPolsku(r.koniec));
      w('wariant-b').textContent = typografia(r.pouczenie ? dataPoPolsku(r.odmowaDoWariantB) : 'nie dotyczy (bez pouczenia)');
      w('odwolanie').textContent = typografia(dataPoPolsku(r.odwolanieDo));
      w('uwaga').hidden = false;
      w('uwaga').textContent = typografia(
        r.pouczenie
          ? 'Odmowa złożona później może zostać uznana za spóźnioną, a wtedy przyjmujesz nowe warunki (art. 42 § 3 Kodeksu pracy). Liczy się dzień, w którym odmowa dotrze do pracodawcy.'
          : `Bez pouczenia możesz odmówić do końca okresu wypowiedzenia (art. 42 § 3 zdanie trzecie Kodeksu pracy).${r.prog ? ' Staż osiąga próg w trakcie wypowiedzenia, a przepis nie mówi, czy okres się wydłuża, więc podajemy koniec krótszego okresu.' : ''} Liczy się dzień, w którym odmowa dotrze do pracodawcy.`,
      );
      const zostalo = dniMiedzy(dzisWPolsce(), r.odmowaDo);
      status.hidden = false;
      status.dataset.status = zostalo < 0 ? 'po-terminie' : zostalo <= 3 ? 'wkrotce' : 'w-terminie';
      status.textContent = typografia(
        zostalo < 0 ? 'Termin na odmowę minął' : zostalo === 0 ? 'To dziś: złóż odmowę dzisiaj' : zostalo === 1 ? 'Został 1 dzień' : `${zostalo % 10 >= 2 && zostalo % 10 <= 4 && (zostalo % 100 < 12 || zostalo % 100 > 14) ? 'Zostały' : 'Zostało'} ${odmiana(zostalo, ['dzień', 'dni', 'dni'])}`,
      );
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    ustawDzisiejszeWartosci(form);
    liczPoPowrocie(przelicz);
    przelicz();
  }
</script>
