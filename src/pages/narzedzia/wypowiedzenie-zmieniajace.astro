---
// Wypowiedzenie zmieniające: do kiedy odmówić nowych warunków (art. 42 § 3 Kp), kiedy kończy się okres wypowiedzenia
// (art. 36 § 1, art. 30 § 2^1) i do kiedy odwołanie do sądu pracy (art. 264 § 1). Logika: src/lib/narzedzia/wypowiedzenie-zmieniajace.ts.
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { opisZmieniajacego, wypowiedzenieZmieniajace } from '../../lib/narzedzia/wypowiedzenie-zmieniajace';
import { BEZ_PRZESUNIECIA, ETYKIETA_ART_115, dodajDni, dzisWPolsce } from '../../lib/narzedzia/terminy';

const DZIS = dzisWPolsce();
const START = dodajDni(DZIS, -400);
const o = opisZmieniajacego(wypowiedzenieZmieniajace(START, DZIS), DZIS);

const faq = [
  {
    pytanie: 'Ile mam czasu na odmowę przyjęcia nowych warunków?',
    odpowiedz: 'Do upływu połowy okresu wypowiedzenia (art. 42 § 3 Kodeksu pracy). Gdy pismo pracodawcy nie zawiera pouczenia o tym terminie, odmowę możesz złożyć aż do końca okresu wypowiedzenia. Przepis nie mówi, od którego dnia liczyć połowę, dlatego kalkulator podaje wcześniejszą z dwóch możliwych dat.',
  },
  {
    pytanie: 'Co się stanie, jeśli nic nie zrobię?',
    odpowiedz: 'Gdy przed upływem połowy okresu wypowiedzenia nie złożysz oświadczenia o odmowie, uważa się, że zgadzasz się na nowe warunki (art. 42 § 3 Kodeksu pracy). Obowiązują one od dnia po końcu okresu wypowiedzenia, a do tego dnia pracujesz na dotychczasowych warunkach.',
  },
  {
    pytanie: 'Co się stanie, gdy odmówię nowych warunków?',
    odpowiedz: 'Umowa o pracę rozwiązuje się z upływem okresu wypowiedzenia (art. 42 § 3 Kodeksu pracy). Okres jest taki sam jak przy zwykłym wypowiedzeniu: 2 tygodnie, 1 miesiąc albo 3 miesiące zależnie od stażu u pracodawcy (art. 36 § 1).',
  },
  {
    pytanie: 'Czy po odmowie należy się odprawa?',
    odpowiedz: 'Może się należeć. Odprawa przysługuje, gdy pracodawca zatrudnia co najmniej 20 pracowników, a umowa rozwiązuje się z przyczyn niedotyczących pracownika (art. 1, 8 i 10 ustawy o zwolnieniach z przyczyn niedotyczących pracowników); według Sądu Najwyższego chodzi o przyczyny, bez których do zwolnienia by nie doszło. Sama odmowa nie odbiera odprawy. Gdy przyjęcie nowych warunków prowadziłoby do poważnych zmian na Twoją niekorzyść, na przykład radykalnej obniżki pensji za tę samą pracę, odprawa może się należeć (wyroki I PKN 79/00 i II PK 340/12). Gdy nowe warunki obiektywnie dało się przyjąć, odmowa może być uznana za współprzyczynę rozwiązania umowy i wtedy odprawy nie ma (wyroki I PK 144/11 i III PK 55/14). Ocenia to sąd pracy w konkretnej sprawie.',
  },
  {
    pytanie: 'Czy mogę odwołać się do sądu pracy od wypowiedzenia zmieniającego?',
    odpowiedz: 'Tak. Przepisy o wypowiedzeniu umowy stosuje się odpowiednio (art. 42 § 1 Kodeksu pracy), więc odwołanie wnosisz do sądu pracy w ciągu 21 dni od doręczenia pisma (art. 264 § 1). Przepis nie mówi, czy odwołanie zastępuje odmowę, dlatego odmowę złóż osobno w jej terminie.',
  },
  {
    pytanie: 'Czy pracodawca może dać mi inną pracę bez wypowiedzenia?',
    odpowiedz: 'Tak, ale najwyżej na 3 miesiące w roku kalendarzowym, gdy uzasadniają to potrzeby pracodawcy, praca odpowiada Twoim kwalifikacjom, a wynagrodzenie się nie obniża (art. 42 § 4 Kodeksu pracy). Gdy któryś z tych warunków nie jest spełniony, potrzebne jest wypowiedzenie zmieniające (art. 42) albo porozumienie na piśmie (art. 29 § 4).',
  },
];
---
<StronaNarzedzia
  slug="wypowiedzenie-zmieniajace"
  tytul="Wypowiedzenie zmieniające: termin na odmowę"
  opis="Do kiedy odmówić nowych warunków pracy lub płacy (połowa okresu wypowiedzenia), kiedy obowiązują, kiedy kończy się umowa po odmowie i termin do sądu."
  h1="Wypowiedzenie zmieniające: do kiedy odmówić"
  lead="Pracodawca proponuje na piśmie nowe warunki pracy albo płacy. Masz czas do połowy okresu wypowiedzenia, żeby je odrzucić (bez pouczenia w piśmie: do końca okresu); potem milczenie oznacza zgodę. Wpisz, od kiedy pracujesz i w jakim dniu doręczono Ci pismo, a policzymy wszystkie terminy."
  faq={faq}
>
  <form class="kalkulator" data-zmieniajace novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Twoje wypowiedzenie</h2>
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
          <label for="wz-start" class="etykieta-pola">Pracujesz u tego pracodawcy od</label>
          <input id="wz-start" name="start" type="date" class="pole mt-1" min="1960-01-01" max="2100-12-31" value={START} aria-describedby="wz-blad" data-dzis="-400" />
        </div>
        <div>
          <label for="wz-doreczenie" class="etykieta-pola">Dzień doręczenia pisma</label>
          <input id="wz-doreczenie" name="doreczenie" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" value={DZIS} aria-describedby="wz-blad" data-dzis />
        </div>
      </div>
      <label class="mt-4 flex items-start gap-3 text-[0.9375rem]">
        <input type="checkbox" name="pouczenie" checked class="mt-1 size-[1.125rem] flex-none accent-[var(--color-akcent-tekst)]" />
        <span>Pismo zawiera pouczenie, że brak odmowy przed połową okresu oznacza zgodę</span>
      </label>
      <p id="wz-blad" class="blad-pola mt-3" data-blad="dane" role="alert" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta" data-w="odmowa-etykieta">{o.odmowaEtykieta}</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-data" data-w="odmowa">{o.odmowa}</p>
        <p class="status-terminu" data-w="status" data-status={o.statusKlasa}>{o.status}</p>
        <dl class="wynik-lista" data-wiersz="odmowa-art115" hidden={!o.odmowaArt115}>
          <div><dt>{ETYKIETA_ART_115}</dt><dd data-w="odmowa-art115">{o.odmowaArt115}</dd></div>
        </dl>
      </div>
      <p class="meta mt-2" data-w="odmowa-zdanie" hidden={!o.odmowaZdanie}>{o.odmowaZdanie}</p>
      <dl class="wynik-lista">
        <div><dt>Okres wypowiedzenia</dt><dd data-w="okres">{o.okres}</dd></div>
        <div data-w="prog-wiersz" hidden={!o.prog}><dt>Próg stażu w trakcie wypowiedzenia</dt><dd data-w="prog">{o.prog ?? ''}</dd></div>
        <div><dt>Okres kończy się</dt><dd data-w="koniec">{o.koniec}</dd></div>
        <div><dt>Gdy przyjmiesz: nowe warunki od</dt><dd data-w="nowe">{o.nowe}</dd></div>
        <div><dt>Gdy odmówisz: ostatni dzień umowy</dt><dd data-w="ostatni">{o.koniec}</dd></div>
        <div><dt>Połowa od początku pełnego tygodnia albo miesiąca</dt><dd data-w="wariant-b">{o.wariantB}</dd></div>
        <div><dt data-w="odwolanie-etykieta">{o.odwolanieEtykieta}</dt><dd data-w="odwolanie">{o.odwolanie}</dd></div>
        <div data-wiersz="odwolanie-art115" hidden={!o.odwolanieArt115}><dt>{o.odwolanieArt115Etykieta}</dt><dd data-w="odwolanie-art115">{o.odwolanieArt115}</dd></div>
      </dl>
      <p class="meta mt-2" data-w="odwolanie-zdanie" hidden={!o.odwolanieZdanie}>{o.odwolanieZdanie}</p>
      <p class="wynik-uwaga" data-w="uwaga">{o.uwaga}</p>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Zasady są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Wypowiedzenie warunków pracy albo płacy jest dokonane, gdy pracodawca zaproponował Ci nowe warunki na piśmie
      (art. 42 § 2 Kodeksu pracy). Do takiego wypowiedzenia stosuje się odpowiednio przepisy o wypowiedzeniu umowy
      (art. 42 § 1), więc okres zależy od stażu u tego pracodawcy:
    </p>
    <div class="tabela">
      <table>
        <caption class="sr-only">Okres wypowiedzenia zmieniającego według stażu</caption>
        <thead><tr><th scope="col">Staż u pracodawcy</th><th scope="col">Okres</th><th scope="col">Kończy się</th></tr></thead>
        <tbody>
          <tr><th scope="row">Krócej niż 6 miesięcy</th><td>2 tygodnie</td><td>w sobotę</td></tr>
          <tr><th scope="row">Co najmniej 6 miesięcy</th><td>1 miesiąc</td><td>ostatniego dnia miesiąca</td></tr>
          <tr><th scope="row">Co najmniej 3 lata</th><td>3 miesiące</td><td>ostatniego dnia miesiąca</td></tr>
        </tbody>
      </table>
    </div>
    <p>
      Okresy i ich koniec wynikają z art. 36 § 1 i art. 30 § 2<sup>1</sup>; liczymy je tak samo jak <a href="/narzedzia/okres-wypowiedzenia">kalkulator okresu wypowiedzenia</a>. Najpierw liczymy staż w dniu doręczenia, w pełnych miesiącach i bez tego dnia, a potem sprawdzamy, czy do końca okresu osiągnie próg. Wpisz początek
      pracy razem z wcześniejszym zleceniem albo działalnością wykonywaną dla tego pracodawcy (art. 302<sup>1</sup> § 8)
      i pracą przed przejściem zakładu na nowego pracodawcę (art. 36 § 1<sup>1</sup>); pomoże <a href="/narzedzia/staz-pracy">kalkulator
      stażu pracy</a>. Gdy próg 6 miesięcy albo 3 lat mija w trakcie okresu wypowiedzenia, przepis nie mówi tego wprost, ale
      Sąd Najwyższy liczy staż do dnia rozwiązania umowy, a nie do dnia doręczenia (wyrok z 11 maja 1999 r., I PKN 34/99;
      tak samo II PK 12/11), a przepisy o wypowiedzeniu stosuje się tu odpowiednio (art. 42 § 1). Jak kalkulator okresu
      wypowiedzenia podajemy wtedy dłuższy okres i późniejszy koniec umowy, ale termin na odmowę liczymy od krótszego
      okresu, także bez pouczenia, bo o połowie wydłużonego okresu orzeczeń nie znaleźliśmy; odmowa złożona do tej daty
      jest w terminie niezależnie od tego, czy okres się wydłużył. Przy umowie na czas określony, która
      kończy się przed końcem okresu wypowiedzenia, umowa rozwiązuje się z upływem czasu, na który ją zawarto (art. 30 § 1 pkt 4). Przy stanowisku z odpowiedzialnością
      materialną umowa może przewidywać dłuższe okresy (art. 36 § 5); wtedy kalkulator ich nie zna. Okresu próbnego
      kalkulator nie obejmuje.
    </p>
    <p>
      <strong>Połowa okresu.</strong> Przepis mówi tylko „przed upływem połowy okresu wypowiedzenia” (art. 42 § 3) i nie
      wskazuje, od którego dnia liczyć okres. Liczymy więc dwa warianty: od dnia po doręczeniu pisma oraz od pierwszego dnia
      pełnego tygodnia (niedzieli) albo miesiąca, w którym zaczyna się okres. Jako termin podajemy wcześniejszą datę, bo
      odmowa złożona do tego dnia mieści się w terminie przy obu sposobach liczenia. Gdy próg stażu mija w trakcie
      wypowiedzenia, oba warianty liczymy od krótszego okresu. Gdy połowa wypada w środku dnia
      (na przykład przy 31 dniach), ten dzień już nie wchodzi do terminu. Dnia doręczenia nie liczymy (art. 111 § 2
      Kodeksu cywilnego). Gdy ostatni dzień na odmowę wypada w sobotę albo dzień ustawowo wolny od pracy, podajemy
      dwie daty: „zdąż do” i ostatni dzień według art. 115 Kodeksu cywilnego (następny dzień, który nie jest dniem wolnym
      ani sobotą). Czy to przesunięcie działa przy odmowie, przepisy wprost nie mówią, a orzeczeń o tym nie znaleźliśmy,
      więc zdąż do pierwszej daty. Przepis nie wymaga pisma, ale pismo z potwierdzeniem odbioru jest dowodem, a liczy się dzień, w którym
      odmowa dotrze do pracodawcy tak, że może się z nią zapoznać (art. 61 § 1 Kodeksu cywilnego), a nie dzień wysłania.
      Najbezpieczniej złożyć odmowę od razu, gdy decyzja jest podjęta. {BEZ_PRZESUNIECIA.okres}
    </p>
    <p>
      <strong>Odwołanie do sądu pracy.</strong> 21 dni od doręczenia pisma (art. 264 § 1), bez dnia doręczenia. Gdy
      21. dzień wypada w sobotę albo dzień ustawowo wolny od pracy, podajemy „zdąż do” i ostatni dzień według art. 115
      Kodeksu cywilnego: sądy pracy stosują to przesunięcie przy odwołaniach z art. 264, ale bezpieczniej zdążyć do pierwszej
      daty. Szczegóły i przywrócenie terminu: <a href="/narzedzia/odwolanie-do-sadu-pracy">kalkulator terminu odwołania</a>.
    </p>

    <h2 id="kiedy-nie-wolno">Kiedy pracodawca nie może wypowiedzieć warunków</h2>
    <ul>
      <li>W czasie Twojego urlopu i innej usprawiedliwionej nieobecności, na przykład zwolnienia lekarskiego, zanim minie okres, który pozwala rozwiązać umowę bez wypowiedzenia (art. 41 w związku z art. 42 § 1). Ten zakaz nie obowiązuje przy zwolnieniach z przyczyn niedotyczących pracowników u pracodawcy zatrudniającego co najmniej 20 osób (art. 5 ust. 4 i art. 10 ust. 1 ustawy o zwolnieniach) ani przy upadłości lub likwidacji pracodawcy (art. 41<sup>1</sup> § 1).</li>
      <li>Gdy brakuje Ci nie więcej niż 4 lata do wieku emerytalnego, a staż pozwoli uzyskać emeryturę: tylko gdy jest to konieczne z powodu nowych zasad wynagradzania dla wszystkich albo Twojej grupy pracowników, utraty zdolności do dotychczasowej pracy stwierdzonej orzeczeniem lekarskim albo utraty uprawnień potrzebnych do tej pracy, jeśli nie stało się to z Twojej winy (art. 39, 40 i 43). Przy zwolnieniach z przyczyn niedotyczących pracowników pracodawca może wypowiedzieć warunki także osobom chronionym (art. 5 ust. 5 i art. 10 ust. 3 ustawy o zwolnieniach). Więcej: <a href="/narzedzia/ochrona-przedemerytalna">ochrona przedemerytalna</a>.</li>
      <li>W ciąży, w czasie urlopu macierzyńskiego i od złożenia wniosku o urlop macierzyński, urlop na warunkach urlopu macierzyńskiego, uzupełniający urlop macierzyński, urlop ojcowski albo rodzicielski do końca tego urlopu pracodawca nie może wypowiedzieć umowy (art. 177 § 1). Gdy wniosek złożono wcześniej, niż wymagają tego przepisy o tych urlopach, ochrona zaczyna się dopiero 14 dni przed częścią urlopu macierzyńskiego, 21 dni przed urlopem rodzicielskim albo uzupełniającym i 7 dni przed urlopem ojcowskim (art. 177 § 1¹). Wyjątek: upadłość albo likwidacja pracodawcy; wtedy pracodawca uzgadnia termin ze związkiem zawodowym, który Cię reprezentuje (art. 177 § 4). Przepis nie mówi wprost, czy ten zakaz obejmuje wypowiedzenie zmieniające; przepisy o wypowiedzeniu stosuje się do niego odpowiednio (art. 42 § 1). Przy zwolnieniach z przyczyn niedotyczących pracowników u pracodawcy zatrudniającego co najmniej 20 osób pracodawca może pracownicy w ciąży i osobie, która złożyła wniosek o urlop macierzyński, ojcowski, rodzicielski albo opiekuńczy, wypowiedzieć tylko warunki pracy i płacy; gdy wynagrodzenie spada, przysługuje dodatek wyrównawczy do końca okresu ochrony (art. 5 ust. 5 pkt 1 i ust. 6 oraz art. 10 ust. 3 ustawy o zwolnieniach).</li>
      <li>Gdy reprezentuje Cię zakładowa organizacja związkowa, pracodawca najpierw zawiadamia ją o zamiarze wypowiedzenia i podaje przyczynę (art. 38 w związku z art. 42 § 1). Przy zwolnieniu grupowym obowiązuje to wtedy, gdy nie zawarto porozumienia ze związkami (art. 5 ust. 2 ustawy o zwolnieniach).</li>
    </ul>

    <h2 id="po-odmowie">Po odmowie</h2>
    <p>
      Umowa rozwiązuje się z końcem okresu wypowiedzenia (art. 42 § 3). Gdy pracodawca zatrudnia co najmniej 20 osób,
      a umowa kończy się z przyczyn niedotyczących pracownika (według Sądu Najwyższego: bez nich do zwolnienia by nie doszło), odprawa
      wynosi 1, 2 albo 3 miesięczne wynagrodzenia zależnie od stażu, najwyżej 15-krotność płacy
      minimalnej (art. 1, 8 i 10 ustawy o zwolnieniach). Kwotę policzy <a href="/narzedzia/kalkulator-odprawy">kalkulator odprawy</a>.
    </p>
    <p>
      Sama odmowa nowych warunków nie odbiera odprawy: Sąd Najwyższy stosuje ustawę także wtedy, gdy umowa kończy się po
      wypowiedzeniu zmieniającym (wyrok z 12 kwietnia 2012 r., I PK 144/11). „Wyłączny powód” rozumie tak, że bez przyczyn
      niedotyczących pracownika do zwolnienia by nie doszło; w wyroku I PK 139/04 (na tle ustawy z 1989 r.) uznał, że to
      samo dotyczy zwolnień grupowych. Rozstrzyga, czy nowe warunki dało się obiektywnie przyjąć. Ocenia to sąd pracy
      w Twojej sprawie, a w nowszych wyrokach Sąd Najwyższy pisze, że po odmowie odprawa należy się tylko wyjątkowo
      (III PK 55/14, I PK 211/14).
    </p>
    <p>Odprawa może się należeć, gdy:</p>
    <ul>
      <li>przyjęcie warunków prowadziłoby do poważnych zmian na Twoją niekorzyść (II PK 340/12), na przykład do radykalnej obniżki pensji za tę samą pracę (I PKN 79/00);</li>
      <li>nowe warunki zmierzały w istocie do rozwiązania umowy albo były obiektywnie nie do przyjęcia (III PK 55/14);</li>
      <li>warunki noszą znamiona szykany albo są wyraźnie niedogodne (I PK 144/11).</li>
    </ul>
    <p>Odmowa może być uznana za współprzyczynę i odprawy wtedy nie ma, gdy:</p>
    <ul>
      <li>z uwagi na interes Twój i pracodawcy oraz rodzaj pracy w zasadzie można było oczekiwać, że warunki przyjmiesz (I PK 144/11, III PK 55/14);</li>
      <li>obniżka była istotna, ale nowa płaca odpowiadała stawkom innych na porównywalnych stanowiskach (I PK 211/14) albo wynikała z ujednolicenia płac w firmie (II PK 340/12).</li>
    </ul>
    <p>Warunki sąd ocenia obiektywnie; same okoliczności osobiste, na przykład kredyt, nie przesądzają (II PK 340/12).</p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { liczPoPowrocie, pokazBlad } from '../../lib/narzedzia/formularz';
  import { ustawDzisiejszeWartosci } from '../../lib/narzedzia/dzis-w-formularzu';
  import { opisZmieniajacego, wypowiedzenieZmieniajace } from '../../lib/narzedzia/wypowiedzenie-zmieniajace';
  import { dzisWPolsce, poprawnaData } from '../../lib/narzedzia/terminy';
  import { typografia } from '../../lib/typografia.mjs';

  const form = document.querySelector<HTMLFormElement>('[data-zmieniajace]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const wiersz = (k: string) => form.querySelector<HTMLElement>(`[data-wiersz="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const POLA = ['odmowa', 'okres', 'koniec', 'nowe', 'ostatni', 'wariant-b', 'odwolanie'];
    const ZDANIA = ['odmowa-zdanie', 'odwolanie-zdanie'];
    const przelicz = () => {
      const start = el('start').value;
      const doreczenie = el('doreczenie').value;
      const b = form.querySelector<HTMLElement>('[data-blad="dane"]')!;
      const status = w('status');
      let blad: string | null = null;
      let pole: HTMLInputElement | null = null;
      if (!poprawnaData(start)) (blad = 'Wpisz datę rozpoczęcia pracy u tego pracodawcy.'), (pole = el('start'));
      else if (!poprawnaData(doreczenie)) (blad = 'Wpisz dzień doręczenia pisma.'), (pole = el('doreczenie'));
      else if (doreczenie < start) (blad = 'Dzień doręczenia nie może być wcześniejszy niż początek pracy.'), (pole = el('doreczenie'));
      pokazBlad(b, blad, pole);
      if (blad) {
        w('odmowa-etykieta').textContent = 'Odmowę złóż najpóźniej';
        w('odwolanie-etykieta').textContent = 'Odwołanie do sądu pracy do';
        for (const k of POLA) w(k).textContent = '—';
        for (const k of ZDANIA) w(k).hidden = true;
        w('prog-wiersz').hidden = true;
        wiersz('odmowa-art115').hidden = true;
        wiersz('odwolanie-art115').hidden = true;
        status.hidden = true;
        w('uwaga').hidden = true;
        return;
      }
      const o = opisZmieniajacego(wypowiedzenieZmieniajace(start, doreczenie, el('pouczenie').checked), dzisWPolsce());
      const pisz = (k: string, t: string) => (w(k).textContent = typografia(t));
      pisz('odmowa-etykieta', o.odmowaEtykieta);
      pisz('odmowa', o.odmowa);
      wiersz('odmowa-art115').hidden = !o.odmowaArt115;
      pisz('odmowa-art115', o.odmowaArt115 ?? '');
      pisz('odmowa-zdanie', o.odmowaZdanie);
      w('odmowa-zdanie').hidden = !o.odmowaZdanie;
      pisz('okres', o.okres);
      w('prog-wiersz').hidden = !o.prog;
      pisz('prog', o.prog ?? '');
      pisz('koniec', o.koniec);
      pisz('nowe', o.nowe);
      pisz('ostatni', o.koniec);
      pisz('wariant-b', o.wariantB);
      pisz('odwolanie-etykieta', o.odwolanieEtykieta);
      pisz('odwolanie', o.odwolanie);
      wiersz('odwolanie-art115').hidden = !o.odwolanieArt115;
      pisz('odwolanie-art115', o.odwolanieArt115 ?? '');
      pisz('odwolanie-zdanie', o.odwolanieZdanie);
      w('odwolanie-zdanie').hidden = !o.odwolanieZdanie;
      w('uwaga').hidden = false;
      pisz('uwaga', o.uwaga);
      status.hidden = false;
      status.dataset.status = o.statusKlasa;
      pisz('status', o.status);
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    ustawDzisiejszeWartosci(form);
    liczPoPowrocie(przelicz);
    przelicz();
  }
</script>
