---
// Świadectwo pracy: termin wydania (art. 97 § 1–1² Kodeksu pracy), sprostowanie (art. 97 § 2¹, § 7 rozporządzenia
// w sprawie świadectwa pracy), pozew o wydanie (art. 97¹), odszkodowanie (art. 99) i treść świadectwa (art. 97 § 2,
// § 2 rozporządzenia). Logika i teksty wyniku: src/lib/narzedzia/swiadectwo-pracy.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { TRESC_SWIADECTWA, opisSwiadectwa } from '../../lib/narzedzia/swiadectwo-pracy';
import { dodajDni, dzisWPolsce } from '../../lib/narzedzia/terminy';

const dzis = dzisWPolsce();
// Przykład startowy: umowa skończyła się 10 dni temu, świadectwo przyszło tego samego dnia (skrypt przestawia daty
// na prawdziwe dziś: data-dzis).
const DNI_USTANIA = -10;
const ustanie = dodajDni(dzis, DNI_USTANIA);
const start = opisSwiadectwa({ ustanie, otrzymanie: ustanie, wynagrodzenie: 5200 }, dzis);

const faq = [
  {
    pytanie: 'Kiedy pracodawca musi wydać świadectwo pracy?',
    odpowiedz: 'W dniu, w którym kończy się stosunek pracy, jeśli pracodawca nie zamierza nawiązać z Tobą kolejnego stosunku pracy w ciągu 7 dni. Gdy z przyczyn obiektywnych nie może go wtedy wydać Tobie albo osobie przez Ciebie upoważnionej, w ciągu 7 dni wysyła je pocztą albo doręcza w inny sposób (art. 97 § 1 Kodeksu pracy). Nie może uzależniać wydania świadectwa od rozliczenia się z nim (art. 97 § 1³).',
  },
  {
    pytanie: 'Ile mam czasu na sprostowanie świadectwa pracy?',
    odpowiedz: 'Wniosek o sprostowanie składasz pracodawcy w ciągu 14 dni od otrzymania świadectwa. Pracodawca w 7 dni od otrzymania wniosku zawiadamia o odmowie albo wydaje nowe świadectwo (§ 7 ust. 1 rozporządzenia w sprawie świadectwa pracy). Po odmowie masz 14 dni od zawiadomienia na pozew do sądu pracy (art. 97 § 2¹ Kodeksu pracy).',
  },
  {
    pytanie: 'Co zrobić, gdy pracodawca nie wydał świadectwa pracy?',
    odpowiedz: 'Możesz wystąpić do sądu pracy z żądaniem zobowiązania pracodawcy do wydania świadectwa, w każdym czasie przed upływem przedawnienia, a gdy pracodawca nie istnieje albo z innych przyczyn pozew przeciw niemu jest niemożliwy, z żądaniem ustalenia prawa do otrzymania świadectwa (art. 97¹ Kodeksu pracy). Niewydanie świadectwa w terminie jest wykroczeniem zagrożonym grzywną od 2000 do 60 000 zł (art. 282 § 1 pkt 3); ściga je Państwowa Inspekcja Pracy (art. 10 ust. 1 pkt 15 ustawy o Państwowej Inspekcji Pracy).',
  },
  {
    pytanie: 'Ile wynosi odszkodowanie za niewydanie świadectwa pracy?',
    odpowiedz: 'Wynagrodzenie za czas pozostawania bez pracy z tego powodu, najwyżej za 6 tygodni (art. 99 § 2 Kodeksu pracy). Liczy się je jak ekwiwalent za urlop (§ 2 ust. 1 pkt 9 rozporządzenia z 29 maja 1996 r.). To samo dotyczy wydania niewłaściwego świadectwa, a wyrok o odszkodowaniu jest podstawą do zmiany świadectwa (art. 99 § 4).',
  },
  {
    pytanie: 'Czy pozew o świadectwo pracy kosztuje?',
    odpowiedz: 'Pracownik, który wnosi pozew do sądu pracy, nie musi uiszczać kosztów sądowych (art. 96 ust. 1 pkt 4 ustawy o kosztach sądowych w sprawach cywilnych). Nie dotyczy to kosztów pełnomocnika pracodawcy: przy przegranej sąd może obciążyć nimi pracownika (art. 98 § 1 Kodeksu postępowania cywilnego), a w wypadkach szczególnie uzasadnionych odstąpić od tego (art. 102). Sprawy o świadectwo pracy rozpatruje sąd rejonowy, a pozew można złożyć w sądzie właściwym dla pracodawcy albo dla miejsca, w którym praca była wykonywana (art. 461 § 1 i § 1¹ Kodeksu postępowania cywilnego).',
  },
];
---

<StronaNarzedzia
  slug="swiadectwo-pracy"
  tytul="Świadectwo pracy: terminy, sprostowanie"
  opis="Kiedy pracodawca musi wydać świadectwo pracy, do kiedy wniosek o sprostowanie i pozew, ile odszkodowania za brak świadectwa i co ma w nim być."
  h1="Świadectwo pracy: terminy, sprostowanie i odszkodowanie"
  lead="Wpisz dzień, w którym skończyła się umowa, i daty z pism o świadectwie. Pokażemy, kiedy pracodawca musiał je wydać, do kiedy możesz żądać sprostowania i ile najwyżej wynosi odszkodowanie."
  faq={faq}
>
  <form class="kalkulator" data-swiadectwo novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Twoje świadectwo</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="s-ustanie" class="etykieta-pola">Ostatni dzień umowy</label>
          <input id="s-ustanie" name="ustanie" type="date" data-dzis={String(DNI_USTANIA)} class="pole mt-1" min="2000-01-01" max="2100-12-31" value={ustanie} aria-describedby="s-blad" />
        </div>
        <div>
          <label for="s-otrzymanie" class="etykieta-pola">Świadectwo otrzymane</label>
          <input id="s-otrzymanie" name="otrzymanie" type="date" data-dzis={String(DNI_USTANIA)} class="pole mt-1" min="2000-01-01" max="2100-12-31" value={ustanie} aria-describedby="s-otrzymanie-opis s-blad" />
          <p id="s-otrzymanie-opis" class="meta mt-1">Puste, gdy świadectwa jeszcze nie masz.</p>
        </div>
        <div>
          <label for="s-wniosek" class="etykieta-pola">Wniosek o sprostowanie doręczony</label>
          <input id="s-wniosek" name="wniosek" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" aria-describedby="s-wniosek-opis s-blad" />
          <p id="s-wniosek-opis" class="meta mt-1">Dzień, w którym pracodawca dostał wniosek; puste, gdy go nie było.</p>
        </div>
        <div>
          <label for="s-odmowa" class="etykieta-pola">Odmowa sprostowania</label>
          <input id="s-odmowa" name="odmowa" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" aria-describedby="s-odmowa-opis s-blad" />
          <p id="s-odmowa-opis" class="meta mt-1">Dzień doręczenia pisma albo e-maila z odmową.</p>
        </div>
        <div>
          <label for="s-wynagrodzenie" class="etykieta-pola">Pensja miesięczna (zł brutto)</label>
          <input id="s-wynagrodzenie" name="wynagrodzenie" class="pole mt-1" type="text" inputmode="decimal" autocomplete="off" value="5200" aria-describedby="s-wynagrodzenie-opis s-blad" />
          <p id="s-wynagrodzenie-opis" class="meta mt-1">Do odszkodowania: stałe składniki i średnia zmiennych, jak przy ekwiwalencie za urlop.</p>
        </div>
      </div>
      <label class="mt-4 flex items-start gap-3 text-[0.9375rem]">
        <input type="checkbox" name="kolejnaUmowa" class="mt-1 size-[1.125rem] flex-none accent-[var(--color-akcent-tekst)]" />
        <span>W ciągu 7 dni zaczynam nową umowę u tego samego pracodawcy</span>
      </label>
      <p id="s-blad" class="blad-pola mt-3" data-blad="dane" role="alert" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Najbliższy termin</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-data" data-w="glowny">{start.glowny}</p>
        <p class="meta" data-w="glowny-opis">{start.glownyOpis}</p>
        <p class="status-terminu" data-w="status" data-status={start.statusKlasa}>{start.status}</p>
      </div>
      <dl class="wynik-lista">
        {start.pozycje.map((p) => <div><dt>{p.etykieta}</dt><dd><span data-w={p.klucz}>{p.wartosc}</span><span class="block font-normal" data-w={`${p.klucz}-opis`}>{p.opis}</span></dd></div>)}
      </dl>
      <div data-w="uwagi">{start.uwagi.map((u) => <p class="wynik-uwaga">{u}</p>)}</div>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Zasady są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="tresc">Co musi być w świadectwie pracy</h2>
    <p>Sprawdź swoje świadectwo z tą listą (art. 97 § 2 Kodeksu pracy i § 2 ust. 1–2 rozporządzenia w sprawie świadectwa pracy). Pozycje, których u Ciebie nie było, na przykład urlop wychowawczy, mogą zostać puste.</p>
    <ul>
      {TRESC_SWIADECTWA.map((t) => <li>{t}</li>)}
    </ul>
    <p>Pracodawca będący agencją pracy tymczasowej wpisuje też każdego pracodawcę użytkownika i okresy pracy u niego (§ 2 ust. 2a rozporządzenia). Gdy sąd uznał, że dyscyplinarka była bezprawna, w świadectwie musi stać, że umowę rozwiązano za wypowiedzeniem przez pracodawcę (art. 97 § 3 Kodeksu pracy).</p>

    <h2 id="zasady">Zasady</h2>
    <ul>
      <li>Świadectwo wydaje się w dniu ustania stosunku pracy; gdy z przyczyn obiektywnych to niemożliwe, pracodawca wysyła je pocztą albo doręcza inaczej w ciągu 7 dni (art. 97 § 1). Przy nowej umowie u tego samego pracodawcy w ciągu 7 dni świadectwo wydaje się tylko na wniosek, w 7 dni od jego złożenia (art. 97 § 1¹–1²).</li>
      <li>Wniosek o sprostowanie: 14 dni od otrzymania świadectwa. Pracodawca odpowiada w 7 dni od otrzymania wniosku (§ 7 ust. 1 rozporządzenia). Po odmowie pozew do sądu pracy w 14 dni od zawiadomienia; gdy pracodawca nie zawiadomi o odmowie, żądanie sprostowania wnosi się do sądu pracy (art. 97 § 2¹).</li>
      <li>Gdy termin minął bez Twojej winy, sąd pracy może go przywrócić na wniosek złożony w 7 dni od ustania przyczyny spóźnienia (art. 265 § 1–2).</li>
      <li>Pozew o zobowiązanie do wydania świadectwa, a gdy pracodawca nie istnieje albo pozew przeciw niemu jest z innych przyczyn niemożliwy, o ustalenie prawa do świadectwa: w każdym czasie przed przedawnieniem (art. 97¹ § 1–3); to samo stosuje się do żądania sprostowania (art. 97¹ § 4).</li>
      <li>Odszkodowanie za niewydanie w terminie albo wydanie niewłaściwego świadectwa: wynagrodzenie za czas bez pracy z tego powodu, nie dłuższy niż 6 tygodni (art. 99 § 1–2).</li>
    </ul>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Terminy w dniach liczymy od dnia po zdarzeniu, na przykład po dniu otrzymania świadectwa (art. 111 § 2 Kodeksu
      cywilnego przez art. 300 Kodeksu pracy). Wniosek do pracodawcy bezpieczniej uznać za złożony dopiero wtedy, gdy do
      niego dotrze, więc ostatni dzień to dzień, w którym wniosek powinien już być u pracodawcy. Gdy ostatni dzień wypada w sobotę, niedzielę albo święto, nie jest
      przesądzone, czy termin z Kodeksu pracy przesuwa się na następny dzień roboczy (art. 115 Kodeksu cywilnego). Dlatego
      jako ostatni dzień podajemy datę bez przesunięcia, czyli najwcześniejszą, której dotrzymanie jest bezpieczne, a datę
      po przesunięciu tylko w dopisku. Kalkulator <a href="/narzedzia/odwolanie-do-sadu-pracy">odwołania do sądu pracy</a> przesuwa takie terminy; tu liczymy ostrożniej.
    </p>
    <p>
      Gdy pracodawca nie zawiadomi o odmowie sprostowania, przepis nie podaje terminu na pozew, a art. 97¹ § 3–4 pozwala
      wnieść żądanie w każdym czasie przed przedawnieniem. Ostrożnie podajemy 14 dni od końca 7 dni, które pracodawca ma na
      odpowiedź, tak jak po odmowie. Przedawnienie to 3 lata od dnia, w którym roszczenie stało się wymagalne (art. 291 § 1
      Kodeksu pracy); liczymy je od ostatniego dnia umowy, bo wtedy świadectwo należało wydać, a koniec wyznaczamy jak inne
      terminy w latach: 29 lutego przechodzi na 28 lutego (art. 112 Kodeksu cywilnego).
    </p>
    <p>
      Odszkodowanie liczy się według zasad ekwiwalentu za urlop (§ 2 ust. 1 pkt 9 rozporządzenia z 29 maja 1996 r.), ale
      rozporządzenie nie mówi, ile miesięcznej kwoty odpowiada 6 tygodniom. Przyjmujemy 1,5 miesięcznej kwoty, tak jak
      rozporządzenie liczy 2 tygodnie jako połowę miesiąca w innych odszkodowaniach (§ 2 ust. 2). Inne odczytanie to
      wynagrodzenie za 30 dni pracy w 6 tygodniach, czyli miesięczna kwota podzielona przez współczynnik z § 19
      rozporządzenia urlopowego (w 2026 r. 251/12) i pomnożona przez 30 (§ 2a): dla 5200 zł około 7458 zł zamiast 7800 zł.
      Obie kwoty to górna granica; sąd przyznaje wynagrodzenie za czas, w którym naprawdę pozostawało się bez pracy z
      powodu świadectwa. Jak policzyć pensję do ekwiwalentu, pokaże <a href="/narzedzia/ekwiwalent-za-urlop">kalkulator ekwiwalentu za urlop</a>, a sądy i inspekcję pracy porówna <a href="/narzedzia/sad-pracy-czy-pip">strona o sądzie pracy i PIP</a>.
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { opisSwiadectwa, bladSwiadectwa, type DaneSwiadectwa } from '../../lib/narzedzia/swiadectwo-pracy';
  import { wpisanaLiczba } from '../../lib/narzedzia/format';
  import { dzisWPolsce } from '../../lib/narzedzia/terminy';
  import { ustawDzisiejszeWartosci } from '../../lib/narzedzia/dzis-w-formularzu';
  import { typografia } from '../../lib/typografia.mjs';
  import { liczPoPowrocie, pokazBlad } from '../../lib/narzedzia/formularz';

  const form = document.querySelector<HTMLFormElement>('[data-swiadectwo]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const pisz = (k: string, tekst: string) => {
      const t = typografia(tekst);
      if (w(k).textContent !== t) w(k).textContent = t;
    };
    const blad = form.querySelector<HTMLElement>('[data-blad="dane"]')!;
    const przelicz = () => {
      const pensja = el('wynagrodzenie').value.trim();
      const dane: DaneSwiadectwa = {
        ustanie: el('ustanie').value,
        otrzymanie: el('otrzymanie').value,
        wniosek: el('wniosek').value,
        odmowa: el('odmowa').value,
        kolejnaUmowa: el('kolejnaUmowa').checked,
        wynagrodzenie: pensja === '' ? undefined : wpisanaLiczba(pensja),
      };
      // Pole daty z niepełną datą ma pustą wartość, ale nie jest puste: traktujemy to jako błąd.
      const NIEPELNA = { ustanie: 'Wpisz pełną datę ostatniego dnia umowy.', otrzymanie: 'Wpisz pełną datę otrzymania świadectwa albo wyczyść pole.', wniosek: 'Wpisz pełną datę doręczenia wniosku albo wyczyść pole.', odmowa: 'Wpisz pełną datę odmowy albo wyczyść pole.' };
      const niepelne = (['ustanie', 'otrzymanie', 'wniosek', 'odmowa'] as const).find((n) => el(n).validity.badInput);
      const dzis = dzisWPolsce();
      const b = niepelne ? { pole: niepelne, tekst: NIEPELNA[niepelne] } : bladSwiadectwa(dane, dzis);
      pokazBlad(blad, b?.tekst, b ? el(b.pole) : []);
      const status = w('status');
      if (b) {
        w('glowny').textContent = '—';
        w('glowny-opis').textContent = '';
        status.hidden = true;
        for (const k of ['wydanie', 'sprostowanie', 'odpowiedz', 'pozew', 'wydanie-sad', 'odszkodowanie']) {
          w(k).textContent = '—';
          w(`${k}-opis`).textContent = '';
        }
        return;
      }
      const o = opisSwiadectwa(dane, dzis);
      pisz('glowny', o.glowny);
      pisz('glowny-opis', o.glownyOpis);
      status.hidden = false;
      status.dataset.status = o.statusKlasa;
      pisz('status', o.status);
      for (const p of o.pozycje) {
        pisz(p.klucz, p.wartosc);
        pisz(`${p.klucz}-opis`, p.opis);
      }
      const uwagi = w('uwagi');
      const teksty = o.uwagi.map((u) => typografia(u));
      if ([...uwagi.children].map((x) => x.textContent).join('\n') !== teksty.join('\n')) {
        uwagi.replaceChildren(
          ...teksty.map((tekst) => {
            const p = document.createElement('p');
            p.className = 'wynik-uwaga';
            p.textContent = tekst;
            return p;
          }),
        );
      }
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    // Niepełna data w pustym polu nie wywołuje input ani change (Chromium): sprawdzamy przy opuszczeniu pola.
    form.addEventListener('focusout', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    ustawDzisiejszeWartosci(form);
    liczPoPowrocie(przelicz);
    przelicz();
  }
</script>
