---
// Kalkulator dni roboczych: liczba dni od poniedziałku do piątku bez świąt (ustawa o dniach wolnych od pracy) i data po
// N dniach roboczych. Logika: src/lib/narzedzia/dni-robocze.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { dniRobocze, poDniachRoboczych } from '../../lib/narzedzia/dni-robocze';
import { dataPoPolsku, dodajDni, dzisWPolsce } from '../../lib/narzedzia/terminy';

const dzis = dzisWPolsce();
const D = { od: dzis, do: dodajDni(dzis, 30), n: 10 };
const r = dniRobocze(D.od, D.do);
const rok = Number(dzis.slice(0, 4));
/** „z 1 dnia kalendarzowego”, „z 31 dni kalendarzowych”; „Po 1 dniu roboczym”, „Po 10 dniach roboczych”. */
const zDni = (n: number) => (n === 1 ? 'z 1 dnia kalendarzowego' : `z ${n} dni kalendarzowych`);
const poDniach = (n: number) => (n === 1 ? 'Po 1 dniu roboczym' : `Po ${n} dniach roboczych`);
const roczne = [rok, rok + 1].map((x) => ({ rok: x, robocze: dniRobocze(`${x}-01-01`, `${x}-12-31`).robocze }));

const faq = [
  {
    pytanie: 'Ile jest dni roboczych w roku?',
    odpowiedz: `Dni od poniedziałku do piątku, nie licząc świąt z ustawy o dniach wolnych od pracy, jest: ${roczne.map((x) => `w ${x.rok} r. ${x.robocze}`).join(', ')}. Święto w sobotę obniża wymiar czasu pracy o 8 godzin (art. 130 § 2 Kodeksu pracy), a dzień wolny za nie wyznacza pracodawca, więc u Ciebie dni pracy może być o tyle mniej.`,
  },
  {
    pytanie: 'Czy sobota jest dniem roboczym?',
    odpowiedz: 'Przepisy nie definiują ogólnie „dnia roboczego”. Kalkulator przyjmuje, jak zwykle w kadrach, dni od poniedziałku do piątku bez świąt. W terminach z Kodeksu cywilnego sobota jest traktowana jak dzień wolny: termin kończący się w sobotę albo w dzień ustawowo wolny upływa następnego dnia, który nie jest dniem wolnym ani sobotą (art. 115 Kodeksu cywilnego). Gdy u Ciebie sobota jest dniem pracy, zaznacz to w kalkulatorze.',
  },
  {
    pytanie: 'Jakie dni są ustawowo wolne od pracy?',
    odpowiedz: 'Niedziele i 14 świąt: 1 stycznia, 6 stycznia, Wielkanoc i Poniedziałek Wielkanocny, 1 i 3 maja, Zielone Świątki, Boże Ciało, 15 sierpnia, 1 i 11 listopada oraz od 2025 r. 24 grudnia, a także 25 i 26 grudnia (art. 1 ustawy o dniach wolnych od pracy).',
  },
];
---
<StronaNarzedzia
  slug="dni-robocze"
  tytul="Kalkulator dni roboczych: ile dni między datami"
  opis="Policz dni robocze między datami bez weekendów i świąt, z sobotą albo bez, i sprawdź, jaka data wypada po 10, 14 albo 30 dniach roboczych."
  h1="Kalkulator dni roboczych"
  lead="Wpisz dwie daty, a policzymy dni robocze bez sobót, niedziel i świąt. Podamy też, jaki dzień wypada po wybranej liczbie dni roboczych od daty początkowej."
  faq={faq}
>
  <form class="kalkulator" data-robocze novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Daty</h2>
      <div class="mt-4 grid grid-cols-1 items-end gap-3 min-[380px]:grid-cols-2">
        <div>
          <label for="r-od" class="etykieta-pola">Od</label>
          <input id="r-od" name="od" type="date" data-dzis class="pole mt-1" min="2000-01-01" max="2100-12-31" value={D.od} aria-describedby="r-blad" />
        </div>
        <div>
          <label for="r-do" class="etykieta-pola">Do</label>
          <input id="r-do" name="do" type="date" data-dzis="30" class="pole mt-1" min="2000-01-01" max="2100-12-31" value={D.do} aria-describedby="r-blad" />
        </div>
      </div>
      <p class="meta mt-1">Oba dni liczymy włącznie.</p>
      <div class="mt-4">
        <label for="r-n" class="etykieta-pola">Dni roboczych od daty „Od”</label>
        <input id="r-n" name="n" class="pole mt-1 max-w-24" type="text" inputmode="numeric" autocomplete="off" value={D.n} aria-describedby="r-n-opis r-blad" />
        <p id="r-n-opis" class="meta mt-1">Liczymy od następnego dnia, jak terminy w dniach (art. 111 § 2 Kodeksu cywilnego).</p>
      </div>
      <label class="mt-4 flex items-start gap-3 text-[0.9375rem]">
        <input type="checkbox" name="soboty" class="mt-1 size-[1.125rem] flex-none accent-[var(--color-akcent-tekst)]" />
        <span>Soboty są u mnie dniami pracy</span>
      </label>
      <p id="r-blad" class="blad-pola mt-3" data-blad="dane" role="alert" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Dni robocze</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-kwota"><span data-w="robocze">{r.robocze}</span></p>
        <p class="meta" data-w="opis">{zDni(r.kalendarzowe)}</p>
      </div>
      <dl class="wynik-lista">
        <div><dt>Soboty i niedziele</dt><dd data-w="weekendy">{r.soboty} i {r.niedziele}</dd></div>
        <div><dt>Święta w tym czasie</dt><dd data-w="swieta">{r.swieta.length ? r.swieta.map((s) => `${dataPoPolsku(s.data)} (${s.nazwa})`).join(', ') : 'brak'}</dd></div>
        <div><dt data-w="po-etykieta">{poDniach(D.n)}</dt><dd data-w="po">{dataPoPolsku(poDniachRoboczych(D.od, D.n))}</dd></div>
      </dl>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="rok">Dni robocze w roku</h2>
    <div class="tabela">
      <table>
        <caption class="sr-only">Liczba dni roboczych w roku, od poniedziałku do piątku bez świąt</caption>
        <thead><tr><th scope="col">Rok</th><th scope="col">Dni robocze</th></tr></thead>
        <tbody>{roczne.map((x) => <tr><th scope="row">{x.rok}</th><td>{x.robocze}</td></tr>)}</tbody>
      </table>
    </div>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Dzień roboczy to dzień od poniedziałku do piątku, który nie jest świętem z art. 1 pkt 1 ustawy o dniach wolnych
      od pracy; po zaznaczeniu także sobota. Ile godzin pracy wypada w miesiącu i jak liczy się święto w sobotę, pokaże <a href="/narzedzia/wymiar-czasu-pracy">kalkulator wymiaru czasu pracy</a>, a długie weekendy i plan urlopu <a href="/narzedzia/dni-wolne-od-pracy">kalendarz dni wolnych</a>. Terminy do sądu pracy liczy <a href="/narzedzia/odwolanie-do-sadu-pracy">kalkulator odwołania</a>, bo tam obowiązują inne zasady.
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { dniRobocze, poDniachRoboczych } from '../../lib/narzedzia/dni-robocze';
  import { dataPoPolsku, dniMiedzy, poprawnaData } from '../../lib/narzedzia/terminy';
  import { typografia } from '../../lib/typografia.mjs';
  import { ustawDzisiejszeWartosci } from '../../lib/narzedzia/dzis-w-formularzu';
  import { liczPoPowrocie, pokazBlad } from '../../lib/narzedzia/formularz';

  const form = document.querySelector<HTMLFormElement>('[data-robocze]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const przelicz = () => {
      const od = el('od').value;
      const do_ = el('do').value;
      const tekstN = el('n').value.trim();
      const n = /^\d{1,4}$/.test(tekstN) ? Number(tekstN) : NaN;
      const soboty = el('soboty').checked;
      let blad: string | null = null;
      let zle: HTMLInputElement[] = [];
      if (!poprawnaData(od) || !poprawnaData(do_)) {
        blad = 'Wpisz obie daty.';
        zle = [el('od'), el('do')].filter((p) => !poprawnaData(p.value));
      } else if (do_ < od) {
        blad = 'Data „Do” nie może być przed datą „Od”.';
        zle = [el('do')];
      } else if (dniMiedzy(od, do_) + 1 > 3660) {
        blad = 'Kalkulator liczy najwyżej 10 lat.';
        zle = [el('do')];
      } else if (!(n >= 1 && n <= 2000)) {
        blad = 'Liczba dni roboczych: od 1 do 2000.';
        zle = [el('n')];
      }
      pokazBlad(form.querySelector<HTMLElement>('[data-blad="dane"]')!, blad, zle);
      if (blad) {
        w('robocze').textContent = '—';
        w('opis').textContent = '';
        return;
      }
      const r = dniRobocze(od, do_, soboty);
      w('robocze').textContent = String(r.robocze);
      w('opis').textContent = typografia(r.kalendarzowe === 1 ? 'z 1 dnia kalendarzowego' : `z ${r.kalendarzowe} dni kalendarzowych`);
      w('weekendy').textContent = `${r.soboty} i ${r.niedziele}`;
      w('swieta').textContent = typografia(r.swieta.length ? r.swieta.map((s) => `${dataPoPolsku(s.data)} (${s.nazwa})`).join(', ') : 'brak');
      w('po-etykieta').textContent = typografia(n === 1 ? 'Po 1 dniu roboczym' : `Po ${n} dniach roboczych`);
      w('po').textContent = typografia(dataPoPolsku(poDniachRoboczych(od, n, soboty)));
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    ustawDzisiejszeWartosci(form);
    liczPoPowrocie(przelicz);
    przelicz();
  }
</script>
