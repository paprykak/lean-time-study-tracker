---
// Urlop szkoleniowy i zwolnienia na naukę (art. 103^1–103^4 i 103^6 Kp): ile dni i godzin urlopu szkoleniowego,
// jakie inne uprawnienia. Zwrot kosztów (art. 103^5) liczy zwrot-kosztow-szkolenia. Logika:
// src/lib/narzedzia/urlop-szkoleniowy.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { MAKS_EGZAMINOW, NAZWA, WYMIAR, urlopSzkoleniowy, type Egzamin } from '../../lib/narzedzia/urlop-szkoleniowy';
import { godzinyIMinuty } from '../../lib/narzedzia/czas-pracy';
import { odmiana } from '../../lib/redakcja';

const D = { zaZgoda: true, egzaminy: { zawodowy: 1 } as Partial<Record<Egzamin, number>>, zmiana: 12 };
const r = urlopSzkoleniowy(D);
const DNI: [string, string, string] = ['dzień', 'dni', 'dni'];
/** Egzaminy z art. 103^2 § 1 pkt 1–3: pole z liczbą egzaminów. */
const EGZ: { e: Egzamin; etykieta: string }[] = [
  { e: 'eksternistyczny', etykieta: 'Eksternistyczny' },
  { e: 'maturalny', etykieta: 'Maturalny' },
  { e: 'zawodowy', etykieta: 'Zawodowy' },
];
const ZMIANY = [8, 10, 12];
const pozycje = r.pozycje.map((p) => `${NAZWA[p.egzamin]}: ${odmiana(p.dni, DNI)}`).join('; ');

const faq = [
  {
    pytanie: 'Ile dni urlopu szkoleniowego na studia?',
    odpowiedz: `${WYMIAR.studia} dni w ostatnim roku studiów, na przygotowanie pracy dyplomowej oraz przygotowanie się i przystąpienie do egzaminu dyplomowego (art. 103^2 § 1 pkt 4 Kodeksu pracy). We wcześniejszych latach przepis nie daje dni urlopu szkoleniowego, ale przysługuje zwolnienie z całości lub części dnia pracy na dojazd na obowiązkowe zajęcia i na czas ich trwania (art. 103^1 § 2 pkt 2). Oba uprawnienia dotyczą nauki z inicjatywy pracodawcy albo za jego zgodą (art. 103^1 § 1).`,
  },
  {
    pytanie: 'Czy urlop szkoleniowy jest płatny?',
    odpowiedz: 'Tak. Za czas urlopu szkoleniowego oraz zwolnienia z całości lub części dnia pracy zachowujesz prawo do wynagrodzenia (art. 103^1 § 3 Kodeksu pracy). Opłaty za naukę, przejazd, podręczniki i zakwaterowanie pracodawca może pokryć, ale przepis go do tego nie zobowiązuje (art. 103^3).',
  },
  {
    pytanie: 'Czy urlop szkoleniowy przysługuje bez zgody pracodawcy?',
    odpowiedz: 'Nie. Urlop szkoleniowy i płatne zwolnienie na obowiązkowe zajęcia przysługują przy podnoszeniu kwalifikacji, czyli nauce z inicjatywy pracodawcy albo za jego zgodą (art. 103^1 § 1–2 Kodeksu pracy). Przy nauce na innych zasadach mogą Ci być przyznane zwolnienie z całości lub części dnia pracy bez wynagrodzenia i urlop bezpłatny, w wymiarze ustalonym w porozumieniu z pracodawcą (art. 103^6). O urlop bezpłatny możesz też złożyć wniosek, a pracodawca może go udzielić (art. 174 § 1).',
  },
  {
    pytanie: 'Ile godzin urlopu szkoleniowego przy zmianach 12 godzin?',
    odpowiedz: `Urlopu szkoleniowego udziela się w dni, które są dla Ciebie dniami pracy według rozkładu czasu pracy (art. 103^2 § 2 Kodeksu pracy). Przepis nie przelicza tych dni na 8 godzin, jak robi to art. 154^2 § 2 przy urlopie wypoczynkowym. Odczytujemy to tak, że 6 dni to 6 zmian, czyli ${6 * 12} godzin, a ${WYMIAR.studia} dni w ostatnim roku studiów to ${WYMIAR.studia * 12} godzin. Przy zmianach różnej długości liczą się dni, nie godziny.`,
  },
  {
    pytanie: 'Czy na studia podyplomowe albo kurs przysługuje urlop szkoleniowy?',
    odpowiedz: 'Art. 103^2 § 1 Kodeksu pracy wymienia tylko egzaminy eksternistyczne, egzamin maturalny, egzamin potwierdzający kwalifikacje w zawodzie lub egzamin zawodowy oraz ostatni rok studiów. Kursów tam nie ma, a przepis nie rozstrzyga wprost, czy ostatni rok studiów obejmuje studia podyplomowe. Przy nauce za zgodą pracodawcy zostaje zwolnienie z pracy na obowiązkowe zajęcia z zachowaniem wynagrodzenia (art. 103^1 § 2 pkt 2 i § 3).',
  },
  {
    pytanie: 'Czy pracodawca musi podpisać ze mną umowę o podnoszenie kwalifikacji?',
    odpowiedz: 'Pracodawca zawiera z Tobą umowę na piśmie, która nie może być mniej korzystna niż przepisy Kodeksu pracy o podnoszeniu kwalifikacji (art. 103^4 § 1–2). Nie ma obowiązku jej zawarcia, jeżeli pracodawca nie zamierza zobowiązać Cię do pozostania w pracy po nauce (art. 103^4 § 3). Urlop szkoleniowy i zwolnienie na obowiązkowe zajęcia wynikają z przepisu, nie z umowy (art. 103^1 § 2).',
  },
];
---
<StronaNarzedzia
  slug="urlop-szkoleniowy"
  tytul="Urlop szkoleniowy: ile dni i godzin na naukę"
  opis="Ile dni urlopu szkoleniowego masz przed maturą, egzaminem zawodowym i w ostatnim roku studiów, ile to godzin przy Twojej zmianie i co bez zgody pracodawcy."
  h1="Urlop szkoleniowy i zwolnienia na naukę"
  lead="Uczysz się za zgodą pracodawcy? Wpisz, do jakich egzaminów przystępujesz, i długość zmiany, a policzymy dni i godziny urlopu szkoleniowego oraz pokażemy, co jeszcze Ci przysługuje."
  faq={faq}
>
  <form class="kalkulator" data-szkoleniowy novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Twoja nauka</h2>
      <fieldset class="mt-4">
        <legend class="etykieta-pola">Uczysz się za zgodą albo z inicjatywy pracodawcy?</legend>
        <div class="przelacznik mt-2">
          <label for="s-zgoda-tak"><input id="s-zgoda-tak" type="radio" name="zgoda" value="tak" checked /> Tak</label>
          <label for="s-zgoda-nie"><input id="s-zgoda-nie" type="radio" name="zgoda" value="nie" /> Nie</label>
        </div>
      </fieldset>

      <fieldset class="mt-5">
        <legend class="etykieta-pola">Do jakich egzaminów przystępujesz?</legend>
        <p id="s-egz-opis" class="meta mt-1">Liczba egzaminów każdego rodzaju, od 0 do {MAKS_EGZAMINOW}; po {WYMIAR.zawodowy} dni do każdego. Zawodowy obejmuje też egzamin potwierdzający kwalifikacje w zawodzie.</p>
        <div class="mt-2 grid grid-cols-3 items-end gap-3">
          {EGZ.map(({ e, etykieta }) => (
            <div>
              <label for={`s-${e}`} class="meta">{etykieta}</label>
              <input id={`s-${e}`} name={e} class="pole mt-1" type="text" inputmode="numeric" autocomplete="off" value={D.egzaminy[e] ?? 0} aria-describedby="s-egz-opis s-blad" />
            </div>
          ))}
        </div>
        <label for="s-studia" class="mt-4 flex items-start gap-3 text-[0.9375rem]">
          <input id="s-studia" type="checkbox" name="studia" class="mt-1 size-[1.125rem] flex-none accent-[var(--color-akcent-tekst)]" />
          <span>Ostatni rok studiów (praca i egzamin dyplomowy): {WYMIAR.studia} dni</span>
        </label>
      </fieldset>

      <fieldset class="mt-5">
        <legend class="etykieta-pola">Długość Twojej zmiany</legend>
        <div class="przelacznik mt-2">
          {ZMIANY.map((h) => (
            <label for={`s-zmiana-${h}`}><input id={`s-zmiana-${h}`} type="radio" name="zmiana" value={h} checked={h === D.zmiana} /> {h} h</label>
          ))}
          <label for="s-zmiana-inna"><input id="s-zmiana-inna" type="radio" name="zmiana" value="inna" /> Inna</label>
        </div>
        <div class="mt-3" data-inna hidden>
          <label for="s-inna" class="meta">Godziny na zmianie</label>
          <input id="s-inna" name="inna" class="pole mt-1 max-w-40" type="text" inputmode="decimal" autocomplete="off" value="7,5" aria-describedby="s-blad" />
        </div>
      </fieldset>
      <p id="s-blad" class="blad-pola mt-3" data-blad="dane" role="alert" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Urlop szkoleniowy do tych egzaminów</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-kwota" data-w="dni">{odmiana(r.dni, DNI)}</p>
        <p class="meta" data-w="opis">{godzinyIMinuty(r.godziny)} przy zmianie {godzinyIMinuty(D.zmiana)} (przy różnych zmianach w grafiku licz dni, nie godziny)</p>
      </div>
      <dl class="wynik-lista">
        <div><dt>Z czego</dt><dd data-w="pozycje">{pozycje}</dd></div>
        <div><dt>Wynagrodzenie</dt><dd data-w="placa">zachowujesz prawo do wynagrodzenia</dd></div>
      </dl>
      <div data-gdy="tak">
        <p class="wynik-uwaga">W naszym odczytaniu art. 103<sup>2</sup> § 2 każdy dzień urlopu szkoleniowego to cała zmiana z grafiku.</p>
        <p class="etykieta mt-4">Przysługuje Ci też</p>
        <p class="wynik-uwaga">Zwolnienie z całości lub części dnia pracy na dojazd na obowiązkowe zajęcia i na czas ich trwania, z zachowaniem wynagrodzenia (art. 103<sup>1</sup> § 2 pkt 2 i § 3).</p>
        <p class="etykieta mt-4">Warto wiedzieć</p>
        <ul class="wynik-uwaga">
          <li>pracodawca zawiera z Tobą umowę na piśmie, nie mniej korzystną niż przepisy; nie musi, gdy nie zobowiązuje Cię do pozostania w pracy (art. 103<sup>4</sup>);</li>
          <li>pracodawca może pokryć opłaty za naukę, przejazd, podręczniki i zakwaterowanie (art. 103<sup>3</sup>).</li>
        </ul>
      </div>
      <div data-gdy="nie" hidden>
        <p class="etykieta mt-4">Bez zgody pracodawcy</p>
        <ul class="wynik-uwaga">
          <li>urlop szkoleniowy i płatne zwolnienie na obowiązkowe zajęcia nie przysługują (art. 103<sup>1</sup> § 1–2);</li>
          <li>mogą Ci być przyznane zwolnienie z całości lub części dnia pracy bez wynagrodzenia i urlop bezpłatny, w wymiarze ustalonym w porozumieniu z pracodawcą (art. 103<sup>6</sup>);</li>
          <li>o urlop bezpłatny możesz złożyć wniosek, a pracodawca może go udzielić (art. 174 § 1).</li>
        </ul>
      </div>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Zasady są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="zasady">Co przysługuje przy nauce</h2>
    <div class="tabela">
      <table>
        <caption class="sr-only">Uprawnienia pracownika przy nauce za zgodą pracodawcy i bez niej</caption>
        <thead><tr><th scope="col">Uprawnienie</th><th scope="col">Za zgodą albo z inicjatywy pracodawcy</th><th scope="col">Na innych zasadach</th></tr></thead>
        <tbody>
          <tr><th scope="row">Urlop szkoleniowy</th><td>6 dni do egzaminu, 21 dni w ostatnim roku studiów (art. 103<sup>2</sup> § 1)</td><td>nie</td></tr>
          <tr><th scope="row">Zwolnienie na obowiązkowe zajęcia</th><td>z wynagrodzeniem (art. 103<sup>1</sup> § 2 pkt 2 i § 3)</td><td>bez wynagrodzenia, jeśli zostanie przyznane (art. 103<sup>6</sup> pkt 1)</td></tr>
          <tr><th scope="row">Urlop bezpłatny</th><td>nie ma go w art. 103<sup>1</sup>–103<sup>5</sup>; na Twój wniosek pracodawca może go udzielić (art. 174 § 1)</td><td>jeśli zostanie przyznany (art. 103<sup>6</sup> pkt 2)</td></tr>
          <tr><th scope="row">Opłaty za naukę, przejazd, podręczniki</th><td>pracodawca może je pokryć (art. 103<sup>3</sup>)</td><td>nie ma ich w art. 103<sup>6</sup></td></tr>
        </tbody>
      </table>
    </div>
    <p>
      Podnoszenie kwalifikacji to zdobywanie lub uzupełnianie wiedzy i umiejętności z inicjatywy pracodawcy albo za jego
      zgodą (art. 103<sup>1</sup> § 1 Kodeksu pracy). Wymiar urlopu przy nauce na innych zasadach ustala porozumienie
      z pracodawcą (art. 103<sup>6</sup>). Kiedy trzeba oddać pracodawcy koszty dodatkowych świadczeń na naukę
      (art. 103<sup>5</sup>), policzy <a href="/narzedzia/zwrot-kosztow-szkolenia">kalkulator lojalki</a>.
    </p>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Dni bierzemy z art. 103<sup>2</sup> § 1: po 6 dni do egzaminów eksternistycznych, do matury i do egzaminu
      potwierdzającego kwalifikacje w zawodzie lub egzaminu zawodowego oraz 21 dni w ostatnim roku studiów. Gdy
      przystępujesz do dwóch różnych egzaminów, na przykład do matury i egzaminu zawodowego, dodajemy dni: każdy punkt
      przepisu przyznaje urlop „dla pracownika przystępującego do” danego egzaminu, ale przepis nie mówi o sumowaniu
      wprost. Przepis nie rozstrzyga też, czy każde kolejne przystąpienie do egzaminu tego samego rodzaju daje nowe
      6 dni; liczymy 6 dni do każdego egzaminu, który wpiszesz. Ostatni rok studiów liczymy raz.
    </p>
    <p>
      Urlopu szkoleniowego udziela się w dni, które są dla Ciebie dniami pracy zgodnie z rozkładem czasu pracy
      (art. 103<sup>2</sup> § 2). W odróżnieniu od urlopu wypoczynkowego, gdzie dzień urlopu odpowiada 8 godzinom pracy
      (art. 154<sup>2</sup> § 2), ten przepis nie przelicza dni na godziny. Odczytujemy go więc tak, że dzień urlopu
      szkoleniowego to cała zmiana z Twojego grafiku: godziny to dni razy długość zmiany (w pełnych minutach), przy
      12 godzinach 6 dni to 72 godziny, a nie 48. Przy zmianach różnej długości liczą się dni, nie godziny. Ile dni
      urlopu wypoczynkowego Ci przysługuje, policzy <a href="/narzedzia/kalkulator-urlopu">kalkulator urlopu</a>.
    </p>
    <p>
      Przepis nie mówi, kiedy urlop szkoleniowy wziąć, na przykład czy bezpośrednio przed egzaminem, więc narzędzie tego
      nie ustala. Nie liczy też czasu zwolnień na obowiązkowe zajęcia, bo zależy od planu zajęć i dojazdu
      (art. 103<sup>1</sup> § 2 pkt 2).
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { MAKS_EGZAMINOW, NAZWA, urlopSzkoleniowy, type Egzamin } from '../../lib/narzedzia/urlop-szkoleniowy';
  import { godzinyIMinuty } from '../../lib/narzedzia/czas-pracy';
  import { wpisanaLiczba } from '../../lib/narzedzia/format';
  import { odmiana } from '../../lib/redakcja';
  import { typografia } from '../../lib/typografia.mjs';

  const form = document.querySelector<HTMLFormElement>('[data-szkoleniowy]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const pisz = (k: string, tekst: string) => {
      w(k).textContent = typografia(tekst);
    };
    const wybrane = (n: string) => form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value ?? '';
    const RODZAJE: [Egzamin, string][] = [
      ['eksternistyczny', 'egzaminów eksternistycznych'],
      ['maturalny', 'egzaminów maturalnych'],
      ['zawodowy', 'egzaminów zawodowych'],
    ];
    const przelicz = () => {
      const zaZgoda = wybrane('zgoda') !== 'nie';
      const tryb = wybrane('zmiana');
      form.querySelector<HTMLElement>('[data-inna]')!.hidden = tryb !== 'inna';
      for (const x of form.querySelectorAll<HTMLElement>('[data-gdy]')) x.hidden = x.dataset.gdy !== (zaZgoda ? 'tak' : 'nie');
      for (const x of form.querySelectorAll<HTMLInputElement>('.pole')) x.removeAttribute('aria-invalid');

      // Bez zgody pracodawcy liczba egzaminów i długość zmiany nie mają znaczenia: nie sprawdzamy ich.
      let blad: string | null = null;
      let zlePole: HTMLInputElement | null = null;
      const egzaminy: Partial<Record<Egzamin, number>> = { studia: el('studia').checked ? 1 : 0 };
      let zmiana = 0;
      if (zaZgoda) {
        for (const [e, dopelniacz] of RODZAJE) {
          const n = wpisanaLiczba(el(e).value || '0');
          if (!Number.isInteger(n) || n > MAKS_EGZAMINOW) {
            blad ??= `Liczba ${dopelniacz}: wpisz liczbę od 0 do ${MAKS_EGZAMINOW}.`;
            zlePole ??= el(e);
          } else egzaminy[e] = n;
        }
        zmiana = tryb === 'inna' ? wpisanaLiczba(el('inna').value) : Number(tryb);
        if (!blad) {
          if (!Number.isFinite(zmiana)) blad = 'Wpisz długość zmiany w godzinach, np. 7,5.';
          else if (zmiana <= 0) blad = 'Zmiana musi trwać więcej niż 0 godzin.';
          else if (zmiana > 24) blad = 'Zmiana nie może trwać dłużej niż 24 godziny.';
          if (blad) zlePole = el('inna');
        }
      }
      const b = form.querySelector<HTMLElement>('[data-blad="dane"]')!;
      b.hidden = !blad;
      b.textContent = typografia(blad ?? '');
      if (zlePole) zlePole.setAttribute('aria-invalid', 'true');
      if (blad) {
        w('dni').textContent = '—';
        w('opis').textContent = '';
        w('pozycje').textContent = '—';
        return;
      }
      const r = urlopSzkoleniowy({ zaZgoda, egzaminy, zmiana });
      pisz('dni', odmiana(r.dni, ['dzień', 'dni', 'dni']));
      if (!zaZgoda) {
        pisz('opis', 'Urlop szkoleniowy przysługuje tylko przy nauce z inicjatywy albo za zgodą pracodawcy');
        pisz('pozycje', 'nie dotyczy');
        pisz('placa', 'zwolnienie bez wynagrodzenia i urlop bezpłatny, jeśli je uzgodnisz');
        return;
      }
      pisz('placa', 'zachowujesz prawo do wynagrodzenia');
      if (!r.dni) {
        pisz('opis', 'Bez egzaminu z listy nie ma dni urlopu szkoleniowego, ale zostaje płatne zwolnienie na obowiązkowe zajęcia');
        pisz('pozycje', 'brak egzaminów z listy');
        return;
      }
      pisz('opis', `${godzinyIMinuty(r.godziny)} przy zmianie ${godzinyIMinuty(zmiana)} (przy różnych zmianach w grafiku licz dni, nie godziny)`);
      pisz('pozycje', r.pozycje.map((p) => `${NAZWA[p.egzamin]}: ${odmiana(p.dni, ['dzień', 'dni', 'dni'])}`).join('; '));
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    przelicz();
  }
</script>
