---
// Odprawa pośmiertna (art. 93 Kp): 1, 3 albo 6 pensji, podział po równo, połowa dla jedynej osoby, ubezpieczenie na życie.
// Logika: src/lib/narzedzia/odprawa-posmiertna.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { zl } from '../../lib/narzedzia/format';
import { odprawaPosmiertna } from '../../lib/narzedzia/odprawa-posmiertna';

const D = { pensja: 6000, lata: 12, osoby: 2 };
const r = odprawaPosmiertna(D);

const faq = [
  {
    pytanie: 'Ile wynosi odprawa pośmiertna?',
    odpowiedz: 'Jednomiesięczne wynagrodzenie, gdy pracownik był zatrudniony u tego pracodawcy krócej niż 10 lat, trzymiesięczne przy co najmniej 10 latach i sześciomiesięczne przy co najmniej 15 latach (art. 93 § 2 Kodeksu pracy). Gdy uprawniona jest tylko jedna osoba, dostaje połowę tej kwoty (§ 6).',
  },
  {
    pytanie: 'Komu przysługuje odprawa pośmiertna?',
    odpowiedz: 'Małżonkowi i innym członkom rodziny, którzy spełniają warunki renty rodzinnej z ustawy o emeryturach i rentach z FUS (art. 93 § 4 Kodeksu pracy), na przykład dzieciom do 16 lat, a uczącym się do 25 lat (art. 68 tej ustawy). Odprawę dzieli się po równo między wszystkich uprawnionych (§ 5).',
  },
  {
    pytanie: 'Kiedy rodzinie należy się odprawa pośmiertna?',
    odpowiedz: 'Gdy pracownik zmarł w czasie zatrudnienia albo po jego zakończeniu, ale w czasie pobierania zasiłku chorobowego (art. 93 § 1 Kodeksu pracy). Wypłaca ją pracodawca.',
  },
  {
    pytanie: 'Czy od odprawy pośmiertnej płaci się podatek?',
    odpowiedz: 'Nie. Odprawy pośmiertne są wolne od podatku dochodowego (art. 21 ust. 1 pkt 7 ustawy o PIT).',
  },
  {
    pytanie: 'Ile wynosi zasiłek pogrzebowy z ZUS?',
    odpowiedz: '7000 zł od 1 stycznia 2026 r. (art. 80 ust. 1 ustawy o emeryturach i rentach z FUS); komunikat Prezesa ZUS potwierdził tę kwotę od 1 marca 2026 r. Dostaje go osoba, która pokryła koszty pogrzebu, a przy kilku osobach dzieli się go proporcjonalnie do kosztów (art. 78). Wniosek trzeba złożyć w ciągu 12 miesięcy od śmierci (art. 81 ust. 1). To osobne świadczenie od odprawy pośmiertnej i też jest wolne od podatku (art. 21 ust. 1 pkt 7 ustawy o PIT).',
  },
  {
    pytanie: 'Co, gdy pracodawca ubezpieczył pracownika na życie?',
    odpowiedz: 'Odprawa nie przysługuje, gdy wypłata z ubezpieczenia na życie, które opłacał pracodawca, jest nie niższa niż odprawa. Gdy jest niższa, pracodawca dopłaca rodzinie różnicę (art. 93 § 7 Kodeksu pracy).',
  },
];
---
<StronaNarzedzia
  slug="odprawa-posmiertna"
  tytul="Odprawa pośmiertna: ile i komu się należy"
  opis="Ile wynosi odprawa pośmiertna: 1, 3 albo 6 pensji zmarłego według stażu, podział między rodzinę, połowa dla jednej osoby, ubezpieczenie na życie."
  h1="Odprawa pośmiertna"
  lead="Po śmierci pracownika jego rodzinie należy się od pracodawcy odprawa pośmiertna. Wpisz pensję, staż u pracodawcy i liczbę uprawnionych osób, a policzymy kwotę i część dla każdej osoby."
  faq={faq}
>
  <form class="kalkulator" data-posmiertna novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Dane pracownika</h2>
      <div class="mt-4">
        <label for="p-pensja" class="etykieta-pola">Pensja brutto miesięcznie (zł)</label>
        <input id="p-pensja" name="pensja" class="pole mt-1 max-w-48" type="text" inputmode="decimal" autocomplete="off" value={D.pensja} aria-describedby="p-pensja-opis p-blad" />
        <p id="p-pensja-opis" class="meta mt-1">Stała pensja plus średnia zmiennych składników, jak przy ekwiwalencie za urlop.</p>
      </div>
      <div class="mt-4 grid grid-cols-2 items-end gap-3">
        <div>
          <label for="p-lata" class="etykieta-pola">Pełne lata u pracodawcy</label>
          <input id="p-lata" name="lata" class="pole mt-1" type="text" inputmode="numeric" autocomplete="off" value={D.lata} aria-describedby="p-blad" />
        </div>
        <div>
          <label for="p-osoby" class="etykieta-pola">Uprawnione osoby</label>
          <input id="p-osoby" name="osoby" class="pole mt-1" type="text" inputmode="numeric" autocomplete="off" value={D.osoby} aria-describedby="p-osoby-opis p-blad" />
        </div>
      </div>
      <p id="p-osoby-opis" class="meta mt-1">Małżonek i członkowie rodziny z prawem do renty rodzinnej, na przykład dzieci do 16 lat, a uczące się do 25 lat.</p>
      <div class="mt-4">
        <label for="p-ubezpieczenie" class="etykieta-pola">Wypłata z ubezpieczenia na życie od pracodawcy (zł)</label>
        <input id="p-ubezpieczenie" name="ubezpieczenie" class="pole mt-1 max-w-48" type="text" inputmode="decimal" autocomplete="off" value="0" aria-describedby="p-ubezpieczenie-opis p-blad" />
        <p id="p-ubezpieczenie-opis" class="meta mt-1">Tylko gdy składki opłacał pracodawca; w innym wypadku zostaw 0 (art. 93 § 7).</p>
      </div>
      <p id="p-blad" class="blad-pola mt-3" data-blad="dane" role="alert" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Odprawa pośmiertna do wypłaty</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-kwota"><span data-w="razem">{zl(r.doWyplaty)}</span></p>
        <p class="meta" data-w="opis">{r.miesiace} miesięczne wynagrodzenia, po równo dla {D.osoby} osób</p>
      </div>
      <dl class="wynik-lista">
        <div><dt>Dla każdej osoby</dt><dd data-w="osoba">{zl(r.naOsobe)}</dd></div>
        <div><dt>Odprawa z art. 93 § 2</dt><dd data-w="odprawa">{zl(r.odprawa)}</dd></div>
      </dl>
      <p class="wynik-uwaga">Odprawa jest wolna od podatku (art. 21 ust. 1 pkt 7 ustawy o PIT). Zaległa pensja i inne należności zmarłego z pracy przechodzą na te same osoby po równo, a gdy ich nie ma, wchodzą do spadku (art. 63<sup>1</sup> § 2 Kodeksu pracy).</p>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Zasady są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="zasady">Zasady odprawy pośmiertnej</h2>
    <div class="tabela">
      <table>
        <caption class="sr-only">Wysokość odprawy pośmiertnej według stażu u pracodawcy</caption>
        <thead><tr><th scope="col">Staż u pracodawcy</th><th scope="col">Odprawa</th></tr></thead>
        <tbody>
          <tr><th scope="row">Krócej niż 10 lat</th><td>1 miesięczne wynagrodzenie</td></tr>
          <tr><th scope="row">Co najmniej 10 lat</th><td>3 miesięczne wynagrodzenia</td></tr>
          <tr><th scope="row">Co najmniej 15 lat</th><td>6 miesięcznych wynagrodzeń</td></tr>
        </tbody>
      </table>
    </div>
    <ul>
      <li>Przysługuje przy śmierci w czasie zatrudnienia albo w czasie pobierania zasiłku chorobowego po jego końcu (art. 93 § 1 Kodeksu pracy).</li>
      <li>Uprawnieni: małżonek i członkowie rodziny z prawem do renty rodzinnej (§ 4); kwota dzielona po równo (§ 5), a jedna osoba dostaje połowę (§ 6).</li>
      <li>Ubezpieczenie na życie opłacone przez pracodawcę zastępuje odprawę, gdy wypłata jest nie niższa; gdy niższa, pracodawca dopłaca różnicę (§ 7).</li>
      <li>Do stażu wlicza się pracę u poprzedniego pracodawcy po przejęciu zakładu (art. 93 § 3 i art. 36 § 1<sup>1</sup>), a od 2026 r. także zlecenia i działalność wykonywane na rzecz tego pracodawcy (art. 302<sup>1</sup> § 8). Policzysz to w <a href="/narzedzia/staz-pracy">kalkulatorze stażu pracy</a>.</li>
    </ul>

    <h2 id="zasilek-pogrzebowy">Zasiłek pogrzebowy z ZUS</h2>
    <ul>
      <li>Kwota: 7000 zł od 1 stycznia 2026 r. (art. 80 ust. 1 ustawy o emeryturach i rentach z FUS), także od 1 marca 2026 r. według komunikatu Prezesa ZUS (M.P. 2026 poz. 150). Należy się w kwocie z dnia śmierci (art. 80 ust. 7). Kwota rośnie od 1 marca tylko wtedy, gdy średnioroczna inflacja z poprzedniego roku przekroczy 5% (art. 80 ust. 2–3).</li>
      <li>Dostaje go osoba, która pokryła koszty pogrzebu, a także pracodawca, dom pomocy społecznej, gmina, powiat, kościół albo związek wyznaniowy, gdy to one zapłaciły; przy kilku płacących dzieli się go proporcjonalnie do kosztów (art. 78).</li>
      <li>Osoba spoza rodziny zmarłego (art. 77 ust. 2) dostaje zwrot udokumentowanych kosztów, najwyżej 7000 zł (art. 79 ust. 1).</li>
      <li>Wniosek do ZUS: w ciągu 12 miesięcy od śmierci, inaczej prawo wygasa (art. 81 ust. 1).</li>
    </ul>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Wynagrodzenie do odprawy liczy się jak ekwiwalent za urlop (§ 2 ust. 1 pkt 8 rozporządzenia z 29 maja 1996 r.
      w sprawie sposobu ustalania wynagrodzenia w okresie niewykonywania pracy): stała pensja plus średnia składników
      zmiennych, jak w <a href="/narzedzia/ekwiwalent-za-urlop">kalkulatorze ekwiwalentu</a>. Mnożymy je przez 1, 3 albo 6,
      dla jednej osoby dzielimy przez 2, odejmujemy wypłatę z ubezpieczenia i dzielimy po równo, z zaokrągleniem do grosza.
      Inne odprawy przy końcu pracy policzy <a href="/narzedzia/kalkulator-odprawy">kalkulator odprawy</a>.
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { wpisanaLiczba, zl } from '../../lib/narzedzia/format';
  import { odprawaPosmiertna } from '../../lib/narzedzia/odprawa-posmiertna';
  import { odmiana } from '../../lib/redakcja';
  import { typografia } from '../../lib/typografia.mjs';
  import { liczPoPowrocie, pokazBlad } from '../../lib/narzedzia/formularz';

  const form = document.querySelector<HTMLFormElement>('[data-posmiertna]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const calkowita = (t: string) => (/^\d{1,2}$/.test(t.trim()) ? Number(t.trim()) : NaN);
    const przelicz = () => {
      const pensja = wpisanaLiczba(el('pensja').value);
      const lata = calkowita(el('lata').value);
      const osoby = calkowita(el('osoby').value);
      const tekstUb = el('ubezpieczenie').value.trim();
      const ubezpieczenie = tekstUb === '' ? 0 : wpisanaLiczba(tekstUb);
      let blad: string | null = null;
      if (!(pensja > 0 && pensja < 1_000_000)) blad = 'Wpisz pensję brutto, na przykład 6000.';
      else if (!(lata >= 0 && lata <= 70)) blad = 'Wpisz pełne lata pracy u pracodawcy, na przykład 12.';
      else if (!(osoby >= 1 && osoby <= 20)) blad = 'Wpisz liczbę uprawnionych osób: od 1 do 20.';
      else if (!(ubezpieczenie >= 0)) blad = 'Wpisz kwotę z ubezpieczenia albo 0.';
      const zlePole = !(pensja > 0 && pensja < 1_000_000) ? 'pensja' : !(lata >= 0 && lata <= 70) ? 'lata' : !(osoby >= 1 && osoby <= 20) ? 'osoby' : 'ubezpieczenie';
      pokazBlad(form.querySelector<HTMLElement>('[data-blad="dane"]')!, blad, el(zlePole));
      if (blad) {
        w('razem').textContent = '—';
        w('opis').textContent = '';
        return;
      }
      const r = odprawaPosmiertna({ pensja, lata, osoby, ubezpieczenie });
      w('razem').textContent = typografia(zl(r.doWyplaty));
      const opis = r.jednaOsoba
        ? `Połowa z ${odmiana(r.miesiace, ['miesięcznego wynagrodzenia', 'miesięcznych wynagrodzeń', 'miesięcznych wynagrodzeń'])}, bo uprawniona jest jedna osoba`
        : `${odmiana(r.miesiace, ['miesięczne wynagrodzenie', 'miesięczne wynagrodzenia', 'miesięcznych wynagrodzeń'])}, po równo dla ${osoby} osób`;
      w('opis').textContent = typografia(ubezpieczenie > 0 ? `${opis}, po odjęciu wypłaty z ubezpieczenia` : opis);
      w('osoba').textContent = typografia(zl(r.naOsobe));
      w('odprawa').textContent = typografia(zl(r.odprawa));
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    liczPoPowrocie(przelicz);
    przelicz();
  }
</script>
