---
// Urlop bezpłatny: skutki dla urlopu wypoczynkowego (art. 155^2, 155^2a, 155^3 Kp), stażu (art. 174 § 2, 174^1 § 2,
// 186^5) i ubezpieczeń (art. 4 i 12 ustawy zasiłkowej, art. 66–69 ustawy o świadczeniach, art. 7 ustawy o FUS,
// art. 6 i 9 ustawy systemowej). Logika i teksty wyniku: src/lib/narzedzia/urlop-bezplatny.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { RODZAJE, tekstyWyniku, type RodzajNieobecnosci } from '../../lib/narzedzia/urlop-bezplatny';
import { indeksyUnicode } from '../../lib/narzedzia/format';

// Stały przykład (niezależny od dnia budowania): urlop z powrotem w tym samym roku.
const OD = '2026-03-01';
const DO = '2026-05-31';
const WYMIAR = 26;
const t = tekstyWyniku({ od: OD, do: DO, rodzaj: 'bezplatny', wymiar: WYMIAR });
const rodzaje = Object.keys(RODZAJE) as RodzajNieobecnosci[];

const faq = [
  {
    pytanie: 'Czy urlop bezpłatny zmniejsza urlop wypoczynkowy?',
    odpowiedz: 'Tak, gdy trwa co najmniej miesiąc. Gdy zaczął się po nabyciu prawa do urlopu w danym roku, a wracasz do pracy w ciągu tego samego roku, wymiar za ten rok obniża się proporcjonalnie, chyba że przed urlopem bezpłatnym wykorzystano urlop w przysługującym lub wyższym wymiarze (art. 155^2 § 2 Kodeksu pracy). Po powrocie w kolejnym roku urlop za rok powrotu liczy się proporcjonalnie do okresu do końca roku (art. 155^2 § 1). Każdy kalendarzowy miesiąc pracy to 1/12 wymiaru, niepełny miesiąc pracy i niepełny dzień zaokrągla się w górę (art. 155^2a i 155^3).',
  },
  {
    pytanie: 'Czy urlop bezpłatny wlicza się do stażu pracy?',
    odpowiedz: 'Nie. Okresu urlopu bezpłatnego nie wlicza się do okresu pracy, od którego zależą uprawnienia pracownicze (art. 174 § 2 Kodeksu pracy), chyba że przepis szczególny stanowi inaczej (§ 4). Wyjątkiem jest urlop bezpłatny na pracę u innego pracodawcy: ten wlicza się do okresu pracy u dotychczasowego pracodawcy (art. 174^1 § 2).',
  },
  {
    pytanie: 'Czy na urlopie bezpłatnym mam ubezpieczenie zdrowotne?',
    odpowiedz: 'Przez 30 dni liczonych od dnia po rozpoczęciu urlopu. Pracownik korzystający z urlopu bezpłatnego traci prawo do świadczeń z ubezpieczenia zdrowotnego po upływie 30 dni od dnia rozpoczęcia urlopu (art. 69 ust. 3 ustawy o świadczeniach opieki zdrowotnej). Może ubezpieczyć się dobrowolnie na pisemny wniosek złożony w NFZ, jeśli mieszka w Polsce (art. 68 ust. 1).',
  },
  {
    pytanie: 'Czy na urlopie bezpłatnym dostanę zasiłek chorobowy?',
    odpowiedz: 'Nie. Zasiłek chorobowy nie przysługuje za niezdolność do pracy przypadającą w czasie urlopu bezpłatnego, a tych dni nie wlicza się do okresu zasiłkowego (art. 12 ust. 2 pkt 1 i ust. 3 ustawy zasiłkowej). Czy przy chorobie trwającej dalej zasiłek przysługuje od dnia, w którym urlop bezpłatny miał się skończyć, ustawa wprost nie mówi.',
  },
  {
    pytanie: 'Czy pracodawca może odwołać mnie z urlopu bezpłatnego?',
    odpowiedz: 'Kodeks przewiduje odwołanie tylko przy urlopie dłuższym niż 3 miesiące, z ważnych przyczyn, jeśli strony przewidziały to przy udzielaniu urlopu (art. 174 § 3 Kodeksu pracy).',
  },
  {
    pytanie: 'Czy pracodawca musi dać urlop bezpłatny?',
    odpowiedz: 'Nie. Na wniosek pracownika złożony w postaci papierowej lub elektronicznej pracodawca „może udzielić” urlopu bezpłatnego (art. 174 § 1 Kodeksu pracy). Przepis nie określa, jak długo może on trwać.',
  },
];
---
<StronaNarzedzia
  slug="urlop-bezplatny"
  tytul="Urlop bezpłatny: urlop wypoczynkowy, staż, ZUS"
  opis="Ile urlopu wypoczynkowego po urlopie bezpłatnym, o ile przesuwa się staż i 26 dni urlopu, co z zasiłkiem chorobowym i NFZ. Wpisz daty urlopu."
  h1="Urlop bezpłatny: skutki dla urlopu, stażu i ubezpieczeń"
  lead="Urlop bezpłatny trwający co najmniej miesiąc obniża urlop wypoczynkowy, gdy wracasz w tym samym roku. Nie wlicza się do okresu pracy, od którego zależą uprawnienia pracownicze, a po 30 dniach odbiera prawo do świadczeń z NFZ. Wpisz daty, a policzymy urlop za każdy rok i nową datę 10 lat stażu."
  faq={faq}
>
  <form class="kalkulator" data-bezplatny novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Twój urlop bezpłatny</h2>
      <div class="mt-4 grid grid-cols-2 items-end gap-3">
        <div>
          <label for="b-od" class="etykieta-pola">Od</label>
          <input id="b-od" name="od" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" value={OD} aria-describedby="b-blad" />
        </div>
        <div>
          <label for="b-do" class="etykieta-pola">Do</label>
          <input id="b-do" name="do" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" value={DO} aria-describedby="b-blad" />
        </div>
      </div>
      <div class="mt-4">
        <label for="b-rodzaj" class="etykieta-pola">Rodzaj</label>
        <select id="b-rodzaj" name="rodzaj" class="pole mt-1">
          {rodzaje.map((r) => <option value={r} selected={r === 'bezplatny'}>{RODZAJE[r]}</option>)}
        </select>
      </div>
      <div class="mt-4 grid grid-cols-2 items-end gap-3">
        <div>
          <label for="b-wymiar" class="etykieta-pola">Roczny wymiar urlopu</label>
          <input id="b-wymiar" name="wymiar" class="pole mt-1" type="text" inputmode="numeric" autocomplete="off" value={WYMIAR} aria-describedby="b-wymiar-opis b-blad" />
        </div>
        <div>
          <label for="b-wykorzystane" class="etykieta-pola">Wykorzystany przed</label>
          <input id="b-wykorzystane" name="wykorzystane" class="pole mt-1" type="text" inputmode="numeric" autocomplete="off" value="0" aria-describedby="b-wymiar-opis b-blad" />
        </div>
      </div>
      <p id="b-wymiar-opis" class="meta mt-1">Dni. Wymiar na niepełny etat już przeliczony. „Wykorzystany przed”: dni urlopu wypoczynkowego wzięte w roku rozpoczęcia przed urlopem bezpłatnym; ma znaczenie, gdy urlop bezpłatny zaczyna się po 1 stycznia i kończy w tym samym roku.</p>
      <div class="mt-4">
        <label for="b-staz" class="etykieta-pola">Data 10 lat stażu bez urlopu bezpłatnego</label>
        <input id="b-staz" name="staz" type="date" class="pole mt-1 max-w-56" min="2000-01-01" max="2100-12-31" aria-describedby="b-staz-opis b-blad" />
        <p id="b-staz-opis" class="meta mt-1">Opcjonalnie: dzień, w którym bez urlopu bezpłatnego mija 10 lat stażu.</p>
      </div>
      <p id="b-blad" class="blad-pola mt-3" data-blad="dane" role="alert" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Urlop wypoczynkowy w roku rozpoczęcia</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-kwota" data-w="glowna">{t.glowna}</p>
        <p class="meta" data-w="opis">{indeksyUnicode(t.opis)}</p>
      </div>
      <dl class="wynik-lista" data-w="lista">
        {[...t.lata, ...t.pozycje].map((p) => <div><dt>{p.etykieta}</dt><dd>{indeksyUnicode(p.wartosc)}</dd></div>)}
      </dl>
      <h3 class="etykieta mt-5">Ubezpieczenia</h3>
      <ul class="mt-2 list-disc space-y-2 pl-5 text-[0.9375rem]" data-w="ubezpieczenia">
        {t.ubezpieczenia.map((u) => <li>{indeksyUnicode(u)}</li>)}
      </ul>
      <p class="wynik-uwaga" data-w="ochrona">{indeksyUnicode(t.ochrona)}</p>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Zasady są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="zasady">Urlop bezpłatny w Kodeksie pracy</h2>
    <ul>
      <li>Pracodawca może udzielić urlopu bezpłatnego na wniosek pracownika złożony w postaci papierowej lub elektronicznej (art. 174 § 1). To nie obowiązek.</li>
      <li>Okresu urlopu bezpłatnego nie wlicza się do okresu pracy, od którego zależą uprawnienia pracownicze (art. 174 § 2), chyba że przepisy szczególne stanowią inaczej (§ 4).</li>
      <li>Przy urlopie dłuższym niż 3 miesiące strony mogą przewidzieć, że pracownika wolno odwołać z ważnych przyczyn (art. 174 § 3).</li>
      <li>Urlop bezpłatny na pracę u innego pracodawcy, na podstawie porozumienia pracodawców i za zgodą pracownika, wlicza się do okresu pracy u dotychczasowego pracodawcy (art. 174<sup>1</sup>).</li>
      <li>Art. 41 zakazuje wypowiedzenia „w czasie urlopu pracownika” i nie rozróżnia rodzajów urlopu. Nie stosuje się go w razie ogłoszenia upadłości lub likwidacji pracodawcy (art. 41<sup>1</sup> § 1).</li>
    </ul>

    <h2 id="urlop-wypoczynkowy">Urlop wypoczynkowy po urlopie bezpłatnym</h2>
    <p>
      Po co najmniej miesięcznym urlopie bezpłatnym, urlopie wychowawczym albo nieusprawiedliwionej nieobecności
      pracownik wracający w ciągu roku dostaje urlop jak u nowego pracodawcy: proporcjonalnie do okresu pozostałego do
      końca roku (art. 155<sup>2</sup> § 1 w związku z art. 155<sup>1</sup> § 1 pkt 2). Gdy nieobecność zaczęła się po
      nabyciu prawa do urlopu w danym roku, wymiar pracownika powracającego w ciągu tego samego roku obniża się
      proporcjonalnie, chyba że przed rozpoczęciem nieobecności wykorzystał urlop w przysługującym mu lub wyższym
      wymiarze (art. 155<sup>2</sup> § 2). Obniżenie z § 2 nie dotyczy urlopu wychowawczego: przepis wymienia pkt 1
      i 3–6, bez pkt 2.
    </p>
    <p>
      Kalendarzowy miesiąc pracy odpowiada 1/12 wymiaru, a niepełny kalendarzowy miesiąc pracy zaokrągla się w górę
      (art. 155<sup>2a</sup>). Niepełny dzień urlopu też zaokrągla się w górę, ale urlop nie może przekroczyć wymiaru
      rocznego (art. 155<sup>3</sup>). Ile wynosi ten wymiar, policzy <a href="/narzedzia/kalkulator-urlopu">kalkulator urlopu</a>,
      a ile urlopu wychowawczego zostało, <a href="/narzedzia/urlop-wychowawczy">kalkulator urlopu wychowawczego</a>.
    </p>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <ul>
      <li>Długość to dni kalendarzowe od pierwszego do ostatniego dnia urlopu włącznie.</li>
      <li>
        Przepis nie mówi, jak liczyć „co najmniej 1 miesiąc”. Termin w miesiącach kończy się w dniu, który datą
        odpowiada dniowi początkowemu, a gdy takiego dnia nie ma, w ostatnim dniu miesiąca (art. 112 Kodeksu cywilnego
        przez art. 300 Kodeksu pracy). Liczymy od dnia po rozpoczęciu urlopu, więc miesiąc od 1 marca kończy się
        1 kwietnia; przy liczeniu pierwszego dnia urlopu kończyłby się 31 marca. Wybieramy pierwszy sposób, bo w przypadku
        granicznym urlopu wypoczynkowego się wtedy nie obniża. Tak samo liczymy „dłuższy niż 3 miesiące” z art. 174 § 3.
      </li>
      <li>
        Dla każdego roku liczymy miesiące kalendarzowe, w których jest choć jeden dzień poza nieobecnością (niepełny
        miesiąc pracy w górę), i bierzemy tyle dwunastych wymiaru, zaokrąglając w górę. Przy urlopie od 1 marca do
        31 maja 2026 r. to 9 miesięcy: 26 × 9/12 = 19,5, czyli 20 dni.
      </li>
      <li>
        Rok rozpoczęcia obniżamy tylko wtedy, gdy wracasz do pracy w tym samym roku (art. 155<sup>2</sup> § 2). Przy
        powrocie w kolejnym roku wymiar za rok rozpoczęcia się nie zmienia, a za rok powrotu liczymy proporcję do końca
        roku (§ 1). Prawo do urlopu przyjmujemy jako nabyte 1 stycznia (art. 153 § 2), więc urlop zaczęty 1 stycznia
        liczymy z § 1; dotyczy to także urlopu wychowawczego. Przy umowie kończącej się przed końcem roku art. 155<sup>1</sup>
        § 1 pkt 2 lit. b każe liczyć proporcję do okresu zatrudnienia; narzędzie liczy do końca roku (lit. a).
      </li>
      <li>
        Przepisy nie mówią, ile urlopu przysługuje za rok spędzony w całości na urlopie bezpłatnym; przyjmujemy 0 dni.
        Drugie odczytanie, że żaden paragraf art. 155<sup>2</sup> nie obejmuje roku bez powrotu, daje pełny wymiar.
        Pokazujemy oba.
      </li>
      <li>
        Przepis nie mówi, czy wyjątek „chyba że” z art. 155<sup>2</sup> § 2 przywraca pełny wymiar, czy tylko chroni urlop
        już wykorzystany; pokazujemy oba odczytania. Wynik główny: obniżony wymiar, a do wykorzystania zostaje różnica,
        nie mniej niż 0. Przepis nie mówi nic o zwrocie urlopu wykorzystanego ponad wymiar.
      </li>
      <li>
        Przepis nie rozstrzyga, czy art. 155<sup>2</sup> obejmuje urlop z art. 174<sup>1</sup>: § 1 pkt 1 mówi o urlopie
        bezpłatnym bez wyjątku, a art. 174<sup>1</sup> § 2 o okresie pracy. Liczymy obniżenie jak przy urlopie
        bezpłatnym, a przy odczytaniu, że art. 155<sup>2</sup> go nie obejmuje, pokazujemy pełny wymiar.
      </li>
      <li>
        Datę 10 lat stażu przesuwamy o liczbę dni urlopu bezpłatnego, gdy zaczął się przed tą datą. Urlop wychowawczy
        wlicza się do okresu zatrudnienia w dniu jego zakończenia (art. 186<sup>5</sup>); jeśli 10 lat mija w czasie
        urlopu, liczymy je od dnia zakończenia urlopu. Dla nieobecności nieusprawiedliwionej stażu nie liczymy:
        art. 174 § 2 dotyczy urlopu bezpłatnego.
      </li>
      <li>
        30 dni z art. 69 ust. 3 ustawy o świadczeniach opieki zdrowotnej liczymy bez dnia rozpoczęcia urlopu (art. 111
        § 2 Kodeksu cywilnego): przy urlopie od 1 marca prawo do świadczeń trwa do 31 marca.
      </li>
      <li>
        Ustawa o systemie ubezpieczeń społecznych nie wspomina o urlopie bezpłatnym, a ustawa o emeryturach i rentach
        z FUS nie wymienia zwykłego urlopu bezpłatnego ani wśród okresów nieskładkowych (art. 7; są tam urlopy bezpłatne
        na opiekę nad małymi dziećmi w pkt 5 i urlop bezpłatny małżonków pracowników placówek za granicą w pkt 8), ani
        wprost wśród składkowych (art. 6). Nie piszemy więc, jak ten okres liczy się do emerytury. Staż z innych okresów
        policzy <a href="/narzedzia/staz-pracy">kalkulator stażu pracy</a>.
      </li>
    </ul>
  </Fragment>
</StronaNarzedzia>

<script>
  import { MAKS_LAT, tekstyWyniku, type RodzajNieobecnosci } from '../../lib/narzedzia/urlop-bezplatny';
  import { dodajMiesiace, poprawnaData } from '../../lib/narzedzia/terminy';
  import { indeksyUnicode } from '../../lib/narzedzia/format';
  import { typografia } from '../../lib/typografia.mjs';

  const form = document.querySelector<HTMLFormElement>('[data-bezplatny]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const tekst = (s: string) => typografia(indeksyUnicode(s));
    const calkowita = (s: string) => (/^\d{1,2}$/.test(s.trim()) ? Number(s.trim()) : Number.NaN);
    const POLA = ['od', 'do', 'wymiar', 'wykorzystane', 'staz'];
    const przelicz = () => {
      const od = el('od').value;
      const do_ = el('do').value;
      const staz = el('staz').value;
      const wymiar = calkowita(el('wymiar').value);
      const wykorzystane = el('wykorzystane').value.trim() === '' ? 0 : calkowita(el('wykorzystane').value);
      let blad: string | null = null;
      let pole: string | null = null;
      if (!poprawnaData(od)) [blad, pole] = ['Wpisz datę początku urlopu.', 'od'];
      else if (!poprawnaData(do_)) [blad, pole] = ['Wpisz datę końca urlopu.', 'do'];
      else if (do_ < od) [blad, pole] = ['Koniec przed początkiem.', 'do'];
      else if (do_ >= dodajMiesiace(od, MAKS_LAT * 12)) [blad, pole] = [`Liczymy okres krótszy niż ${MAKS_LAT} lat.`, 'do'];
      else if (!(wymiar >= 1 && wymiar <= 26)) [blad, pole] = ['Roczny wymiar urlopu: liczba całkowita od 1 do 26 dni.', 'wymiar'];
      else if (!(wykorzystane >= 0 && wykorzystane <= wymiar)) [blad, pole] = ['Wykorzystany urlop: od 0 do rocznego wymiaru.', 'wykorzystane'];
      else if (staz && !poprawnaData(staz)) [blad, pole] = ['Niepoprawna data 10 lat stażu.', 'staz'];
      for (const n of POLA) el(n).setAttribute('aria-invalid', n === pole ? 'true' : 'false');
      const b = form.querySelector<HTMLElement>('[data-blad="dane"]')!;
      b.hidden = !blad;
      b.textContent = blad ? typografia(blad) : '';
      const lista = w('lista');
      const ubezpieczenia = w('ubezpieczenia');
      if (blad) {
        w('glowna').textContent = '—';
        w('opis').textContent = '';
        lista.replaceChildren();
        ubezpieczenia.replaceChildren();
        return;
      }
      const t = tekstyWyniku({
        od,
        do: do_,
        rodzaj: el('rodzaj').value as RodzajNieobecnosci,
        wymiar,
        wykorzystanePrzed: wykorzystane,
        data10Lat: staz || undefined,
      });
      w('glowna').textContent = tekst(t.glowna);
      w('opis').textContent = tekst(t.opis);
      w('ochrona').textContent = tekst(t.ochrona);
      lista.replaceChildren(
        ...[...t.lata, ...t.pozycje].map((p) => {
          const div = document.createElement('div');
          const dt = document.createElement('dt');
          dt.textContent = tekst(p.etykieta);
          const dd = document.createElement('dd');
          dd.textContent = tekst(p.wartosc);
          div.append(dt, dd);
          return div;
        }),
      );
      ubezpieczenia.replaceChildren(
        ...t.ubezpieczenia.map((u) => {
          const li = document.createElement('li');
          li.textContent = tekst(u);
          return li;
        }),
      );
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    przelicz();
  }
</script>
