---
// Świadczenie rehabilitacyjne: 90/75/100%, do 12 miesięcy, waloryzacja podstawy (art. 18–20 ustawy zasiłkowej,
// art. 9 ustawy wypadkowej, art. 53 Kp). Logika: src/lib/narzedzia/swiadczenie-rehabilitacyjne.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { LATA } from '../../data/prawo';
import { zl } from '../../lib/narzedzia/format';
import { WSKAZNIKI, swiadczenieRehabilitacyjne } from '../../lib/narzedzia/swiadczenie-rehabilitacyjne';
import { dataPoPolsku, dzisWPolsce } from '../../lib/narzedzia/terminy';

const dzis = dzisWPolsce();
const BRUTTO = 6000;
// Rok bez płacy minimalnej w rejestrze (np. przed jej ogłoszeniem) liczymy od grudnia ostatniego znanego roku.
const startDzis = LATA.includes(Number(dzis.slice(0, 4)));
const start = startDzis ? dzis : `${LATA[LATA.length - 1]}-12-01`;
const r = swiadczenieRehabilitacyjne({ start, brutto: BRUTTO, przyczyna: 'choroba', miesiace: 12 });

const faq = [
  {
    pytanie: 'Ile wynosi świadczenie rehabilitacyjne?',
    odpowiedz: `90% podstawy zasiłku chorobowego przez pierwsze 3 miesiące, potem 75%, a w ciąży 100% (art. 19 ust. 1 ustawy zasiłkowej). Po wypadku przy pracy albo przy chorobie zawodowej 100% (art. 9 ust. 1 ustawy wypadkowej). Przy pensji ${zl(BRUTTO)} brutto to ${zl(r.pierwsze)} i potem ${zl(r.dalej)} miesięcznie brutto, po waloryzacji podstawy z bieżącego kwartału.`,
  },
  {
    pytanie: 'Jak długo można być na świadczeniu rehabilitacyjnym?',
    odpowiedz: 'Przez okres niezbędny do przywrócenia zdolności do pracy, najdłużej 12 miesięcy. Przysługuje po wyczerpaniu zasiłku chorobowego, gdy dalsze leczenie albo rehabilitacja rokują powrót do pracy; orzeka o tym lekarz orzecznik ZUS (art. 18 ust. 1–3 ustawy zasiłkowej).',
  },
  {
    pytanie: 'Czy pracodawca może mnie zwolnić w czasie świadczenia rehabilitacyjnego?',
    odpowiedz: 'Może rozwiązać umowę bez wypowiedzenia, gdy niezdolność do pracy trwa dłużej niż okres wynagrodzenia i zasiłku chorobowego oraz pierwsze 3 miesiące świadczenia rehabilitacyjnego, jeżeli pracujesz u niego co najmniej 6 miesięcy albo niezdolność wynika z wypadku przy pracy lub choroby zawodowej (art. 53 § 1 pkt 1 lit. b Kodeksu pracy). Nie może tego zrobić po Twoim powrocie do pracy (art. 53 § 3). Gdy zgłosisz powrót niezwłocznie po wyczerpaniu świadczenia, pracodawca powinien w miarę możliwości zatrudnić Cię ponownie (art. 53 § 5 i art. 20 ustawy zasiłkowej).',
  },
];
---
<StronaNarzedzia
  slug="swiadczenie-rehabilitacyjne"
  tytul="Świadczenie rehabilitacyjne: ile i jak długo"
  opis="Policz świadczenie rehabilitacyjne po zasiłku chorobowym: 90% przez 3 miesiące, potem 75%, 100% w ciąży i po wypadku przy pracy. Do 12 miesięcy."
  h1="Świadczenie rehabilitacyjne: ile i jak długo"
  lead="Gdy po 182 dniach zwolnienia lekarskiego nadal nie możesz pracować, a leczenie rokuje powrót, ZUS może przyznać świadczenie rehabilitacyjne. Wpisz pensję i początek świadczenia, a policzymy kwoty miesięczne i terminy."
  faq={faq}
>
  <form class="kalkulator" data-rehabilitacyjne novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Pensja i świadczenie</h2>
      <div class="mt-4">
        <label for="r-brutto" class="etykieta-pola">Przeciętna pensja brutto z 12 miesięcy przed zwolnieniem (zł)</label>
        <input id="r-brutto" name="brutto" class="pole mt-1 max-w-48" type="text" inputmode="decimal" autocomplete="off" value={BRUTTO} aria-describedby="r-blad" />
      </div>
      <div class="mt-4">
        <label for="r-start" class="etykieta-pola">Początek świadczenia</label>
        <input id="r-start" name="start" type="date" class="pole mt-1 max-w-56" min="2026-01-01" max="2100-12-31" value={start} data-dzis={startDzis ? '0' : undefined} aria-describedby="r-blad" />
      </div>
      <fieldset class="mt-4">
        <legend class="etykieta-pola">Przyczyna niezdolności do pracy</legend>
        <div class="opcje-pionowe mt-2">
          <label><input type="radio" name="przyczyna" value="choroba" checked /> Choroba</label>
          <label><input type="radio" name="przyczyna" value="wypadek" /> Wypadek przy pracy albo choroba zawodowa</label>
          <label><input type="radio" name="przyczyna" value="ciaza" /> Niezdolność w czasie ciąży</label>
        </div>
      </fieldset>
      <div class="mt-4">
        <label for="r-miesiace" class="etykieta-pola">Na ile miesięcy przyznano świadczenie</label>
        <select id="r-miesiace" name="miesiace" class="pole mt-1 max-w-48">
          {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => <option value={m} selected={m === 12}>{m}</option>)}
        </select>
      </div>
      <label class="mt-4 flex items-start gap-3 text-[0.9375rem]">
        <input type="checkbox" name="pelnyEtat" checked class="mt-1 size-[1.125rem] flex-none accent-[var(--color-akcent-tekst)]" />
        <span>Pełny etat (podstawa nie niższa niż z płacy minimalnej)</span>
      </label>
      <p id="r-blad" class="blad-pola mt-3" data-blad="dane" role="alert" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta" data-w="naglowek">Pierwsze 3 miesiące, miesięcznie brutto</h2>
      <p class="wynik-kwota" aria-live="polite" aria-atomic="true"><span data-w="pierwsze">{zl(r.pierwsze)}</span></p>
      <dl class="wynik-lista">
        <div><dt data-w="dalej-opis">Od {dataPoPolsku(r.od75)}, miesięcznie (75%)</dt><dd data-w="dalej">{zl(r.dalej)}</dd></div>
        <div><dt>Podstawa po waloryzacji</dt><dd data-w="podstawa">{zl(r.podstawaPoWaloryzacji)}</dd></div>
        <div><dt>Wskaźnik waloryzacji</dt><dd data-w="wskaznik">{r.wskaznik ? `${String(r.wskaznik.wskaznik).replace('.', ',')}% (${r.wskaznik.zrodlo})` : 'jeszcze nieogłoszony'}</dd></div>
        <div><dt>Razem za przyznany okres</dt><dd data-w="razem">{zl(r.razem)}</dd></div>
        <div><dt>Najdłużej do</dt><dd data-w="koniec">{dataPoPolsku(r.koniecNajpozniej)}</dd></div>
      </dl>
      <p class="wynik-uwaga">Kwoty brutto, przed zaliczką na podatek, za pełne miesiące.</p>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Zasady są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="waloryzacja">Waloryzacja podstawy</h2>
    <p>
      Podstawę zasiłku chorobowego, od której liczy się świadczenie, ZUS podwyższa o wzrost przeciętnego wynagrodzenia,
      według kwartału, w którym zaczyna się świadczenie (art. 19 ust. 2 ustawy zasiłkowej). Wskaźnik ogłasza Prezes ZUS
      do końca poprzedniego kwartału (art. 19 ust. 3).
    </p>
    <div class="tabela">
      <table>
        <caption class="sr-only">Wskaźniki waloryzacji podstawy świadczenia rehabilitacyjnego</caption>
        <thead><tr><th scope="col">Kwartał</th><th scope="col">Wskaźnik</th><th scope="col">Źródło</th></tr></thead>
        <tbody>
          {Object.entries(WSKAZNIKI).map(([kw, x]) => <tr><th scope="row">{kw.replace('-', ', kwartał ')}</th><td>{x.wskaznik === 100 ? 'bez waloryzacji' : `${String(x.wskaznik).replace('.', ',')}%`}</td><td>{x.zrodlo}</td></tr>)}
        </tbody>
      </table>
    </div>

    <p>
      Datę, od której pracodawca może rozwiązać umowę po zasiłku i 3 miesiącach świadczenia, policzy <a href="/narzedzia/zwolnienie-na-l4">kalkulator ochrony na L4</a>.
    </p>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Podstawa: przeciętna pensja brutto z 12 miesięcy przed zwolnieniem minus 13,71% składek, przy pełnym etacie nie
      mniej niż z płacy minimalnej, tak jak przy <a href="/narzedzia/kalkulator-l4">zasiłku chorobowym</a>. Dla kwartału,
      dla którego wskaźnika jeszcze nie ogłoszono, liczymy bez waloryzacji. Kwoty miesięczne to podstawa razy 90%, 75% albo 100%; „razem” to suma pełnych miesięcy.
      Miesiąc to 30 dni (art. 22 w związku z art. 11 ust. 5 ustawy zasiłkowej): 90% przez pierwsze 90 dni, najwyżej
      360 dni. Kalkulator ochrony na L4 liczy 3 miesiące z art. 53 Kodeksu pracy kalendarzowo, więc jego data może wypaść
      o 1–2 dni później.
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { liczPoPowrocie, pokazBlad } from '../../lib/narzedzia/formularz';
  import { wpisanaLiczba, zl } from '../../lib/narzedzia/format';
  import { dataPoPolsku, poprawnaData } from '../../lib/narzedzia/terminy';
  import { swiadczenieRehabilitacyjne, type Przyczyna } from '../../lib/narzedzia/swiadczenie-rehabilitacyjne';
  import { typografia } from '../../lib/typografia.mjs';
  import { ustawDzisiejszeWartosci } from '../../lib/narzedzia/dzis-w-formularzu';

  const form = document.querySelector<HTMLFormElement>('[data-rehabilitacyjne]');
  if (form) {
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const pisz = (k: string, tekst: string) => {
      w(k).textContent = typografia(tekst);
    };
    const przelicz = () => {
      const brutto = wpisanaLiczba(el('brutto').value);
      const start = el('start').value;
      let blad: string | null = null;
      let pole: HTMLInputElement | null = null;
      if (!(brutto > 0 && brutto < 1_000_000)) (blad = 'Wpisz pensję brutto, na przykład 6000.'), (pole = el('brutto'));
      else if (!poprawnaData(start) || start < '2026-01-01') (blad = 'Wpisz początek świadczenia od 2026 r.'), (pole = el('start'));
      let r: ReturnType<typeof swiadczenieRehabilitacyjne> | null = null;
      if (!blad) {
        try {
          r = swiadczenieRehabilitacyjne({ start, brutto, przyczyna: el('przyczyna').value as Przyczyna, miesiace: Number(el('miesiace').value), pelnyEtat: el('pelnyEtat').checked });
        } catch {
          (blad = 'Brak płacy minimalnej dla tego roku. Wybierz wcześniejszą datę.'), (pole = el('start'));
        }
      }
      pokazBlad(form.querySelector<HTMLElement>('[data-blad="dane"]')!, blad, pole);
      if (blad || !r) {
        w('pierwsze').textContent = '—';
        return;
      }
      const stale = r.procentPierwsze === r.procentDalej;
      pisz('naglowek', stale ? 'Miesięcznie brutto (100%)' : 'Pierwsze 3 miesiące, miesięcznie brutto');
      pisz('pierwsze', zl(r.pierwsze));
      pisz('dalej-opis', stale ? 'Przez cały okres, miesięcznie' : `Od ${dataPoPolsku(r.od75)}, miesięcznie (75%)`);
      pisz('dalej', zl(r.dalej));
      pisz('podstawa', zl(r.podstawaPoWaloryzacji));
      pisz('wskaznik', r.wskaznik ? `${String(r.wskaznik.wskaznik).replace('.', ',')}% (${r.wskaznik.zrodlo})` : 'jeszcze nieogłoszony');
      pisz('razem', zl(r.razem));
      pisz('koniec', dataPoPolsku(r.koniecNajpozniej));
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    ustawDzisiejszeWartosci(form);
    liczPoPowrocie(przelicz);
    przelicz();
  }
</script>
