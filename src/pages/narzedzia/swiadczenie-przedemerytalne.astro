---
// Świadczenie przedemerytalne: warunki (art. 2–7 ustawy o świadczeniach przedemerytalnych, Dz.U. 2026 poz. 115; art. 2
// ust. 1 pkt 38 ustawy o rynku pracy; kwoty przychodu M.P. 2026 poz. 208). Logika i teksty wyniku:
// src/lib/narzedzia/swiadczenie-przedemerytalne.ts (testy obok).
import StronaNarzedzia from '../../components/narzedzia/StronaNarzedzia.astro';
import { KWOTY_PRZYCHODU, opisPrzedemerytalnego, warunekOkresu } from '../../lib/narzedzia/swiadczenie-przedemerytalne';
import { zl } from '../../lib/narzedzia/format';
import { dataPoPolsku, dzisWPolsce } from '../../lib/narzedzia/terminy';

const dzis = dzisWPolsce();
const URODZENIE = '1965-06-15';
const start = opisPrzedemerytalnego({ plec: 'm', urodzenie: URODZENIE, przyczyna: 'likwidacja', data: dzis, staz: 25, okres: true }, dzis);
const kw = KWOTY_PRZYCHODU[KWOTY_PRZYCHODU.length - 1];

const faq = [
  {
    pytanie: 'Komu przysługuje świadczenie przedemerytalne?',
    odpowiedz: 'Osobie, która straciła pracę przed emeryturą i spełnia jeden z warunków art. 2 ust. 1 ustawy o świadczeniach przedemerytalnych. Najczęściej na hali: likwidacja albo niewypłacalność pracodawcy po co najmniej 6 miesiącach pracy u niego, ukończone 56 lat (kobieta) albo 61 lat (mężczyzna) i 20 albo 25 lat okresów składkowych i nieskładkowych (pkt 1), albo zwolnienie z przyczyn dotyczących zakładu pracy, 55 albo 60 lat i 30 albo 35 lat stażu (pkt 2). Bez względu na wiek wystarczy 35 albo 40 lat stażu (pkt 5).',
  },
  {
    pytanie: 'Od kiedy wypłacane jest świadczenie przedemerytalne?',
    odpowiedz: 'Po co najmniej 180 dniach pobierania zasiłku dla bezrobotnych, jeśli nadal masz status bezrobotnego i złożysz wniosek najpóźniej 30 dni od dnia, w którym urząd pracy wyda dokument o 180 dniach zasiłku (art. 2 ust. 3). ZUS przyznaje je od dnia po złożeniu wniosku z dokumentami (art. 7 ust. 1).',
  },
  {
    pytanie: 'Co to są przyczyny dotyczące zakładu pracy?',
    odpowiedz: 'Według ustawy o rynku pracy (art. 2 ust. 1 pkt 38) to m.in. rozwiązanie umowy z przyczyn niedotyczących pracowników (także w firmie poniżej 20 osób), z powodu upadłości lub likwidacji pracodawcy albo likwidacji stanowiska z przyczyn ekonomicznych, organizacyjnych, produkcyjnych lub technologicznych, wygaśnięcie umowy po śmierci pracodawcy oraz rozwiązanie umowy przez pracownika bez wypowiedzenia z winy pracodawcy albo z powodu orzeczenia lekarskiego (art. 55 § 1 i 1¹ Kodeksu pracy).',
  },
  {
    pytanie: 'Ile można dorobić na świadczeniu przedemerytalnym?',
    odpowiedz: `Od ${dataPoPolsku(kw.od)} bez zmniejszenia do ${zl(kw.dopuszczalna)} miesięcznie (25% przeciętnego wynagrodzenia). Powyżej tej kwoty świadczenie maleje o nadwyżkę, a przy przychodzie powyżej ${zl(kw.graniczna)} (70%) jest zawieszone (art. 5 ustawy, ${kw.publikator}). O przychodzie trzeba niezwłocznie powiadomić ZUS (art. 6 ust. 2).`,
  },
  {
    pytanie: 'Do kiedy wypłacane jest świadczenie przedemerytalne?',
    odpowiedz: 'Do dnia przed nabyciem prawa do emerytury albo do dnia 60. urodzin kobiety i 65. urodzin mężczyzny. Ustaje też na Twój wniosek, po nabyciu gospodarstwa rolnego powyżej 2 ha przeliczeniowych i jest zawieszane po przyznaniu renty z tytułu niezdolności do pracy (art. 4).',
  },
];
---
<StronaNarzedzia
  slug="swiadczenie-przedemerytalne"
  tytul="Świadczenie przedemerytalne: warunki"
  opis={`Czy po zwolnieniu albo likwidacji firmy przysługuje Ci świadczenie przedemerytalne: wiek, staż, 180 dni zasiłku, dorabianie do ${zl(kw.dopuszczalna)}.`}
  h1="Świadczenie przedemerytalne: czy przysługuje"
  lead="Wybierz, jak skończyła się praca, wpisz datę i staż, a sprawdzimy warunki świadczenia przedemerytalnego i do kiedy byłoby wypłacane."
  faq={faq}
>
  <form class="kalkulator" data-przedemerytalne novalidate aria-labelledby="kalkulator-tytul">
    <div class="kalkulator-pola">
      <h2 id="kalkulator-tytul" class="tytul-m">Koniec pracy i staż</h2>
      <div class="mt-4">
        <label for="s-przyczyna" class="etykieta-pola">Jak skończyła się praca</label>
        <select id="s-przyczyna" name="przyczyna" class="pole mt-1">
          <option value="likwidacja" selected>Likwidacja, niewypłacalność</option>
          <option value="zaklad">Zwolnienie z przyczyn firmy</option>
          <option value="firma">Upadłość własnej firmy</option>
          <option value="renta">Koniec renty</option>
          <option value="opiekun">Koniec świadczenia opiekuna</option>
        </select>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="s-plec" class="etykieta-pola">Płeć</label>
          <select id="s-plec" name="plec" class="pole mt-1">
            <option value="m" selected>Mężczyzna</option>
            <option value="k">Kobieta</option>
          </select>
        </div>
        <div>
          <label for="s-urodzenie" class="etykieta-pola">Data urodzenia</label>
          <input id="s-urodzenie" name="urodzenie" type="date" class="pole mt-1" min="1940-01-01" max="2010-12-31" value={URODZENIE} aria-describedby="s-blad" />
        </div>
        <div>
          <label for="s-data" class="etykieta-pola" data-etykieta-daty>Dzień rozwiązania umowy</label>
          <input id="s-data" name="data" type="date" class="pole mt-1" min="2000-01-01" max="2100-12-31" value={dzis} data-dzis aria-describedby="s-blad" />
        </div>
        <div>
          <label for="s-staz" class="etykieta-pola">Staż do emerytury (lata)</label>
          <input id="s-staz" name="staz" class="pole mt-1" type="text" inputmode="decimal" autocomplete="off" value="25" aria-describedby="s-blad s-staz-opis" />
        </div>
      </div>
      <p id="s-staz-opis" class="meta mt-1">Okresy składkowe i nieskładkowe do tego dnia, jak do emerytury z ZUS. Lata możesz wpisać z ułamkiem, na przykład 34,5.</p>
      <div class="mt-4">
        <label for="s-okres" class="etykieta-pola">Wymagany czas pracy lub świadczenia</label>
        <select id="s-okres" name="okres" class="pole mt-1 max-w-56" aria-describedby="s-okres-opis">
          <option value="tak" selected>Spełniony</option>
          <option value="nie">Niespełniony</option>
        </select>
        <p id="s-okres-opis" class="meta mt-1" data-opis-okresu>{warunekOkresu('likwidacja')}</p>
      </div>
      <p id="s-blad" class="blad-pola mt-3" data-blad="dane" hidden></p>
    </div>

    <div class="kalkulator-wynik" aria-labelledby="wynik-tytul">
      <h2 id="wynik-tytul" class="etykieta">Świadczenie przedemerytalne</h2>
      <div aria-live="polite" aria-atomic="true">
        <p class="wynik-data" data-w="stan">{start.stan}</p>
        <p class="meta" data-w="opis">{start.opis}</p>
      </div>
      <dl class="wynik-lista">
        <div><dt>Podstawa</dt><dd data-w="podstawa">{start.podstawa}</dd></div>
        <div><dt>Najdłużej do</dt><dd data-w="koniec">{start.koniec}</dd></div>
        <div><dt>Przychód</dt><dd data-w="przychod">{start.przychod}</dd></div>
      </dl>
      <p class="wynik-uwaga" data-w="uwaga">{start.uwagi.join(' ')}</p>
      <noscript><p class="wynik-uwaga">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Warunki są opisane poniżej.</p></noscript>
    </div>
  </form>

  <Fragment slot="wyjasnienie">
    <h2 id="warunki">Warunki świadczenia przedemerytalnego</h2>
    <p>Prawo do świadczenia ma osoba, która spełnia jeden z warunków z art. 2 ust. 1 ustawy o świadczeniach przedemerytalnych (staż to okres uprawniający do emerytury, liczony jak w ustawie o FUS, art. 2 ust. 2):</p>
    <ul>
      <li>pkt 1: rozwiązanie stosunku pracy z powodu likwidacji albo niewypłacalności pracodawcy, u którego praca trwała co najmniej 6 miesięcy, a do dnia rozwiązania ukończone 56 lat (kobiety) albo 61 lat (mężczyźni) i staż 20 albo 25 lat;</li>
      <li>pkt 2: rozwiązanie stosunku pracy z przyczyn dotyczących zakładu pracy po co najmniej 6 miesiącach pracy, ukończone 55 albo 60 lat i staż 30 albo 35 lat;</li>
      <li>pkt 3: upadłość własnej działalności prowadzonej bez przerwy co najmniej 24 miesiące ze składkami, ukończone 56 albo 61 lat i staż 20 albo 25 lat;</li>
      <li>pkt 4: rejestracja w urzędzie pracy do 30 dni po końcu renty z tytułu niezdolności do pracy pobieranej bez przerwy co najmniej 5 lat, ukończone do tego dnia 55 albo 60 lat i staż 20 albo 25 lat;</li>
      <li>pkt 4a: rejestracja do 60 dni po końcu świadczenia pielęgnacyjnego, specjalnego zasiłku opiekuńczego albo zasiłku dla opiekuna pobieranych co najmniej 365 dni, 55 albo 60 lat i staż 20 albo 25 lat;</li>
      <li>pkt 5: rozwiązanie stosunku pracy z przyczyn dotyczących zakładu pracy po co najmniej 6 miesiącach pracy i staż 35 albo 40 lat, bez warunku wieku;</li>
      <li>pkt 6: likwidacja albo niewypłacalność pracodawcy po co najmniej 6 miesiącach pracy i staż 34 albo 39 lat do 31 grudnia roku przed rozwiązaniem umowy, bez warunku wieku.</li>
    </ul>
    <p>
      Potem trzeba co najmniej 180 dni pobierać zasiłek dla bezrobotnych, wciąż mieć status bezrobotnego i złożyć wniosek
      w ZUS najpóźniej 30 dni od dokumentu urzędu pracy o 180 dniach (art. 2 ust. 3). Do 180 dni wlicza się okresy, za które
      zasiłek nie przysługiwał (art. 220 ust. 2 ustawy o rynku pracy), oraz pracę podjętą w tym czasie (art. 2 ust. 5).
      W szczególnie uzasadnionych przypadkach ZUS może przywrócić termin wniosku (art. 2 ust. 4).
    </p>
    <p>
      Ustawa podaje kwotę świadczenia 1600,70 zł miesięcznie; rośnie ona przy każdej waloryzacji emerytur (art. 3), a aktualną
      kwotę podaje ZUS. Przy przychodzie powyżej {zl(kw.dopuszczalna)} świadczenie maleje o nadwyżkę, ale nie poniżej kwoty
      z art. 5 ust. 4 (w ustawie 800,35 zł, też waloryzowanej), a powyżej {zl(kw.graniczna)} jest zawieszone (art. 5; kwoty
      od {dataPoPolsku(kw.od)}, {kw.publikator}).
    </p>

    <h2 id="jak-liczymy">Jak liczymy</h2>
    <p>
      Porównujemy wiek w dniu rozwiązania umowy (albo ogłoszenia upadłości, końca renty lub świadczenia) i wpisany staż
      z progami z art. 2 ust. 1; wiek osiąga się w dniu urodzin (osoby urodzone 29 lutego w roku nieprzestępnym 28 lutego).
      Likwidacja i niewypłacalność pracodawcy to też przyczyny dotyczące zakładu pracy, więc przy nich sprawdzamy także
      pkt 2 i 5. Stażu na 31 grudnia (pkt 6) nie znamy, więc szacujemy go od dołu: wpisany staż minus zaczęte miesiące
      bieżącego roku; gdy to za mało, a cały staż wystarcza, piszemy „zależy”. Czy masz prawo do zasiłku dla bezrobotnych
      i czy urząd pracy wyda dokument o 180 dniach, nie sprawdzamy: zasiłek policzy <a href="/narzedzia/zasilek-dla-bezrobotnych">kalkulator zasiłku dla bezrobotnych</a>. Czy wolno Cię zwolnić tuż przed emeryturą, sprawdzi <a href="/narzedzia/ochrona-przedemerytalna">kalkulator ochrony przedemerytalnej</a>, a odprawę <a href="/narzedzia/kalkulator-odprawy">kalkulator odprawy</a>.
    </p>
  </Fragment>
</StronaNarzedzia>

<script>
  import { opisPrzedemerytalnego, warunekOkresu, type Plec, type Przyczyna } from '../../lib/narzedzia/swiadczenie-przedemerytalne';
  import { ustawDzisiejszeWartosci } from '../../lib/narzedzia/dzis-w-formularzu';
  import { wpisanaLiczba } from '../../lib/narzedzia/format';
  import { dzisWPolsce, poprawnaData } from '../../lib/narzedzia/terminy';
  import { typografia } from '../../lib/typografia.mjs';

  const ETYKIETY_DATY: Record<Przyczyna, string> = {
    likwidacja: 'Dzień rozwiązania umowy',
    zaklad: 'Dzień rozwiązania umowy',
    firma: 'Dzień ogłoszenia upadłości',
    renta: 'Dzień końca renty',
    opiekun: 'Dzień końca świadczenia',
  };

  const form = document.querySelector<HTMLFormElement>('[data-przedemerytalne]');
  if (form) {
    ustawDzisiejszeWartosci(form);
    const w = (k: string) => form.querySelector<HTMLElement>(`[data-w="${k}"]`)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const POLA = ['stan', 'opis', 'podstawa', 'koniec', 'przychod'] as const;
    const przelicz = () => {
      const przyczyna = el('przyczyna').value as Przyczyna;
      form.querySelector<HTMLElement>('[data-etykieta-daty]')!.textContent = ETYKIETY_DATY[przyczyna];
      form.querySelector<HTMLElement>('[data-opis-okresu]')!.textContent = typografia(warunekOkresu(przyczyna));
      const urodzenie = el('urodzenie').value;
      const data = el('data').value;
      const staz = wpisanaLiczba(el('staz').value);
      let blad: string | null = null;
      if (!poprawnaData(urodzenie) || urodzenie > dzisWPolsce() || urodzenie < '1900-01-01') blad = 'Wpisz datę urodzenia.';
      else if (!poprawnaData(data) || data < urodzenie) blad = 'Wpisz dzień końca pracy albo świadczenia, po dacie urodzenia.';
      else if (!(staz >= 0 && staz <= 70)) blad = 'Wpisz staż w latach, na przykład 25 albo 34,5.';
      const b = form.querySelector<HTMLElement>('[data-blad="dane"]')!;
      b.hidden = !blad;
      b.textContent = blad ? typografia(blad) : '';
      if (blad) {
        for (const k of POLA) w(k).textContent = k === 'opis' ? '' : '—';
        w('uwaga').textContent = '';
        return;
      }
      const o = opisPrzedemerytalnego({ plec: el('plec').value as Plec, urodzenie, przyczyna, data, staz, okres: el('okres').value === 'tak' }, dzisWPolsce());
      for (const k of POLA) w(k).textContent = typografia(o[k]);
      w('uwaga').textContent = typografia(o.uwagi.join(' '));
    };
    form.addEventListener('input', przelicz);
    form.addEventListener('change', przelicz);
    form.addEventListener('submit', (e) => e.preventDefault());
    przelicz();
  }
</script>
